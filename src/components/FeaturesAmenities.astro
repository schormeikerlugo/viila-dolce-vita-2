---
/**
 * FeaturesAmenities — amenities as a light panel floating on a dark band.
 *
 * A full-width cypress band holds a centered, near-ivory panel. Inside, a
 * small "Amenities & Services" label sits above a grid of amenity cards — each
 * a hairline-bordered tile with a thin "+" mark and a label. The grouped data
 * is flattened to a single ordered list.
 */
import Reveal from "./Reveal.astro";

interface AmenityGroup {
  title: string;
  items: string[];
}
interface Props {
  label?: string;
  groups: AmenityGroup[];
}

const { label = "Amenities & Services", groups } = Astro.props;

// Flatten every group's items into one ordered list of amenities.
const amenities = groups.flatMap((g) => g.items);
---

<section class="fa" aria-label={label}>
  <div class="wrap">
    <div class="fa__panel" data-reveal>
      <p class="fa__label">{label}</p>
      <ul class="fa__grid">
        {
          amenities.map((item, i) => (
            <Reveal as="li" class="fa__card" delay={(i % 4) * 0.04}>
              <span class="fa__plus" aria-hidden="true" />
              <span class="fa__text">{item}</span>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Full-width dark band. */
  .fa {
    background: var(--bg-charcoal);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  /* Light panel floating on the band. */
  .fa__panel {
    background: var(--c-parchment);
    border-radius: var(--radius);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
    padding: clamp(1.6rem, 3vw, 2.6rem);
  }
  .fa__label {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 clamp(1.2rem, 2.5vw, 1.8rem);
  }

  .fa__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.7rem, 1.4vw, 1rem);
  }
  /* Rendered via <Reveal as="li"> → target with :global(). */
  .fa__grid :global(.fa__card) {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem clamp(1rem, 1.6vw, 1.3rem);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .fa__grid :global(.fa__card):hover {
    border-color: var(--line-strong);
    background: rgba(38, 36, 31, 0.03);
  }
  /* Thin dark "+" built from two hairline bars. */
  .fa__plus {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .fa__plus::before,
  .fa__plus::after {
    content: "";
    position: absolute;
    background: var(--c-charcoal);
  }
  .fa__plus::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }
  .fa__plus::after {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }
  .fa__text {
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--c-charcoal);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1000px) {
    .fa__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 720px) {
    .fa__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .fa__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
