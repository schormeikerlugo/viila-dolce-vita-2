---
/**
 * RealMap — a real, interactive dark-themed map of the estate's location.
 *
 * Uses Leaflet (via CDN) with CartoDB "Dark Matter" tiles — no API key, no
 * Google cookies. A single terracotta marker sits on the villa, with a popup
 * linking to Google Maps for turn-by-turn directions.
 *
 * Coordinates are the geocoded location for the estate near Massa Marittima
 * (SP441, 56, 58024 Massa Marittima GR). Adjust `lat`/`lng` for a precise pin.
 */
import { contact, site } from "../data/site";

interface Props {
  class?: string;
  /** Villa latitude — geocoded near Massa Marittima. */
  lat?: number;
  /** Villa longitude — geocoded near Massa Marittima. */
  lng?: number;
  /** Initial zoom (13 ≈ town + surrounding hills). */
  zoom?: number;
}

const {
  class: className = "",
  lat = 43.0500376,
  lng = 10.8879707,
  zoom = 13,
} = Astro.props;

const directionsHref =
  "https://maps.google.com/?q=SP441+56+58024+Massa+Marittima+GR+Italy";
---

<figure class:list={["realmap", className]}>
  <div
    class="realmap__canvas"
    id="realmap-canvas"
    data-lat={lat}
    data-lng={lng}
    data-zoom={zoom}
    data-name={site.name}
    data-address={contact.address}
    data-directions={directionsHref}
    role="application"
    aria-label={`Map showing ${site.name} near Massa Marittima, Tuscany`}
  >
  </div>
  <figcaption class="realmap__caption">
    Villa Dolce Vita · SP441, 56 — fifteen minutes from Massa Marittima.
  </figcaption>
</figure>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script>
  // Load Leaflet from CDN once, then draw the dark map. Runs on first load and
  // after every Astro View Transition navigation.
  const LEAFLET_JS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";

  function loadLeaflet(): Promise<typeof import("leaflet")> {
    // @ts-expect-error — Leaflet attaches to window.L when loaded via CDN.
    if (window.L) return Promise.resolve(window.L);
    return new Promise((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>(
        `script[src="${LEAFLET_JS}"]`,
      );
      if (existing) {
        existing.addEventListener("load", () =>
          // @ts-expect-error — window.L is present after load.
          resolve(window.L),
        );
        existing.addEventListener("error", reject);
        return;
      }
      const s = document.createElement("script");
      s.src = LEAFLET_JS;
      s.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
      s.crossOrigin = "";
      // @ts-expect-error — window.L is present after load.
      s.addEventListener("load", () => resolve(window.L));
      s.addEventListener("error", reject);
      document.head.appendChild(s);
    });
  }

  function initRealMap() {
    const el = document.getElementById("realmap-canvas");
    if (!el) return;
    // Avoid re-initialising the same node after a soft navigation.
    if (el.dataset.ready === "1") return;

    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);
    const zoom = Number(el.dataset.zoom) || 13;
    const name = el.dataset.name ?? "";
    const address = el.dataset.address ?? "";
    const directions = el.dataset.directions ?? "#";

    loadLeaflet()
      .then((L) => {
        el.dataset.ready = "1";

        const map = L.map(el, {
          center: [lat, lng],
          zoom,
          scrollWheelZoom: false,
          attributionControl: true,
        });

        // CartoDB Dark Matter — real streets, dark theme, no API key.
        L.tileLayer(
          "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
          {
            maxZoom: 19,
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
          },
        ).addTo(map);

        // Terracotta pin — a simple divIcon in the estate accent colour.
        const icon = L.divIcon({
          className: "realmap-pin",
          html: '<span class="realmap-pin__dot"></span>',
          iconSize: [22, 22],
          iconAnchor: [11, 11],
        });

        const popupHtml =
          '<strong class="realmap-pop__name">' +
          name +
          '</strong><span class="realmap-pop__addr">' +
          address +
          '</span><a class="realmap-pop__link" href="' +
          directions +
          '" target="_blank" rel="noopener">Open in Google Maps &rarr;</a>';

        L.marker([lat, lng], { icon })
          .addTo(map)
          .bindPopup(popupHtml, { className: "realmap-pop" });

        // Recompute size once the section settles (grid/animations).
        setTimeout(() => map.invalidateSize(), 250);
      })
      .catch(() => {
        // If the CDN is blocked, leave a graceful fallback message.
        el.classList.add("realmap__canvas--failed");
        el.innerHTML =
          '<a href="' +
          directions +
          '" target="_blank" rel="noopener">Open the estate in Google Maps &rarr;</a>';
      });
  }

  document.addEventListener("astro:page-load", initRealMap);
</script>

<style>
  .realmap {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .realmap__canvas {
    width: 100%;
    height: clamp(320px, 42vw, 520px);
    background: #0b0b0d;
  }
  .realmap__canvas--failed {
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }
  .realmap__canvas--failed a {
    color: var(--accent);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .realmap__caption {
    padding: 0.9rem 1rem;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    border-top: 1px solid var(--line);
  }

  /* Terracotta marker — a soft-pulsing dot. */
  .realmap :global(.realmap-pin__dot) {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--c-ivory);
    box-shadow: 0 0 0 4px rgba(192, 138, 88, 0.28);
  }

  /* Dark, editorial popup to match the site. */
  .realmap :global(.leaflet-popup-content-wrapper),
  .realmap :global(.leaflet-popup-tip) {
    background: #141210;
    color: var(--c-ivory);
    border: 1px solid var(--line);
    border-radius: 2px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }
  .realmap :global(.leaflet-popup-content) {
    margin: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .realmap :global(.realmap-pop__name) {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .realmap :global(.realmap-pop__addr) {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .realmap :global(.realmap-pop__link) {
    margin-top: 0.2rem;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .realmap :global(.leaflet-popup-close-button) {
    color: var(--text-muted);
  }

  /* Tone the default controls into the dark theme. */
  .realmap :global(.leaflet-bar a) {
    background: #141210;
    color: var(--c-ivory);
    border-bottom-color: var(--line);
  }
  .realmap :global(.leaflet-bar a:hover) {
    background: #1e1b18;
  }
  .realmap :global(.leaflet-control-attribution) {
    background: rgba(10, 10, 12, 0.7);
    color: var(--text-muted);
  }
  .realmap :global(.leaflet-control-attribution a) {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .realmap :global(.realmap-pin__dot) {
      animation: realmap-pulse 2.4s ease-in-out infinite;
    }
    @keyframes realmap-pulse {
      0%,
      100% {
        box-shadow: 0 0 0 4px rgba(192, 138, 88, 0.28);
      }
      50% {
        box-shadow: 0 0 0 8px rgba(192, 138, 88, 0.12);
      }
    }
  }
</style>
