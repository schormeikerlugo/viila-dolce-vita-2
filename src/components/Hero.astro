---
/**
 * Hero — full-viewport cinematic opener (Masseto).
 * Background video under a quiet ink scrim; the villa name set centered in
 * uppercase Bodoni with a small-caps tagline beneath. A hairline meta bar
 * sits along the bottom edge: location · scroll cue · availability CTA.
 */
import BackgroundVideo from "./BackgroundVideo.astro";
import type { videos } from "../data/media";
import { bookingHref } from "../data/site";

interface Props {
  eyebrow?: string;
  video: keyof typeof videos;
  /** Show the availability CTA in the bottom meta bar. */
  booking?: boolean;
  /** Hide the bottom meta bar entirely (when the hero already has its own CTA). */
  hideBar?: boolean;
}
const { eyebrow, video, booking = false, hideBar = false } = Astro.props;
---

<section class="hero">
  <BackgroundVideo video={video} />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content wrap">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">
      <slot name="title" />
    </h1>
    {Astro.slots.has("subtitle") && <p class="hero__sub"><slot name="subtitle" /></p>}
    {
      Astro.slots.has("actions") && (
        <div class="hero__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>

  {
    hideBar ? null : Astro.slots.has("bar") ? (
      <div class="hero__bookbar wrap">
        <slot name="bar" />
      </div>
    ) : (
      <div class="hero__bar wrap">
        <p class="hero__meta">{eyebrow ?? "Tuscany, Italy"}</p>
        <p class="hero__scrollcue" aria-hidden="true">
          Scroll
        </p>
        {booking ? (
          <a class="hero__book" href={bookingHref}>
            Check Availability <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="hero__meta hero__meta--right">Est. Maremma</span>
        )}
      </div>
    )
  }
</section>
<span id="after-hero"></span>

<script>
  // Trigger the nav's entrance choreography on pages that have a Hero (home).
  // Re-arms on every View-Transition navigation into a hero page.
  function armNavIntro() {
    const nav = document.getElementById("site-nav");
    const hero = document.querySelector(".hero");
    if (!nav || !hero) return;
    nav.classList.remove("nav--intro");
    void (nav as HTMLElement).offsetWidth;
    nav.classList.add("nav--intro");
  }
  document.addEventListener("astro:page-load", armNavIntro);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    color: var(--c-ivory);
    overflow: hidden;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(22, 20, 18, 0.42) 0%,
      rgba(22, 20, 18, 0.18) 40%,
      rgba(22, 20, 18, 0.52) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Sit toward the lower edge of the banner. Extra bottom room clears the
       meta bar on pages that show it. */
    padding-bottom: clamp(3.5rem, 8vh, 7rem);
  }
  .hero__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.85);
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 6.5vw, 7rem);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
  }
  .hero__title :global(em) {
    font-style: italic;
    font-weight: 450;
  }
  .hero__sub {
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    max-width: 52ch;
    font-size: 0.74rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.8);
    font-weight: 500;
  }
  .hero__actions {
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  /* White booking CTA under the subtitle. */
  .hero__actions :global(.hero__cta) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 2rem;
    background: var(--c-ivory);
    color: var(--c-ink);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .hero__actions :global(.hero__cta:hover) {
    opacity: 0.85;
  }

  /* Bottom meta bar — hairline top rule, three quiet labels. */
  .hero__bar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.2rem;
    border-top: 1px solid rgba(244, 241, 234, 0.22);
  }
  .hero__meta {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.75);
  }
  .hero__meta--right {
    text-align: right;
  }
  .hero__scrollcue {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.55);
    animation: hero-cue 2.4s var(--ease-inout) infinite;
  }
  @keyframes hero-cue {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }
  .hero__book {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-ivory);
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(244, 241, 234, 0.5);
    transition: border-color var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  }
  .hero__book:hover {
    border-color: var(--c-ivory);
    opacity: 0.85;
  }

  /* Booking composer pinned to the hero's lower edge. */
  .hero__bookbar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 4vw, 3rem);
  }
  /* Frosted glass so the ink fields stay legible over the video. */
  .hero__bookbar :global(.bookbar) {
    background: rgba(22, 20, 18, 0.28);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
  }

  /* ── Entrance choreography ──────────────────────────────────────────── */
  .hero__title {
    opacity: 0;
    transform: translateY(40px);
    animation: hero-rise 1.1s var(--ease-out) 0.2s forwards;
    will-change: transform, opacity;
  }
  .hero__eyebrow,
  .hero__sub,
  .hero__actions {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-rise 0.9s var(--ease-out) forwards;
  }
  .hero__eyebrow {
    animation-delay: 1s;
  }
  .hero__sub {
    animation-delay: 1.15s;
  }
  .hero__actions {
    animation-delay: 1.3s;
  }
  .hero__bar,
  .hero__bookbar {
    opacity: 0;
    animation: hero-fade 0.9s var(--ease-out) 1.5s forwards;
  }
  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title,
    .hero__eyebrow,
    .hero__sub,
    .hero__actions,
    .hero__bar,
    .hero__bookbar {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero__scrollcue {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .hero__bar {
      grid-template-columns: 1fr auto;
    }
    .hero__scrollcue {
      display: none;
    }
  }
</style>
