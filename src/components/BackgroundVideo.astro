---
/**
 * BackgroundVideo — full-bleed autoplaying, muted, looping background video
 * with a poster fallback. Sources come from data/media (webm + mp4).
 */
import { videoSources, type videos } from "../data/media";

interface Props {
  video: keyof typeof videos;
  class?: string;
  overlay?: boolean;
}
const { video, class: className = "", overlay = true } = Astro.props;
const { webm, mp4, poster, webm720, mp4720 } = videoSources(video);
---

<div class={`bgvideo ${className}`}>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
    class="bgvideo__el"
  >
    {/* Lighter 720p sources first, gated to small viewports. Browsers that
        ignore the media attribute simply pick the lighter file — a safe
        degradation. Desktop Chrome/Safari fall through to the full sources. */}
    {webm720 && <source src={webm720} type="video/webm" media="(max-width: 768px)" />}
    {mp4720 && <source src={mp4720} type="video/mp4" media="(max-width: 768px)" />}
    <source src={webm} type="video/webm" />
    <source src={mp4} type="video/mp4" />
  </video>
  {overlay && <div class="bgvideo__overlay" aria-hidden="true"></div>}
</div>

<style>
  .bgvideo {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .bgvideo__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bgvideo__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(22, 20, 18, 0.5) 0%,
        rgba(22, 20, 18, 0.18) 35%,
        rgba(22, 20, 18, 0.48) 100%
      );
  }
</style>
