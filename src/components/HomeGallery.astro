---
/**
 * HomeGallery — a condensed masonry teaser for the home page.
 *
 * Mirrors the structure of the full /gallery page: a CSS-columns masonry of
 * rounded tiles with per-image aspect ratios, hover zoom and a caption-on-hover.
 * Trimmed to a compact set (~25 tiles, roughly a 5×5 block on desktop) and
 * capped off with a button that links out to the full /gallery archive.
 *
 * Clicking a tile opens the same lightbox as /gallery (full image, prev/next,
 * keyboard nav, counter).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "./SectionHeader.astro";
import Button from "./Button.astro";

export interface HomeGalleryItem {
  image: ImageMetadata;
  alt: string;
  /** Short overlay caption shown on hover. */
  caption?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  items: HomeGalleryItem[];
  href?: string;
  cta?: string;
  /** Max tiles to show (defaults to 25 — a 5×5 block on desktop). */
  limit?: number;
}

const {
  eyebrow = "Gallery",
  title,
  items,
  href = "/gallery",
  cta = "View full gallery",
  limit = 25,
} = Astro.props;

const tiles = items.slice(0, limit).map((item) => ({
  ...item,
  ratio: `${item.image.width}/${item.image.height}`,
}));
---

<section class="section bg-ivory hgal">
  <div class="wrap">
    <SectionHeader eyebrow={eyebrow} title={title} align="center" />
  </div>

  {/* Full-bleed masonry, same look as the /gallery page. */}
  <div class="hgal__grid">
    {
      tiles.map((item, i) => (
        <figure
          class="hgal__tile"
          data-reveal
          data-reveal-delay={Math.min(0.05 + (i % 5) * 0.04, 0.3)}
          data-cap={item.caption ?? item.alt}
          style={`--ratio:${item.ratio}`}
        >
          <button
            type="button"
            class="hgal__link"
            aria-label={`View ${item.alt}`}
            aria-haspopup="dialog"
            data-lb-open
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[320, 480, 800, 1200, 1600]}
              sizes="(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 20vw"
              loading="lazy"
            />
            {item.caption && (
              <figcaption class="hgal__caption">{item.caption}</figcaption>
            )}
          </button>
        </figure>
      ))
    }
  </div>

  <div class="wrap">
    <div class="hgal__foot" data-reveal data-reveal-delay={0.1}>
      <Button href={href} variant="ghost">{cta}</Button>
    </div>
  </div>

  {/* ─── Lightbox modal (same as /gallery) ─── */}
  <div
    class="hgal-lb"
    id="home-gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photograph viewer"
    hidden
  >
    <div class="hgal-lb__backdrop" data-lb-close></div>

    <button type="button" class="hgal-lb__btn hgal-lb__close" data-lb-close aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <button type="button" class="hgal-lb__btn hgal-lb__nav hgal-lb__prev" data-lb-prev aria-label="Previous photograph">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <figure class="hgal-lb__figure">
      <img class="hgal-lb__img" src="" alt="" />
      <figcaption class="hgal-lb__bar">
        <span class="hgal-lb__title" data-lb-title></span>
        <span class="hgal-lb__count" data-lb-count aria-live="polite"></span>
      </figcaption>
    </figure>

    <button type="button" class="hgal-lb__btn hgal-lb__nav hgal-lb__next" data-lb-next aria-label="Next photograph">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</section>

<style>
  /* Full-bleed CSS-columns masonry — mirrors the /gallery page grid. */
  .hgal__grid {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: var(--space-group);
    padding: 0 var(--gutter);
    column-count: 5;
    column-gap: 1rem;
  }
  @media (max-width: 1400px) {
    .hgal__grid {
      column-count: 4;
    }
  }
  @media (max-width: 1100px) {
    .hgal__grid {
      column-count: 3;
    }
  }
  @media (max-width: 760px) {
    .hgal__grid {
      column-count: 2;
      column-gap: 0.6rem;
    }
    .hgal__tile {
      margin-bottom: 0.9rem;
    }
  }

  /* Shared tile look — lifted from the /gallery page tiles. */
  .hgal__tile {
    position: relative;
    display: block;
    width: 100%;
    /* Vertical rhythm: a touch more than the horizontal column-gap so tall,
       edge-to-edge photos read with the same visual breathing room as the
       columns (equal pixel gaps look tighter vertically). */
    margin: 0 0 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    transition:
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .hgal__tile:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-3px);
  }
  .hgal__link {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    aspect-ratio: var(--ratio, 4 / 3);
    overflow: hidden;
  }
  .hgal__link :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .hgal__tile:hover .hgal__link :global(img),
  .hgal__tile:focus-within .hgal__link :global(img) {
    transform: scale(1.04);
  }

  .hgal__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.2rem 1rem 0.85rem;
    font-size: 0.8rem;
    line-height: 1.4;
    text-align: left;
    color: var(--c-ivory);
    background: linear-gradient(
      to top,
      rgba(18, 26, 22, 0.72),
      rgba(18, 26, 22, 0)
    );
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
    pointer-events: none;
  }
  .hgal__tile:hover .hgal__caption,
  .hgal__tile:focus-within .hgal__caption {
    opacity: 1;
    transform: translateY(0);
  }

  .hgal__foot {
    margin-top: 2.6rem;
    text-align: center;
  }

  /* ─── Lightbox modal ─── */
  .hgal-lb {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .hgal-lb[hidden] {
    display: none;
  }
  .hgal-lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(24, 26, 22, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: hgal-lb-fade var(--dur-fast) var(--ease-out) both;
  }
  .hgal-lb__figure {
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: 100%;
    max-height: 100%;
    animation: hgal-lb-pop var(--dur-fast) var(--ease-out) both;
  }
  .hgal-lb__img {
    display: block;
    max-width: min(90vw, 1400px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
    background: var(--surface);
  }
  .hgal-lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(90vw, 1400px);
    max-width: 100%;
    flex-wrap: wrap;
  }
  .hgal-lb__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--c-ivory);
    min-width: 0;
  }
  .hgal-lb__count {
    font-size: 0.72rem;
    color: rgba(243, 238, 230, 0.7);
    letter-spacing: 0.08em;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .hgal-lb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 238, 230, 0.2);
    background: rgba(38, 36, 31, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--c-ivory);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .hgal-lb__btn:hover {
    background: rgba(201, 151, 77, 0.5);
    border-color: var(--accent);
  }
  .hgal-lb__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hgal-lb__close {
    position: absolute;
    z-index: 2;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .hgal-lb__nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
  }
  .hgal-lb__nav:hover {
    transform: translateY(-50%) scale(1.06);
  }
  .hgal-lb__prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .hgal-lb__next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  @keyframes hgal-lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hgal-lb-pop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  :global(body.hgal-lb-open) {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .hgal-lb__img {
      max-height: 70vh;
    }
    .hgal-lb__nav {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hgal__tile,
    .hgal__link :global(img),
    .hgal__caption,
    .hgal-lb__backdrop,
    .hgal-lb__figure {
      transition: none;
      animation: none;
    }
    .hgal__tile:hover {
      transform: none;
    }
    .hgal-lb__nav:hover {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  function initHomeGallery() {
    const section = document.querySelector<HTMLElement>(".hgal");
    if (!section || section.dataset.hgalReady === "1") return;
    section.dataset.hgalReady = "1";

    const tiles = Array.from(section.querySelectorAll<HTMLElement>(".hgal__tile"));
    const lb = document.getElementById("home-gallery-lightbox");
    if (!lb || tiles.length === 0) return;

    // Portal the modal to <body> so no transformed / `will-change` ancestor
    // (e.g. reveal wrappers) traps its `position: fixed`.
    if (lb.parentElement !== document.body) document.body.appendChild(lb);

    const lbImg = lb.querySelector<HTMLImageElement>(".hgal-lb__img");
    const lbTitle = lb.querySelector<HTMLElement>("[data-lb-title]");
    const lbCount = lb.querySelector<HTMLElement>("[data-lb-count]");
    const closeEls = Array.from(lb.querySelectorAll<HTMLElement>("[data-lb-close]"));
    const prevBtn = lb.querySelector<HTMLButtonElement>("[data-lb-prev]");
    const nextBtn = lb.querySelector<HTMLButtonElement>("[data-lb-next]");

    let idx = -1;
    let lastFocus: HTMLElement | null = null;

    /** Largest candidate from the tile's srcset (full-res image). */
    function largestSrc(img: HTMLImageElement): string {
      const candidates = (img.srcset || "")
        .split(",")
        .map((s) => s.trim().split(/\s+/))
        .filter((p) => p[0]);
      if (!candidates.length) return img.currentSrc || img.src;
      candidates.sort((a, b) => parseInt(b[1] || "0") - parseInt(a[1] || "0"));
      return candidates[0][0];
    }

    function render() {
      const el = tiles[idx];
      if (!el || !lbImg) return;
      const img = el.querySelector<HTMLImageElement>("img");
      const title = el.dataset.cap ?? img?.alt ?? "";
      lbImg.src = img ? largestSrc(img) : "";
      lbImg.alt = title;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCount) lbCount.textContent = `${idx + 1} / ${tiles.length}`;
    }

    function open(i: number) {
      idx = i;
      if (idx < 0) return;
      lastFocus = tiles[idx].querySelector<HTMLElement>("[data-lb-open]");
      render();
      lb!.hidden = false;
      document.body.classList.add("hgal-lb-open");
      (closeEls[0] as HTMLButtonElement | undefined)?.focus();
    }

    function close() {
      lb!.hidden = true;
      document.body.classList.remove("hgal-lb-open");
      if (lbImg) lbImg.src = "";
      lastFocus?.focus();
    }

    function step(delta: number) {
      idx = (idx + delta + tiles.length) % tiles.length;
      render();
    }

    tiles.forEach((el, i) => {
      el.querySelector<HTMLElement>("[data-lb-open]")?.addEventListener("click", () => open(i));
    });
    closeEls.forEach((c) => c.addEventListener("click", close));
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  }

  document.addEventListener("astro:page-load", initHomeGallery);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHomeGallery);
  } else {
    initHomeGallery();
  }
</script>
