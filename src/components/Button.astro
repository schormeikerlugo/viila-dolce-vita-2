---
/**
 * Button — Tuscan Editorial variants.
 * - primary  → filled ink (ivory when onDark)
 * - secondary→ 1px hairline outline
 * - ghost    → uppercase text link with underline + ↗ arrow
 * Renders an <a> when `href` is given, otherwise a <button>.
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  onDark?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  onDark = false,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, onDark ? "btn--on-dark" : "", className]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes} href={href} {...rest}>
  <span class="btn__label"><slot /></span>
  {variant === "ghost" && <span class="btn__arrow" aria-hidden="true">↗</span>}
</Tag>

<style>
  .btn {
    /* DARK theme default: an ivory pill with ink text — the brightest CTA. */
    --btn-fg: var(--c-ink);
    --btn-bg: var(--c-ivory);
    --btn-border: var(--c-ivory);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2.1rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--btn-fg);
    background: var(--btn-bg);
    border: 1px solid var(--btn-border);
    border-radius: 0;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  /* Primary — filled ivory; hover empties to an ivory outline */
  .btn--primary:hover {
    --btn-bg: transparent;
    --btn-fg: var(--c-ivory);
  }

  /* Secondary — hairline outline on the night */
  .btn--secondary {
    --btn-bg: transparent;
    --btn-fg: var(--c-ivory);
    --btn-border: var(--line-strong);
  }
  .btn--secondary:hover {
    --btn-bg: var(--c-ivory);
    --btn-fg: var(--c-ink);
    --btn-border: var(--c-ivory);
  }

  /* Ghost — text + ↗ arrow, underline reveal */
  .btn--ghost {
    --btn-bg: transparent;
    --btn-fg: var(--c-ivory);
    padding: 0;
    border: 0;
    position: relative;
  }
  .btn--ghost .btn__label {
    position: relative;
  }
  .btn--ghost .btn__label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .btn--ghost:hover .btn__label::after {
    transform: scaleX(0);
    transform-origin: right;
  }
  .btn--ghost:hover {
    --btn-fg: var(--accent);
  }
  .btn__arrow {
    font-size: 0.85em;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--ghost:hover .btn__arrow {
    transform: translate(2px, -2px);
  }

  /* On dark surfaces */
  .btn--on-dark.btn--primary {
    --btn-bg: var(--c-ivory);
    --btn-fg: var(--c-ink);
    --btn-border: var(--c-ivory);
  }
  .btn--on-dark.btn--primary:hover {
    --btn-bg: transparent;
    --btn-fg: var(--c-ivory);
  }
  .btn--on-dark.btn--secondary {
    --btn-fg: var(--c-ivory);
    --btn-border: rgba(244, 241, 234, 0.45);
  }
  .btn--on-dark.btn--secondary:hover {
    --btn-bg: var(--c-ivory);
    --btn-fg: var(--c-ink);
    --btn-border: var(--c-ivory);
  }
  .btn--on-dark.btn--ghost {
    --btn-fg: var(--c-ivory);
  }
  .btn--on-dark.btn--ghost:hover {
    --btn-fg: var(--c-ivory);
    opacity: 0.8;
  }
</style>
