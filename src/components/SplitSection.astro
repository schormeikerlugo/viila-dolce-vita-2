---
/**
 * SplitSection — editorial two-column block (Tonelli): media leads at ~58%,
 * copy sits in a narrow column with the "↳" eyebrow, uppercase title, body
 * and an optional hairline meta-row of label/value pairs.
 *
 * Slots: default = body copy; "media" optional custom media.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArchImage from "./ArchImage.astro";
import Reveal from "./Reveal.astro";

interface Props {
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  reverse?: boolean;
  arch?: boolean;
  theme?: "ivory" | "dark" | "stone";
  parallax?: number | false;
  /** Optional meta row rendered under the copy on hairlines. */
  meta?: { label: string; value: string }[];
}
const {
  eyebrow,
  title,
  image,
  imageAlt = "",
  reverse = false,
  arch = false,
  theme = "ivory",
  parallax = 0.12,
  meta = [],
} = Astro.props;

const bgClass = theme === "dark" ? "bg-dark" : theme === "stone" ? "bg-sunk" : "bg-ivory";
---

<section class:list={["section", "split", bgClass, { "split--reverse": reverse }]}>
  <div class="split__inner wrap">
    <div class="split__media" data-parallax-scope>
      {
        image &&
          (arch ? (
            <ArchImage src={image} alt={imageAlt} parallax={parallax} />
          ) : (
            <div class="split__img hoist">
              <Image
                src={image}
                alt={imageAlt}
                widths={[560, 900, 1300, 1800]}
                sizes="(max-width: 900px) 92vw, 56vw"
                loading="lazy"
              />
            </div>
          ))
      }
      <slot name="media" />
    </div>

    <div class="split__copy">
      {eyebrow && <Reveal as="p" class="eyebrow">{eyebrow}</Reveal>}
      <Reveal as="h2" delay={0.05}>{title}</Reveal>
      <Reveal delay={0.12} class="split__body">
        <slot />
      </Reveal>
      {
        meta.length > 0 && (
          <Reveal delay={0.18}>
            <dl class="split__meta">
              {meta.map((m) => (
                <div class="split__metacell">
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>
          </Reveal>
        )
      }
    </div>
  </div>
</section>

<style>
  .split__inner {
    display: grid;
    /* Image leads: ~58% media, ~42% copy. */
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2.5rem, 6vw, 6.5rem);
    align-items: center;
  }
  .split--reverse .split__inner {
    /* Keep the media on the wide track so its width matches the default
       (and the PageHero) — copy takes the narrow track on the left. */
    grid-template-columns: 1fr 1.35fr;
  }
  .split--reverse .split__media {
    order: 2;
  }

  .split__img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .split__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__copy :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .split__copy :global(h2) {
    max-width: 18ch;
  }
  .split__body {
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    font-size: 1rem;
  }
  .split__body :global(p) {
    color: var(--text-muted);
    margin-bottom: 1.1rem;
    line-height: 1.75;
  }
  .bg-dark .split__body :global(p) {
    color: var(--text-on-dark-muted);
  }
  .split__body :global(.actions) {
    margin-top: 1.6rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Hairline meta-row (Tonelli "Room Type / Featuring / Dimensions"). */
  .split__meta {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(7.5rem, 100%), 1fr));
    gap: 1.25rem;
  }
  .split__metacell {
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .bg-dark .split__metacell {
    border-top-color: var(--line-on-dark);
  }
  .split__metacell dt {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }
  .bg-dark .split__metacell dt {
    color: var(--text-on-dark-muted);
  }
  .split__metacell dd {
    font-size: 0.92rem;
    color: var(--text);
  }
  .bg-dark .split__metacell dd {
    color: var(--text-on-dark);
  }

  @media (max-width: 900px) {
    .split__inner,
    .split--reverse .split__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .split--reverse .split__media {
      order: 0;
    }
  }
</style>
