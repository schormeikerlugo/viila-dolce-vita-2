---
/**
 * SuiteCard — editorial suite preview (Tonelli product card).
 * The image owns the card; beneath it a minimal line of copy and a hairline
 * meta-row: name ↗ / tagline / sleeps · from-rate.
 */
import { Image } from "astro:assets";
import type { Suite } from "../data/suites";

interface Props {
  suite: Suite;
  /** Large hero card: bigger image, intro text (homepage lead). */
  featured?: boolean;
  /** Horizontal compact row: small image + minimal copy (supporting list). */
  compact?: boolean;
  /** Framed card: hairline border + raised surface behind the copy. */
  panel?: boolean;
}
const { suite, featured = false, compact = false, panel = false } = Astro.props;
const href = `/suites#${suite.slug}`;
---

<article
  class:list={[
    "suite",
    { "suite--featured": featured, "suite--compact": compact, "suite--panel": panel },
  ]}
  data-reveal
>
  <a
    class="suite__media hoist"
    href={href}
    aria-label={`View the ${suite.name}`}
    transition:name={`suite-${suite.slug}`}
  >
    <Image
      src={suite.images[0]}
      alt={suite.imageAlt}
      widths={[400, 640, 900, 1200, 1600]}
      sizes={featured ? "(max-width: 900px) 92vw, 46vw" : "(max-width: 900px) 92vw, 30vw"}
      loading="lazy"
    />
    {suite.badge && <span class="suite__badge">{suite.badge}</span>}
  </a>
  <div class="suite__body">
    <div class="suite__row">
      <h3 class="suite__name">
        <a href={href}>{suite.name} <span class="suite__arrow" aria-hidden="true">↗</span></a>
      </h3>
      <p class="suite__sleeps">Sleeps {suite.sleeps}</p>
    </div>
    <p class="suite__tagline">{suite.tagline}</p>
    {featured && <p class="suite__intro">{suite.intro}</p>}
    <p class="suite__from">
      From <strong>€{suite.fromNight}</strong> <span>/ night</span>
    </p>
  </div>
</article>

<style>
  .suite {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .suite__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .suite__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .suite__badge {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--c-ivory);
    color: var(--c-ink);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.5rem 0.85rem;
  }
  .suite__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.1rem;
    flex: 1;
  }
  .suite__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .suite__name {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.45rem);
    letter-spacing: 0.04em;
  }
  .suite__name a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .suite__name a:hover {
    color: var(--accent);
  }
  .suite__arrow {
    font-family: var(--font-body);
    font-size: 0.6em;
    transform: translateY(-0.2em);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .suite__name a:hover .suite__arrow {
    transform: translate(2px, calc(-0.2em - 2px));
  }
  .suite__sleeps {
    flex: 0 0 auto;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .suite__tagline {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .suite__intro {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-top: 0.5rem;
    max-width: 52ch;
  }
  .suite__from {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .suite__from strong {
    color: var(--text);
    font-weight: 500;
    font-size: 0.85rem;
  }

  /* ---- Featured (large lead card) ---- */
  .suite--featured .suite__body {
    padding-top: 1.4rem;
    gap: 0.5rem;
  }
  .suite--featured .suite__name {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.2rem);
  }
  .suite--featured .suite__tagline {
    font-size: 0.95rem;
  }

  /* ---- Panel (framed card with its own surface) ---- */
  .suite--panel {
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .suite--panel:hover {
    border-color: rgba(22, 20, 18, 0.32);
  }
  .suite--panel .suite__media {
    /* Image bleeds to the frame; hairline separates it from the copy. */
    border-bottom: 1px solid var(--line);
  }
  .suite--panel .suite__body {
    padding: 1.15rem 1.25rem 1.25rem;
  }

  /* ---- Compact (horizontal supporting row) ---- */
  .suite--compact {
    flex-direction: row;
    gap: 1.25rem;
  }
  .suite--compact .suite__media {
    aspect-ratio: 1 / 1;
    flex: 0 0 42%;
  }
  .suite--compact .suite__body {
    padding-top: 0.25rem;
    gap: 0.25rem;
    justify-content: center;
  }
  .suite--compact .suite__name {
    font-size: 1.15rem;
  }
  .suite--compact .suite__tagline {
    font-size: 0.82rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .suite--compact .suite__from {
    margin-top: 0.6rem;
  }
  @media (max-width: 520px) {
    .suite--compact {
      flex-direction: column;
      gap: 0;
    }
    .suite--compact .suite__media {
      flex-basis: auto;
      aspect-ratio: 16 / 10;
    }
    .suite--compact .suite__body {
      padding-top: 1rem;
    }
  }
</style>
