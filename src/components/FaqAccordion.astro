---
/**
 * FaqAccordion — Masseto-style question list on a dark ground.
 * Native <details> accordions separated by hairlines; a thin "+" marker
 * rotates to "×" when open. Fully functional without JS.
 */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  /** Set false when rendered on a light section. */
  onDark?: boolean;
  /** Render every accordion expanded by default. */
  defaultOpen?: boolean;
  class?: string;
}
const { items, onDark = true, defaultOpen = true, class: className = "" } = Astro.props;
---

<div class:list={["faq", { "faq--light": !onDark }, className]}>
  {
    items.map((item, i) => (
      <details class="faq__item" open={defaultOpen} data-reveal data-reveal-delay={Math.min(i * 0.04, 0.2)}>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__marker" aria-hidden="true" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    --faq-line: var(--line-on-dark);
    --faq-fg: var(--text-on-dark);
    --faq-muted: var(--text-on-dark-muted);
    border-top: 1px solid var(--faq-line);
  }
  .faq--light {
    --faq-line: var(--line);
    --faq-fg: var(--text);
    --faq-muted: var(--text-muted);
  }
  .faq__item {
    border-bottom: 1px solid var(--faq-line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.2rem, 2.5vw, 1.8rem) 0.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body);
    font-size: clamp(0.92rem, 0.88rem + 0.25vw, 1.05rem);
    font-weight: 500;
    color: var(--faq-fg);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    color: var(--accent);
  }
  .faq__marker {
    position: relative;
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
  }
  .faq__marker::before,
  .faq__marker::after {
    content: "";
    position: absolute;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .faq__marker::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }
  .faq__marker::after {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq__item[open] .faq__marker::after {
    transform: translateX(-50%) scaleY(0);
  }
  .faq__a {
    padding: 0 0.25rem clamp(1.3rem, 2.5vw, 1.9rem);
    max-width: 68ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--faq-muted);
    overflow: hidden;
  }
</style>

<script>
  // Smooth open/close for the native <details> accordions (WAAPI).
  // Fully progressive: without JS the accordions still toggle natively.
  function initFaq() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document
      .querySelectorAll<HTMLDetailsElement>(".faq__item:not([data-anim])")
      .forEach((item) => {
        item.dataset.anim = "1";
        const summary = item.querySelector<HTMLElement>(".faq__q");
        const answer = item.querySelector<HTMLElement>(".faq__a");
        if (!summary || !answer || reduce) return;

        let animating = false;
        summary.addEventListener("click", (e) => {
          e.preventDefault();
          if (animating) return;
          animating = true;

          if (item.open) {
            // Collapse: animate to 0, then close.
            const h = answer.offsetHeight;
            const anim = answer.animate(
              [
                { height: `${h}px`, opacity: 1 },
                { height: "0px", opacity: 0 },
              ],
              { duration: 260, easing: "cubic-bezier(0.65, 0, 0.35, 1)" },
            );
            anim.onfinish = () => {
              item.open = false;
              animating = false;
            };
          } else {
            item.open = true;
            const h = answer.offsetHeight;
            const anim = answer.animate(
              [
                { height: "0px", opacity: 0 },
                { height: `${h}px`, opacity: 1 },
              ],
              { duration: 320, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            );
            anim.onfinish = () => {
              animating = false;
            };
          }
        });
      });
  }

  document.addEventListener("astro:page-load", initFaq);
  if (document.readyState !== "loading") initFaq();
  else document.addEventListener("DOMContentLoaded", initFaq);
</script>
