---
/**
 * Footer — Tuscan Editorial: hairline sitemap columns and the oversized
 * "Dolce Vita" wordmark bleeding off the bottom edge (Tonelli signature).
 */
import { contact, nav, site, social } from "../data/site";

const services = nav.filter((n) =>
  ["/experiences", "/weddings-events", "/journal"].includes(n.href),
);
const quick = nav.filter((n) =>
  ["/the-property", "/gallery", "/contact"].includes(n.href),
);
/** Explore column links, incl. the external Google reviews page. */
const exploreLinks = [
  ...quick,
  { label: "Reviews", href: "https://share.google/XQXPoXfwHHaS6zwiF", external: true },
];
const year = new Date().getFullYear();
---

<footer class="footer bg-dark">
  <div class="footer__top wrap">
    <div class="footer__brand">
      <p class="footer__eyebrow">Villa Dolce Vita</p>
      <p class="footer__tag">{site.tagline}</p>
      <address class="footer__contact">
        <a href={contact.whatsappHref}>WhatsApp — {contact.whatsapp}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <span>{contact.address}</span>
      </address>
    </div>

    <nav class="footer__col" aria-label="Experiences">
      <h3>Experiences</h3>
      <ul>
        {services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Explore">
      <h3>Explore</h3>
      <ul>
        {
          exploreLinks.map((q) => (
            <li>
              {"external" in q && q.external ? (
                <a href={q.href} target="_blank" rel="noopener noreferrer">
                  {q.label} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <a href={q.href}>{q.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Social">
      <h3>Social</h3>
      <ul>
        {
          social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="footer__bottom wrap">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>Massa Marittima, Tuscany · Italy</p>
  </div>

  <p class="footer__wordmark" aria-hidden="true">Dolce&nbsp;Vita</p>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 2.6fr 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line-on-dark);
  }
  .footer__eyebrow {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer__tag {
    margin-top: 0.6rem;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }
  .footer__contact {
    margin-top: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
  }
  .footer__contact a {
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast);
  }
  .footer__contact a:hover {
    color: var(--c-ivory);
    border-color: currentColor;
  }

  .footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-bottom: 1.2rem;
    font-weight: 500;
  }
  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer__col a {
    font-size: 0.85rem;
    color: var(--c-ivory);
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .footer__col a:hover {
    opacity: 1;
  }
  .footer__col a span {
    font-size: 0.8em;
    color: var(--text-on-dark-muted);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.75rem 0.5rem;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgba(182, 175, 162, 0.7);
  }

  /* Oversized wordmark bleeding off the bottom edge. */
  .footer__wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 13.5vw, 15rem);
    line-height: 0.72;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: center;
    color: var(--c-ivory);
    max-width: none;
    white-space: nowrap;
    margin-top: clamp(2rem, 5vw, 4rem);
    margin-bottom: -0.08em;
    user-select: none;
  }

  @media (max-width: 1080px) {
    .footer__top {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
