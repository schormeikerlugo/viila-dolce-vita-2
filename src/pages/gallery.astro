---
/**
 * Gallery — the visual archive of the estate and its surroundings.
 *
 * "Tuscan Editorial" reskin: split PageHero, a left-aligned archive header
 * with the "/ Visual Archive" slash-label + live count, square hairline
 * filter chips and search, and a dense UNIFORM grid (Masseto): 5 columns,
 * 4/3 tiles, 0.6rem gaps — no shadows, no radius, no hover-lift; only the
 * quiet image zoom. Full lightbox with prev/next, keyboard nav, counter
 * and download, restyled on hairlines.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Reveal from "../components/Reveal.astro";
import { galleryItems, galleryCategories } from "../data/gallery";

const heroImage = galleryItems.find((i) => i.slug === "villa-aerial")!.image;
const total = galleryItems.length;

// Label lookup so chips + captions read nicely ("Around Tuscany", not "tuscany").
const catLabel = Object.fromEntries(galleryCategories.map((c) => [c.id, c.label]));

import { lqipStyle } from "../lib/lqip";

const items = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    label: catLabel[item.cat] ?? item.cat,
    lqip: await lqipStyle(item.image),
  })),
);
---

<BaseLayout
  title="Gallery"
  description="A visual archive of Villa Dolce Vita — the hilltop estate, the Tuscan landscape around it, the experiences, the villages and the celebrations."
>
  <PageHero
    eyebrow="Gallery"
    title="The Estate, in Pictures"
    subtitle="The villa on its hilltop, the hills and villages around it, and the days in between — a slow scroll through the world you'll be staying in."
    image={heroImage}
    imageAlt="Golden hour over Villa Dolce Vita and the surrounding woods"
  />

  <section class="section bg-ivory gal-section">
    <div class="wrap">
      <!-- Archive header — editorial, left-aligned, on a hairline. -->
      <header class="gal-head">
        <Reveal as="p" class="slash-label">Visual Archive</Reveal>
        <Reveal as="p" class="gal-count" delay={0.05}>
          <span data-gal-count>{total}</span> photographs
        </Reveal>
      </header>

      <!-- Controls: category chips + search -->
      <div class="gal-controls" data-reveal>
        <div class="gal-chips" role="group" aria-label="Filter by category">
          <button type="button" class="gal-chip is-active" data-cat="" aria-pressed="true">
            All
          </button>
          {
            galleryCategories.map((c) => (
              <button type="button" class="gal-chip" data-cat={c.id} aria-pressed="false">
                {c.label}
              </button>
            ))
          }
        </div>
        <div class="gal-search">
          <svg
            class="gal-search__icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            id="gallery-search"
            class="gal-search__input"
            placeholder="Search photographs…"
            autocomplete="off"
            aria-label="Search photographs by description"
          />
        </div>
      </div>
    </div>

    <!-- Full-bleed uniform grid (Masseto) -->
    <div class="wp-grid" id="gal-grid">
      {
        items.map((item) => (
          <figure
            class="wp-item"
            data-reveal
            data-cat={item.cat}
            data-title={item.alt.toLowerCase()}
            data-credit={item.label}
            style={item.lqip}
          >
            <button
              type="button"
              class="wp-item__link hoist"
              aria-label={`View ${item.alt}`}
              aria-haspopup="dialog"
              data-lb-open
              data-cursor="view"
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[320, 480, 800, 1600]}
                sizes="(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 20vw"
                loading="lazy"
              />
              <figcaption class="wp-item__cap">
                <span class="wp-item__title">{item.alt}</span>
                <span class="wp-item__credit">{item.label}</span>
              </figcaption>
            </button>
          </figure>
        ))
      }
    </div>

    <div class="wrap">
      <p class="gal-empty" id="gallery-empty" hidden>No photographs match your filters.</p>
    </div>

    <!-- ─── Lightbox modal ─── -->
    <div
      class="gal-lb"
      id="gallery-lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Photograph viewer"
      hidden
    >
      <div class="gal-lb__backdrop" data-lb-close></div>

      <button type="button" class="gal-lb__btn gal-lb__close" data-lb-close aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <button
        type="button"
        class="gal-lb__btn gal-lb__nav gal-lb__prev"
        data-lb-prev
        aria-label="Previous photograph"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <figure class="gal-lb__figure">
        <img class="gal-lb__img" src="" alt="" />
        <figcaption class="gal-lb__bar">
          <span class="gal-lb__meta">
            <span class="gal-lb__title" data-lb-title></span>
            <span class="gal-lb__credit" data-lb-credit></span>
          </span>
          <span class="gal-lb__actions">
            <span class="gal-lb__count" data-lb-count aria-live="polite"></span>
            <button
              type="button"
              class="gal-lb__btn gal-lb__dl"
              data-lb-download
              aria-label="Download full-resolution photograph"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              <span>Download</span>
            </button>
          </span>
        </figcaption>
      </figure>

      <button
        type="button"
        class="gal-lb__btn gal-lb__nav gal-lb__next"
        data-lb-next
        aria-label="Next photograph"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ─── Archive header — slash-label + count on a hairline ─── */
  .gal-section {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .gal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .gal-count {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ─── Controls: chips + search ─── */
  .gal-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin: clamp(1.4rem, 2.5vw, 2rem) 0 clamp(1.6rem, 3vw, 2.4rem);
    flex-wrap: wrap;
  }
  .gal-chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .gal-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    line-height: 1;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .gal-chip:hover {
    border-color: var(--line-strong);
  }
  .gal-chip.is-active {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-ivory);
  }

  .gal-search {
    position: relative;
    flex: 0 0 auto;
    width: min(320px, 100%);
  }
  .gal-search__icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .gal-search__input {
    width: 100%;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.65rem 1rem 0.65rem 2.5rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .gal-search__input::placeholder {
    color: var(--text-muted);
  }
  .gal-search__input:focus {
    outline: none;
    border-color: var(--c-ink);
  }

  @media (max-width: 760px) {
    .gal-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      width: 100%;
      padding-bottom: 4px;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }
    .gal-search {
      width: 100%;
    }
  }

  /* ─── Full-bleed uniform grid (Masseto) ─── */
  .wp-grid {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;
  }
  @media (max-width: 1400px) {
    .wp-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 1100px) {
    .wp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 760px) {
    .wp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gal-empty {
    margin-top: 3rem;
    text-align: center;
    font-size: 1rem;
    color: var(--text-muted);
  }

  .wp-item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    background: var(--surface-sunk);
    overflow: hidden;
    /* Skip rendering work for offscreen tiles — the archive holds 115
       photographs. The intrinsic size matches the 4/3 tile so scrollbars
       stay stable. */
    content-visibility: auto;
    contain-intrinsic-size: auto 300px auto 225px;
  }
  /* `display: block` outranks UA `[hidden] { display: none }`; force it. */
  .wp-item[hidden] {
    display: none;
  }

  .wp-item__link {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .wp-item__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wp-item__cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.2rem 0.9rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: left;
    background: linear-gradient(to top, rgba(22, 20, 18, 0.78) 0%, rgba(22, 20, 18, 0) 100%);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .wp-item:hover .wp-item__cap,
  .wp-item:focus-within .wp-item__cap {
    opacity: 1;
  }
  .wp-item__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--c-ivory);
  }
  .wp-item__credit {
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--text-on-dark-muted);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* ─── Lightbox modal ─── */
  .gal-lb {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .gal-lb[hidden] {
    display: none;
  }
  .gal-lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(22, 20, 18, 0.94);
    animation: gal-lb-fade var(--dur-fast) var(--ease-out) both;
  }
  .gal-lb__figure {
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 100%;
    max-height: 100%;
    animation: gal-lb-fade var(--dur-fast) var(--ease-out) both;
  }
  .gal-lb__img {
    display: block;
    max-width: min(90vw, 1400px);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--c-ink-soft);
  }
  /* Caption bar sits under the image on a single hairline. */
  .gal-lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(90vw, 1400px);
    max-width: 100%;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    margin-top: 0.9rem;
    border-top: 1px solid var(--line-on-dark);
  }
  .gal-lb__meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .gal-lb__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--c-ivory);
  }
  .gal-lb__credit {
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--text-on-dark-muted);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .gal-lb__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 0 0 auto;
  }
  .gal-lb__count {
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--text-on-dark-muted);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Square hairline buttons — the editorial control language. */
  .gal-lb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid var(--line-on-dark);
    border-radius: 0;
    background: transparent;
    color: var(--c-ivory);
    cursor: pointer;
    font-family: var(--font-body);
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .gal-lb__btn:hover {
    background: var(--c-ivory);
    border-color: var(--c-ivory);
    color: var(--c-ink);
  }
  .gal-lb__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .gal-lb__close {
    position: absolute;
    z-index: 2;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 44px;
    height: 44px;
  }
  .gal-lb__nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
  }
  .gal-lb__prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .gal-lb__next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
  .gal-lb__dl {
    padding: 0.55rem 1.1rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  @keyframes gal-lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  body.gal-lb-open {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .gal-lb__img {
      max-height: 70vh;
    }
    .gal-lb__nav {
      width: 44px;
      height: 44px;
    }
    .gal-lb__dl span {
      display: none;
    }
    .gal-lb__dl {
      width: 44px;
      height: 44px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wp-item__cap,
    .gal-lb__backdrop,
    .gal-lb__figure {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  function initGallery() {
    const root = document.querySelector<HTMLElement>(".gal-section");
    if (!root || root.dataset.galReady === "1") return;
    root.dataset.galReady = "1";

    const searchEl = document.getElementById("gallery-search") as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".gal-chip"));
    const items = Array.from(document.querySelectorAll<HTMLElement>(".wp-item"));
    const emptyEl = document.getElementById("gallery-empty");
    const countEl = document.querySelector<HTMLElement>("[data-gal-count]");
    const total = items.length;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let activeCat = "";

    function apply(animate = false) {
      const q = (searchEl?.value ?? "").trim().toLowerCase();

      // FLIP: capture the surviving tiles' positions before the reflow…
      const doFlip = animate && !reduceMotion;
      const state = doFlip ? Flip.getState(items.filter((el) => !el.hidden)) : null;

      let visible = 0;
      items.forEach((el) => {
        const matchCat = !activeCat || el.dataset.cat === activeCat;
        const matchQ = !q || (el.dataset.title ?? "").includes(q);
        const show = matchCat && matchQ;
        el.hidden = !show;
        if (show) visible++;
      });
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (countEl)
        countEl.textContent = visible === total ? String(total) : `${visible} / ${total}`;

      // …then glide them to their new spots; newcomers fade in.
      if (state) {
        Flip.from(state, {
          duration: 0.5,
          ease: "power3.out",
          stagger: 0.008,
          onEnter: (els) =>
            gsap.fromTo(els, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.4 }),
          onLeave: (els) => gsap.set(els, { opacity: 1 }),
        });
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeCat = chip.dataset.cat ?? "";
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle("is-active", on);
          c.setAttribute("aria-pressed", String(on));
        });
        apply(true);
      });
    });

    searchEl?.addEventListener("input", () => apply(false));

    // ─── Lightbox ───────────────────────────────────────────────
    const lb = document.getElementById("gallery-lightbox");
    if (!lb) return;

    // Portal the modal to <body> so no transformed/`will-change` ancestor
    // (e.g. the section's reveal wrappers) traps its `position: fixed`.
    if (lb.parentElement !== document.body) document.body.appendChild(lb);

    const lbImg = lb.querySelector<HTMLImageElement>(".gal-lb__img");
    const lbTitle = lb.querySelector<HTMLElement>("[data-lb-title]");
    const lbCredit = lb.querySelector<HTMLElement>("[data-lb-credit]");
    const lbCount = lb.querySelector<HTMLElement>("[data-lb-count]");
    const dlBtn = lb.querySelector<HTMLButtonElement>("[data-lb-download]");
    const closeEls = Array.from(lb.querySelectorAll<HTMLElement>("[data-lb-close]"));
    const prevBtn = lb.querySelector<HTMLButtonElement>("[data-lb-prev]");
    const nextBtn = lb.querySelector<HTMLButtonElement>("[data-lb-next]");

    let group: HTMLElement[] = [];
    let idx = -1;
    let lastFocus: HTMLElement | null = null;

    function visibleItems(): HTMLElement[] {
      return items.filter((el) => !el.hidden);
    }

    /** Largest candidate from the tile's srcset — reuse the 1600w asset. */
    function largestSrc(img: HTMLImageElement): string {
      const candidates = (img.srcset || "")
        .split(",")
        .map((s) => s.trim().split(/\s+/))
        .filter((p) => p[0]);
      if (!candidates.length) return img.currentSrc || img.src;
      candidates.sort((a, b) => parseInt(b[1] || "0") - parseInt(a[1] || "0"));
      return candidates[0][0];
    }

    function fileNameFor(url: string, title: string): string {
      const slug =
        title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "") || "photograph";
      const m = url.split("?")[0].match(/\.(jpe?g|png|webp|avif|gif)$/i);
      const ext = m ? m[1].toLowerCase() : "jpg";
      return `villa-dolce-vita-${slug}.${ext}`;
    }

    function render() {
      const el = group[idx];
      if (!el || !lbImg) return;
      const img = el.querySelector<HTMLImageElement>("img");
      const title = el.querySelector(".wp-item__title")?.textContent?.trim() ?? "";
      const credit = el.dataset.credit ?? "";
      lbImg.src = img ? largestSrc(img) : "";
      lbImg.alt = title;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCredit) lbCredit.textContent = credit;
      if (lbCount) lbCount.textContent = `${idx + 1} / ${group.length}`;
    }

    function openAt(el: HTMLElement) {
      group = visibleItems();
      idx = group.indexOf(el);
      if (idx < 0) return;
      lastFocus = el.querySelector<HTMLElement>(".wp-item__link");
      render();
      lb!.hidden = false;
      document.body.classList.add("gal-lb-open");
      (closeEls[0] as HTMLButtonElement | undefined)?.focus();
    }

    function close() {
      lb!.hidden = true;
      document.body.classList.remove("gal-lb-open");
      if (lbImg) lbImg.src = "";
      lastFocus?.focus();
    }

    function step(delta: number) {
      if (group.length === 0) return;
      idx = (idx + delta + group.length) % group.length;
      render();
    }

    async function download() {
      const el = group[idx];
      if (!el || !dlBtn || !lbImg) return;
      const url = lbImg.src;
      if (!url) return;
      const name = fileNameFor(url, lbTitle?.textContent ?? "photograph");
      dlBtn.disabled = true;
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(String(res.status));
        const blob = await res.blob();
        const obj = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = obj;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(obj);
      } catch {
        window.open(url, "_blank", "noopener");
      } finally {
        dlBtn.disabled = false;
      }
    }

    items.forEach((el) => {
      el.querySelector<HTMLElement>("[data-lb-open]")?.addEventListener("click", () => openAt(el));
    });
    closeEls.forEach((c) => c.addEventListener("click", close));
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));
    dlBtn?.addEventListener("click", download);

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  }

  document.addEventListener("astro:page-load", initGallery);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }
</script>
