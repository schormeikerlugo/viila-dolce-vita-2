---
/**
 * Weddings & Events — hilltop ceremonies for 50–100 guests.
 * Copy lifted verbatim from content.md (Weddings & Events page).
 * Tuscan Editorial reskin: split hero with meta, photo carousel, tier
 * spec-table, hairline planning list, closing CTA banner.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SplitSection from "../components/SplitSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SpecTable from "../components/SpecTable.astro";
import CardCarousel from "../components/CardCarousel.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { Image } from "astro:assets";
import { photos } from "../data/media";
import { weddingTiers, weddingTiersNote } from "../data/packages";

const planning = [
  {
    title: "The Season",
    text: "Late spring through early autumn gives the best odds of a clear, warm evening for the sunset ceremony.",
  },
  {
    title: "The Guest Count",
    text: "Ceremony and reception capacity are confirmed separately, as the two may differ.",
  },
  {
    title: "A Plan for Rain",
    text: "A weather contingency is agreed before booking, so a change in the sky never changes the day.",
  },
  {
    title: "Getting Here",
    text: "Parking and shuttle logistics are arranged in advance for guests arriving from Pisa (≈1.5 h) or Florence (≈2 h).",
  },
];

// The day in photos — every wedding photo in the set, image-first.
const moments = [
  { image: photos.weddingCeremonyKiss, alt: "The couple share a kiss at the outdoor cocktail hour" },
  { image: photos.weddingGoldenHour, alt: "Bride and groom with champagne on the terrace at sunset" },
  { image: photos.weddingSparklerNight, alt: "The couple with a sparkler before the lit villa at night" },
  { image: photos.weddingCellarToast, alt: "The couple toasting in the estate wine cellar" },
  { image: photos.weddingArrivalCar, alt: "Bride and groom beside a car before the villa" },
];

// Wedding tiers → spec rows.
const tierRows = weddingTiers.map((t) => ({
  title: t.tier,
  note: t.includes,
  specs: [{ label: "Guests", value: t.guests }],
}));
---

<BaseLayout
  title="Weddings & Events"
  description="A marble hilltop terrace, sunsets behind Elba and Corsica, a menu from our own kitchen — Villa Dolce Vita hosts Tuscan weddings of fifty to a hundred guests."
>
  <PageHero
    eyebrow="Weddings & Events"
    title="A Marble Terrace on Top of a Hill"
    subtitle="Fifty to a hundred guests is a genuinely smart size to build a wedding around: big enough for a real celebration, with a dance floor and a full guest list, small enough that it never feels like an event venue. Villa Dolce Vita was built for weddings this size, not scaled down to fit them."
    image={photos.weddingTerraceHilltop}
    imageAlt="The marble hilltop terrace overlooking the Tuscan valley"
    meta={[
      { label: "Capacity", value: "Up to 100 Guests" },
      { label: "Setting", value: "Marble Hilltop Terrace" },
      { label: "Tiers", value: "3" },
    ]}
  />

  <!-- THE SETTING -->
  <SplitSection
    eyebrow="The Setting"
    title="Where the Sky Does Most of the Work"
    image={photos.weddingSettingView}
    imageAlt="A table set on the wisteria terrace, the Tuscan valley beyond"
    reverse
  >
    <p>
      Ceremonies take place on the hilltop terrace, looking out over vineyards,
      olive groves, and the sea, with Isola d'Elba and, on the clearest days,
      Corsica, visible on the horizon.
    </p>
    <p>
      Timed right, the cocktail hour rolls straight into sunset, with the sky
      over the water behind the islands doing most of the work for you.
    </p>
  </SplitSection>

  <!-- THE CEREMONY -->
  <SplitSection
    eyebrow="The Ceremony"
    title="Vows as the Light Goes Gold"
    image={photos.weddingGoldenHour}
    imageAlt="Bride and groom with champagne on the terrace at sunset"
    reverse
    theme="stone"
  >
    <p>
      Say your vows outdoors, in the open air, with the whole valley falling
      away below and the light turning gold behind you. Fifty to a hundred
      guests fit the terrace comfortably — close enough to feel the moment, far
      enough to give it room.
    </p>
    <p>
      Afterwards, the celebration moves at its own pace: a glass in hand, the
      last of the sun on the sea, and no reason to rush anywhere.
    </p>
  </SplitSection>

  <!-- THE RECEPTION -->
  <SplitSection
    eyebrow="The Reception"
    title="From the Terrace, Into the Vines"
    image={photos.weddingSparklerNight}
    imageAlt="The couple with a sparkler before the lit villa at night"
    theme="dark"
  >
    <p>
      When the ceremony ends, the celebration simply moves off the marble
      and down among the vines, where dinner is served under the open sky
      and the evening finds its own unhurried pace.
    </p>
  </SplitSection>

  <!-- MOMENTS CAROUSEL -->
  <section class="section bg-ivory moments">
    <div class="wrap">
      <SectionHeader
        eyebrow="The Day Itself"
        title="The Moments You'll Remember"
        align="left"
      >
        <p>
          From the first look to the last dance — the quiet ones and the loud
          ones both.
        </p>
      </SectionHeader>
      <CardCarousel label="Wedding moments">
        {
          moments.map((m, i) => (
            <figure class="moment">
              <div class="moment__media hoist">
                <Image
                  src={m.image}
                  alt={m.alt}
                  widths={[560, 900, 1300]}
                  sizes="(max-width: 860px) 88vw, 42vw"
                  loading="lazy"
                />
              </div>
              <figcaption class="moment__cap">
                {String(i + 1).padStart(2, "0")} / {String(moments.length).padStart(2, "0")}
              </figcaption>
            </figure>
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <!-- WEDDING TIERS -->
  <section class="section bg-sunk tiers">
    <div class="wrap">
      <SectionHeader eyebrow="Wedding Tiers" title="Three Ways to Celebrate" align="left" />
      <SpecTable rows={tierRows} />
      <p class="tiers__note">{weddingTiersNote}</p>
      <div class="tiers__cta">
        <Button href="/contact" variant="ghost">Request a Wedding Quote</Button>
      </div>
    </div>
  </section>

  <!-- PLANNING DETAILS -->
  <section class="section bg-ivory planning-sec">
    <div class="wrap planning-grid">
      <aside class="planning-aside">
        <Reveal as="p" class="eyebrow">Planning Details</Reveal>
        <Reveal as="h2" delay={0.05}>The Things Worth<br />Settling Early</Reveal>
        <Reveal as="p" class="planning-aside__note" delay={0.1}>
          A few details, agreed early, keep the day itself effortless. We handle the rest.
        </Reveal>
      </aside>

      <ol class="planning">
        {
          planning.map((p, i) => (
            <li class="pitem" data-reveal data-reveal-delay={0.05 * i}>
              <span class="pitem__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div class="pitem__body">
                <h3 class="pitem__title">{p.title}</h3>
                <p class="pitem__text">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    eyebrow="Start the Conversation"
    title="Picture Your Own Setup"
    sub="Tell us the date and the headcount — we'll build the rest around your day."
    ctaLabel="Enquire About Your Date"
    ctaHref="/contact"
    image={photos.weddingArrivalCar}
    imageAlt="Bride and groom beside a car before the villa"
  />
</BaseLayout>

<style>
  /* ── Moments carousel ─────────────────────────────────────────────────── */
  .moment {
    margin: 0;
    flex: 0 0 clamp(18rem, 42vw, 38rem);
  }
  .moment__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .moment__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .moment__cap {
    margin-top: 0.9rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Wedding tiers ────────────────────────────────────────────────────── */
  .tiers__note {
    margin-top: 1.25rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .tiers__cta {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* ── Planning details — sticky aside + hairline list ──────────────────── */
  .planning-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .planning-aside {
    position: sticky;
    top: clamp(4rem, 12vh, 8rem);
  }
  .planning-aside :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .planning-aside :global(.planning-aside__note) {
    color: var(--text-muted);
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    max-width: 34ch;
  }

  .planning {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .pitem {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--line);
  }
  .pitem__num {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    color: var(--text-muted);
    padding-top: 0.4rem;
  }
  .pitem__title {
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    margin-bottom: 0.6rem;
  }
  .pitem__text {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  @media (max-width: 960px) {
    .planning-grid {
      grid-template-columns: 1fr;
    }
    .planning-aside {
      position: static;
    }
  }
</style>
