---
/**
 * Packages & Rates — nightly rates, experience packages, wedding tiers.
 * All data from packages.ts (content.md). Rates are starting points to be
 * confirmed with ownership (see Docs).
 * Tuscan Editorial: hairline tables (SpecTable), no cards, single accent.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SpecTable from "../components/SpecTable.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { photos } from "../data/media";
import { bookingHref } from "../data/site";
import {
  packagesIntro,
  rateColumns,
  rates,
  packages,
  weddingTiers,
  weddingTiersNote,
} from "../data/packages";

// SpecTable rows — experience packages, led by their Italian names.
const packageRows = packages.map((p) => ({
  title: p.italian,
  note: p.name,
  specs: [
    { label: "Duration", value: p.nights },
    { label: "Includes", value: p.includes.join(" · ") },
    { label: "Price", value: p.price },
  ],
}));

// SpecTable rows — wedding tiers on the ink ground.
const tierRows = weddingTiers.map((t) => ({
  title: t.tier,
  specs: [
    { label: "Guests", value: `${t.guests} guests` },
    { label: "Includes", value: t.includes },
  ],
}));
---

<BaseLayout
  title="Packages & Rates"
  description="Nightly rates by suite and season, bundled experience packages from Rest & Reset to Honeymoon, and three wedding tiers for up to 100 guests."
>
  <PageHero
    eyebrow="Packages & Rates"
    title="A Clear Price, Not a Menu of Add-Ons"
    subtitle={packagesIntro}
    image={photos.valdorciaMist}
    imageAlt="Misty Tuscan hills at dawn"
    meta={[
      { label: "Suites", value: String(rates.length) },
      { label: "Experience Packages", value: String(packages.length) },
      { label: "Wedding Tiers", value: String(weddingTiers.length) },
    ]}
  />

  <!-- NIGHTLY RATES — editorial hairline table -->
  <section class="section bg-sunk" aria-label="Nightly rates by suite">
    <div class="wrap">
      <SectionHeader
        eyebrow="Nightly Rates by Suite"
        title="What a Night Costs, by Season"
        align="left"
      />
      <div class="rate-scroll" data-reveal tabindex="0">
        <table class="rate-table">
          <thead>
            <tr>
              <th scope="col">Suite</th>
              <th scope="col">{rateColumns.low}</th>
              <th scope="col">{rateColumns.shoulder}</th>
              <th scope="col">{rateColumns.peak}</th>
            </tr>
          </thead>
          <tbody>
            {
              rates.map((r) => (
                <tr>
                  <th scope="row" class="rate-suite">{r.suite}</th>
                  <td>{r.low}</td>
                  <td>{r.shoulder}</td>
                  <td>{r.peak}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE PACKAGES — spec rows with hairlines -->
  <section class="section bg-ivory" aria-label="Experience packages">
    <div class="wrap">
      <SectionHeader
        eyebrow="Experience Packages"
        title="Bundled, Named, Priced"
        align="left"
      >
        <p>Five ways to spend your stay, each built around a different rhythm.</p>
      </SectionHeader>
      <SpecTable rows={packageRows} />
      <div class="section-foot" data-reveal data-reveal-delay={0.1}>
        <Button href={bookingHref} variant="ghost">Enquire</Button>
      </div>
    </div>
  </section>

  <!-- WEDDING TIERS — ink ground -->
  <section class="section bg-dark" aria-labelledby="tiers-title">
    <div class="wrap tiers__grid">
      <div class="tiers__head">
        <Reveal as="p" class="eyebrow">Wedding Tiers</Reveal>
        <h2 id="tiers-title" data-reveal data-reveal-delay={0.05}>Three Ways to Celebrate</h2>
        <Reveal as="p" class="tiers__note" delay={0.1}>{weddingTiersNote}</Reveal>
        <Reveal delay={0.15} class="tiers__cta">
          <Button href="/contact" variant="secondary" onDark>Request a Wedding Quote</Button>
        </Reveal>
      </div>
      <SpecTable rows={tierRows} onDark />
    </div>
  </section>

  <!-- CLOSING CTA -->
  <CtaBanner
    eyebrow="Book Direct"
    title="The Best Rate<br />Is Always Here"
    sub="Reserve directly with us — no third parties, no markup."
    ctaLabel="Check Availability"
    ctaHref={bookingHref}
    image={photos.terraceTableView}
    imageAlt="The loggia terrace with the hills opening out beyond"
  />
</BaseLayout>

<style>
  /* ── Nightly rates table — filetes 1px, Archivo data ─────────────────── */
  .rate-scroll {
    overflow-x: auto;
  }
  .rate-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .rate-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    border-top: 1px solid var(--line);
  }
  .rate-table th,
  .rate-table td {
    text-align: left;
    vertical-align: top;
    padding: clamp(1rem, 2vw, 1.4rem) 1rem;
    border-bottom: 1px solid var(--line);
  }
  .rate-table th:first-child,
  .rate-table td:first-child {
    padding-left: 0.25rem;
  }
  .rate-table thead th {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rate-table tbody td {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .rate-suite {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
    max-width: 26ch;
  }

  /* ── Enquire foot link ────────────────────────────────────────────────── */
  .section-foot {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ── Wedding tiers — sticky head + dark spec table ────────────────────── */
  .tiers__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) 1.4fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  .tiers__head {
    position: sticky;
    top: clamp(6rem, 12vh, 8rem);
  }
  .tiers__head :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .tiers__head :global(.tiers__note) {
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 38ch;
  }
  .tiers__head :global(.tiers__cta) {
    margin-top: clamp(1.8rem, 3vw, 2.5rem);
  }

  @media (max-width: 900px) {
    .tiers__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .tiers__head {
      position: static;
    }
  }
</style>
