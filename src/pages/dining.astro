---
/**
 * Dining — the menu, private dinner pricing, welcome baskets and the cellar.
 * All copy/data from dining.ts (content.md, Dining page).
 * Tuscan Editorial reskin: split hero with price meta, spec tables for
 * pricing, and a Tonelli-style hairline wine list on ink.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SplitSection from "../components/SplitSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SpecTable from "../components/SpecTable.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { Image } from "astro:assets";
import { photos, mockups } from "../data/media";
import { bookingHref, notices } from "../data/site";
import {
  diningIntro,
  dinner,
  baskets,
  wineIntro,
  wineList,
} from "../data/dining";

// Private dinner pricing → spec rows.
const dinnerRows = dinner.prices.map((p) => ({
  title: p.label,
  specs: [{ label: "Price", value: p.price }],
}));

// Welcome baskets → spec rows (price + full contents).
const basketRows = baskets.map((b) => ({
  title: b.name,
  note: b.subtitle,
  specs: [
    { label: "Price", value: b.price },
    { label: "Contents", value: b.items.join(" · ") },
  ],
}));

/** Split "Wine Name (1967)" into name + parenthetical detail for the
 *  two-column list; purely presentational, the data stays verbatim. */
const parseWine = (w: string) => {
  const m = w.match(/^(.*?)\s*\(([^)]+)\)$/);
  return m ? { name: m[1], detail: m[2] } : { name: w, detail: "" };
};
---

<BaseLayout
  title="Dining"
  description="A 38-month aged parmigiano wheel, private dinners for four or more, welcome baskets, and a cellar spanning three countries and five decades."
>
  <PageHero
    eyebrow="Dining"
    title="Spaghetti Tossed in a Flaming Wheel of Parmigiano"
    image={photos.terraceTableTall}
    imageAlt="Private terrace dinner set for the evening"
    meta={[
      ...dinner.prices.map((p) => ({ label: p.label, value: p.price })),
      { label: "Welcome Baskets", value: String(baskets.length) },
    ]}
  />

  <!-- SIGNATURE -->
  <SplitSection
    eyebrow="The Signature"
    title="A Table Worth Sitting Down For"
    image={mockups.menuReserved}
    imageAlt="Villa Dolce Vita menu and reserved card on the dinner table"
    reverse
  >
    <p class="lead">{diningIntro}</p>
  </SplitSection>

  <!-- PRIVATE DINNER MENU -->
  <section class="section bg-sunk">
    <div class="wrap">
      <SectionHeader eyebrow="Private Dinners" title="The Menu" align="left">
        <p>{dinner.note}</p>
      </SectionHeader>

      <div class="menu">
        <div class="menu__course" data-reveal>
          <h3>Off the BBQ</h3>
          <ul>{dinner.mains.map((m) => <li>{m}</li>)}</ul>
        </div>
        <div class="menu__course" data-reveal>
          <h3>Pasta & Table</h3>
          <ul>{dinner.pasta.map((m) => <li>{m}</li>)}</ul>
        </div>
        <div class="menu__course" data-reveal>
          <h3>Dolce</h3>
          <ul><li>{dinner.dessert}</li></ul>
        </div>
      </div>

      <div class="menu__pricing">
        <SpecTable rows={dinnerRows} />
        <p class="fineprint">{dinner.wineNote}</p>
      </div>
    </div>
  </section>

  <!-- WELCOME BASKETS -->
  <section class="section bg-ivory">
    <div class="wrap">
      <SectionHeader eyebrow="Welcome Baskets" title="Something Waiting on Arrival" align="left">
        <p>Hand-packed with Tuscan flavours, ready in your suite or to take home.</p>
      </SectionHeader>
      <div class="baskets">
        <Reveal as="div" class="baskets__media hoist" delay={0.1}>
          <Image
            src={mockups.wineGift}
            alt="Villa Dolce Vita welcome basket with wine bottle and tasting notes"
            widths={[480, 768, 1100]}
            sizes="(max-width: 900px) 92vw, 38vw"
            loading="lazy"
          />
        </Reveal>
        <div class="baskets__table">
          <SpecTable rows={basketRows} />
          <div class="baskets__cta">
            <Button href="/contact" variant="ghost">Enquire to order</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE CELLAR / WINE LIST -->
  <section class="section bg-dark cellar">
    <div class="wrap">
      <div class="cellar__head">
        <div class="cellar__media hoist" data-reveal>
          <Image
            src={photos.wineCellar}
            alt="The estate wine cellar"
            widths={[560, 900, 1300]}
            sizes="(max-width: 900px) 92vw, 44vw"
            loading="lazy"
          />
        </div>
        <div class="cellar__copy">
          <Reveal as="p" class="eyebrow">The Cellar</Reveal>
          <Reveal as="h2" delay={0.05}>Three Countries, Five Decades</Reveal>
          <Reveal as="p" class="cellar__intro" delay={0.12}>{wineIntro}</Reveal>
        </div>
      </div>

      <div class="wine-list">
        {
          wineList.map((group) => (
            <div class="wine-group" data-reveal>
              <h3 class="wine-group__cat">{group.category}</h3>
              {group.origins.map((o) => (
                <div class="wine-origin">
                  <p class="wine-origin__name">{o.origin}</p>
                  <ul class="wine-rows">
                    {o.wines.map((w) => {
                      const parsed = parseWine(w);
                      return (
                        <li class="wine-row">
                          <span class="wine-row__name">{parsed.name}</span>
                          {parsed.detail && <span class="wine-row__detail">{parsed.detail}</span>}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <p class="cellar__notice">{notices.alcohol}</p>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    eyebrow="Reserve a Table"
    title="Dinner, With a View"
    sub="Private dinners are pre-booked for a minimum of four. Tell us when."
    ctaLabel="Enquire About Dinner"
    ctaHref={bookingHref}
    image={photos.terraceTableView}
    imageAlt="The loggia terrace set for dinner, the Tuscan valley beyond"
  />
</BaseLayout>

<style>
  /* ── Menu — hairline-topped courses ───────────────────────────────────── */
  .menu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .menu__course {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
  }
  .menu__course h3 {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    margin-bottom: 0.9rem;
  }
  .menu__course ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .menu__course li {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .menu__pricing {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .fineprint {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 1.25rem;
  }

  /* ── Baskets — image + spec table ─────────────────────────────────────── */
  .baskets {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .baskets :global(.baskets__media) {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--surface-sunk);
  }
  .baskets :global(.baskets__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .baskets__cta {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ── Cellar — ink, hairline wine list ─────────────────────────────────── */
  .cellar__head {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }
  .cellar__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .cellar__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cellar__copy :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .cellar__copy :global(h2) {
    max-width: 18ch;
  }
  .cellar :global(.cellar__intro) {
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    color: var(--text-on-dark-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  .wine-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem) clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .wine-group__cat {
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 2rem);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-on-dark);
    margin-bottom: 1.4rem;
  }
  .wine-origin + .wine-origin {
    margin-top: 1.6rem;
  }
  .wine-origin__name {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .wine-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wine-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line-on-dark);
  }
  .wine-row__name {
    color: var(--text-on-dark);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .wine-row__detail {
    flex: 0 0 auto;
    color: var(--text-on-dark-muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .cellar__notice {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-on-dark);
    color: var(--text-on-dark-muted);
    font-size: 0.82rem;
    line-height: 1.6;
    max-width: 70ch;
  }

  @media (max-width: 900px) {
    .menu,
    .baskets,
    .cellar__head,
    .wine-list {
      grid-template-columns: 1fr;
    }
    .baskets :global(.baskets__media) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
