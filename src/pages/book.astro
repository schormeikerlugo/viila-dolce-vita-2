---
/**
 * /book — the in-house booking wizard. Every "Check Availability" CTA across
 * the site flows here (see bookingHref in src/data/site.ts). Runs against
 * the live Supabase backend when the PUBLIC_SUPABASE_* env vars are set,
 * else the in-memory mock (offline dev).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BookApp from "../components/booking/BookApp.tsx";
import { getImage } from "astro:assets";
import { suites } from "../data/suites";
import { galleryItems } from "../data/gallery";
import type { SuiteCardData, SuiteSlug, ExteriorPhoto } from "../lib/booking/types";
import "../styles/booking.css";

// Resolve each suite's lead photo to an optimized URL — islands take plain
// strings, not ImageMetadata.
const suiteCards: SuiteCardData[] = await Promise.all(
  suites.map(async (s) => {
    const img = await getImage({ src: s.images[0], width: 900, format: "webp", quality: 78 });
    return {
      slug: s.slug as SuiteSlug,
      name: s.name,
      tagline: s.tagline,
      sleeps: s.sleeps,
      highlight: s.highlight,
      image: img.src,
      imageAlt: s.imageAlt,
      rank: s.rank,
    };
  }),
);

// Estate shots for the header mosaic (in display order). Slugs reference
// src/data/gallery.ts; resolved to optimized WebP here.
const EXTERIOR_SLUGS = [
  "villa-lavender-path",
  "villa-pool-day",
  "pool-terrace-above",
  "patio-sail-lounge",
  "living-room-well-table",
  "breakfast-terrace-pool",
  "villa-aerial-night",
];
const exterior: ExteriorPhoto[] = await Promise.all(
  EXTERIOR_SLUGS.map(async (slug) => {
    const item = galleryItems.find((g) => g.slug === slug);
    if (!item) throw new Error(`book.astro: missing gallery image "${slug}"`);
    const img = await getImage({ src: item.image, width: 900, format: "webp", quality: 78 });
    return { src: img.src, alt: item.alt };
  }),
);
---

<BaseLayout
  title="Book Your Stay"
  description="Choose your dates, your suite and the shape of the week — the concierge confirms personally."
>
  <section class="section bg-dark bookpage">
    <div class="wrap">
      <BookApp client:load suites={suiteCards} exterior={exterior} />
    </div>
  </section>
</BaseLayout>

<style>
  .bookpage {
    /* Just enough to clear the fixed nav — the text banner is gone, the
       Villa header now leads the page (less scrolling). */
    padding-top: clamp(6rem, 9vw, 8rem);
    min-height: 100vh;
  }
</style>
