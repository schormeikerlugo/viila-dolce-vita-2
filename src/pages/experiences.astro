---
/**
 * Experience — a stay made of particular things.
 * Six numbered, anchored sections following Docs/experience-page-copy.md:
 * #comfort · #cuisine · #wellness · #relaxation · #wildlife · #exploration
 * Tuscan Editorial language: hairlines, eyebrows, three-card trios,
 * image-led split sections, and a full-bleed closer.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SplitSection from "../components/SplitSection.astro";
import FeatureTrio from "../components/FeatureTrio.astro";
import CardCarousel from "../components/CardCarousel.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { Image } from "astro:assets";
import { bookingHref } from "../data/site";
import { photos, suitePhotos } from "../data/media";
import { galleryItems } from "../data/gallery";

/** Gallery lookup — fails loudly if a slug ever goes missing. */
const g = (slug: string) => {
  const item = galleryItems.find((i) => i.slug === slug);
  if (!item) throw new Error(`experiences: missing gallery slug "${slug}"`);
  return item;
};

// Hero: aperitivo for two under the arch as the sun goes down.
const heroImage = g("arch-aperitivo-couple");

const anchors = [
  { id: "comfort", label: "Comfort" },
  { id: "cuisine", label: "Cuisine" },
  { id: "wellness", label: "Wellness" },
  { id: "relaxation", label: "Relaxation" },
  { id: "wildlife", label: "Wildlife" },
  { id: "exploration", label: "Exploration" },
];

// 01 · Comfort — five rooms that know what they are for.
const comfortSlides = [
  { image: suitePhotos.roma[0], alt: "The Roma suite, renovated and dressed in fine linens", caption: "The Suites" },
  { image: g("living-room-suite").image, alt: g("living-room-suite").alt, caption: "The Living Rooms" },
  { image: g("marble-bathroom").image, alt: g("marble-bathroom").alt, caption: "Marble Bathrooms" },
  { image: g("kitchen-dining-interior").image, alt: g("kitchen-dining-interior").alt, caption: "Fitted Kitchens" },
  { image: g("patio-sail-lounge").image, alt: g("patio-sail-lounge").alt, caption: "Private Patios" },
];

// 02 · Cuisine — the table is the centre of the day.
const cuisineItems = [
  {
    image: g("breakfast-terrace-pool").image,
    alt: g("breakfast-terrace-pool").alt,
    title: "Breakfast",
    copy: "Laid out each morning and taken outside before the heat arrives. Coffee, bread, fruit, and honey from our own trees.",
  },
  {
    image: g("chef-plating-kitchen").image,
    alt: g("chef-plating-kitchen").alt,
    title: "In-House Chef",
    copy: "Three chef-cooked dinners a week come with the stay, served under the canopy or beneath the arch as the sun goes down behind the islands. Private dinners arranged on request.",
  },
  {
    image: g("grocery-delivery-dusk").image,
    alt: g("grocery-delivery-dusk").alt,
    title: "Food & Grocery Delivery",
    copy: "A full shop delivered before you arrive, welcome baskets, and prepared dishes brought up ready to serve.",
  },
];

// 03 · Wellness — heat, air and open sky.
const wellnessItems = [
  {
    image: g("gym-deck-sails").image,
    alt: g("gym-deck-sails").alt,
    title: "The Outdoor Gym",
    copy: "A training deck in the open air under sail canopies, with nothing at all between you and the valley. For those who prefer their stillness earned.",
  },
  {
    image: g("yoga-platform-sails").image,
    alt: g("yoga-platform-sails").alt,
    title: "The Yoga Platform",
    copy: "Level, shaded, facing the hills, which is the whole of its design. A private instructor can be arranged for the morning.",
  },
  {
    image: g("barrel-sauna-trees").image,
    alt: g("barrel-sauna-trees").alt,
    title: "The Barrel Sauna",
    copy: "Handcrafted, seating four, turned to face the olive groves. Best late, when the only light on the hill is whatever the sky is providing.",
  },
];

// 04 · Relaxation — the pool in the quiet of the hilltop gardens.
const relaxationImage = g("pool-terrace-above");

// 05 · Wildlife — the estate has other residents.
const wildlifeImage = g("roe-deer-lavender");
const wildlifeStrip = [g("hoopoe-meadow"), g("pines-valley-deer")];

// 06 · Exploration — small strip echoing the wildlife one: the road out and the towns.
const explorationStrip = [g("car-hillside-road"), g("hilltown-aerial-fortress")];

// Closer: the villa, pool and gardens from above.
const closerImage = g("villa-aerial-day");
---

<BaseLayout
  title="Experience"
  description="Breakfast before the heat, an in-house chef, a sauna facing the olive groves, a pool with the valley in one direction and the sea in the other — a stay made of small, specific pleasures, arranged by a concierge who lives on the hill."
>
  <PageHero
    eyebrow="The Experience"
    title="A Stay Made of Particular Things"
    subtitle="Breakfast laid out while the valley is still cool. An hour in the sauna with the olive groves in front of you. A car waiting at Pisa. The days here are built from small, specific pleasures, and every one of them is arranged by a concierge who lives on this hill. Tell us how the week should feel. The rest is ours to handle."
    image={heroImage.image}
    imageAlt={heroImage.alt}
    meta={[
      { label: "Suites", value: "5" },
      { label: "Bedrooms", value: "7" },
      { label: "Estate", value: "50 Acres" },
    ]}
  />

  <!-- ANCHOR NAV -->
  <section class="bg-ivory exp-index">
    <nav class="anchor-nav wrap" aria-label="Jump to section">
      {
        anchors.map((a, i) => (
          <a href={`#${a.id}`}>
            <span class="anchor-nav__num">{String(i + 1).padStart(2, "0")}</span>
            {a.label}
          </a>
        ))
      }
    </nav>
  </section>

  <!-- 01 · COMFORT -->
  <section id="comfort" class="section bg-ivory">
    <div class="wrap">
      <SectionHeader
        eyebrow="Comfort"
        title="Rooms That Know What They Are For"
        align="left"
      >
        <p>
          Five suites across two stone houses, seven bedrooms between them, no
          two quite alike. Marble bathrooms with heated floors underfoot. New
          beds dressed in fine linens. Kitchens fitted properly rather than
          symbolically, and art on the walls chosen deliberately and to last.
        </p>
        <p>
          Each suite opens onto its own patio or balcony, so the view is never
          something you have to go and find. You will arrive to a handwritten
          note, your key on the table, and honey and olives from the farm.
        </p>
      </SectionHeader>

      <CardCarousel label="The suites and their comforts">
        {
          comfortSlides.map((s) => (
            <figure class="comfort carousel__slide" data-reveal>
              <div class="comfort__media hoist">
                <Image
                  src={s.image}
                  alt={s.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 900px) 80vw, 30vw"
                  loading="lazy"
                />
              </div>
              <figcaption class="comfort__caption">{s.caption}</figcaption>
            </figure>
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <!-- 02 · CUISINE -->
  <FeatureTrio
    id="cuisine"
    eyebrow="Cuisine"
    title="The Table Is the Centre of the Day"
    theme="stone"
    items={cuisineItems}
    footnote="Dinner runs long here. It always has."
  />

  <!-- 03 · WELLNESS -->
  <FeatureTrio
    id="wellness"
    eyebrow="Wellness"
    title="Heat, Air and Open Sky"
    items={wellnessItems}
  />

  <!-- 04 · RELAXATION -->
  <SplitSection
    id="relaxation"
    eyebrow="Relaxation"
    title="The Long Afternoon"
    image={relaxationImage.image}
    imageAlt={relaxationImage.alt}
    theme="stone"
  >
    <p>
      The pool rests in the quiet of the hilltop gardens, on a terrace that
      gives you the valley in one direction and the sea in the other. Mornings
      there are cool and entirely yours.
    </p>
    <p>
      Massage can be arranged in the house, with a therapist working in your
      suite or outside on the terrace. A day's notice is usually enough.
    </p>
    <p class="closing-line">Afternoons here are not scheduled. They are allowed.</p>
  </SplitSection>

  <!-- 05 · WILDLIFE -->
  <SplitSection
    id="wildlife"
    eyebrow="Wildlife"
    title="The Estate Has Other Residents"
    image={wildlifeImage.image}
    imageAlt={wildlifeImage.alt}
    theme="dark"
    reverse
  >
    <p>
      Fifty acres of olive grove, pine and forest, with no street lights and no
      road running through it. Roe deer come to the lavender at dusk. A fox
      crosses the track most weeks, always with somewhere to be.
    </p>
    <p>
      It is quietly excellent country for birds. Hoopoes work the meadow grass
      in spring, buzzards ride the thermals over the valley, and the terrace at
      first light is as good a hide as you could ask for.
    </p>
    <p>
      There are also three rescued dogs and seven cats who consider the estate
      theirs and have never been asked to prove it.
    </p>
    <div class="wildstrip" role="presentation">
      {
        wildlifeStrip.map((w) => (
          <div class="wildstrip__img">
            <Image
              src={w.image}
              alt={w.alt}
              widths={[320, 480, 640]}
              sizes="(max-width: 900px) 45vw, 16vw"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </SplitSection>

  <!-- 06 · EXPLORATION -->
  <SplitSection
    id="exploration"
    eyebrow="Exploration"
    title="Everything Is Closer Than It Looks"
    image={photos.massaMarittima}
    imageAlt="Massa Marittima's medieval cathedral and piazza, fifteen minutes down the hill"
  >
    <p>
      Massa Marittima is fifteen minutes down the hill: cobbled streets, a
      thousand-year-old cathedral, coffee in the piazza. The coast is forty
      minutes, and empties out by evening.
    </p>
    <p>
      Beyond that, a car and a driver can be arranged for as long as you need
      one. Transfers from Rome, Florence and Pisa, and days out put together
      with someone who knows the roads: the vineyards from Montalcino to
      Bolgheri, the hot springs, horseback riding on the Maremma plains where
      the butteri still work cattle much as they always have.
    </p>
    <p class="closing-line">Go out for the day. The hill will be here when you get back.</p>
    <div class="wildstrip" role="presentation">
      {
        explorationStrip.map((e) => (
          <div class="wildstrip__img">
            <Image
              src={e.image}
              alt={e.alt}
              widths={[320, 480, 640]}
              sizes="(max-width: 900px) 45vw, 16vw"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </SplitSection>

  <!-- CLOSER -->
  <CtaBanner
    eyebrow="Plan Your Stay"
    title="Tell Us How the Days Should Look"
    sub="Send your dates and the shape of the week you have in mind. We will do the arranging."
    ctaLabel="Check Availability"
    ctaHref={bookingHref}
    image={closerImage.image}
    imageAlt={closerImage.alt}
  />
</BaseLayout>

<style>
  /* ── Anchor index — hairline strip under the hero ─────────────────────── */
  .exp-index {
    padding-block: 0 clamp(1.5rem, 3vw, 2.5rem);
  }
  .anchor-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(1.5rem, 3vw, 3rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 1.1rem;
  }
  .anchor-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .anchor-nav a:hover {
    color: var(--accent);
  }
  .anchor-nav__num {
    font-size: 0.62rem;
    color: var(--accent);
    letter-spacing: 0;
  }

  /* ── Comfort — image-led carousel slides with small-caps captions ─────── */
  .comfort {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .comfort__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-sunk);
    margin-bottom: 1rem;
  }
  .comfort__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comfort__caption {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Closing lines — the italic display voice inside split copy ───────── */
  .closing-line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    margin-top: 0.4rem;
  }

  /* ── Wildlife — small two-up strip under the dark split copy ──────────── */
  .wildstrip {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.6rem, 1.4vw, 1rem);
  }
  .wildstrip__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .wildstrip__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Exploration — the cathedral image matches the copy column's height ── */
  @media (min-width: 901px) {
    :global(#exploration .split__inner) {
      align-items: stretch;
    }
    :global(#exploration .split__media) {
      position: relative;
    }
    :global(#exploration .split__img) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
  }
</style>
