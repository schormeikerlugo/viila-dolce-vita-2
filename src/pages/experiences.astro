---
/**
 * Experiences — one page, five anchored sections:
 * #day-trips · #wellness-area · #animal-sanctuary · #workshops
 * (content.md consolidated five former pages into this one.)
 * Tuscan Editorial reskin: hairline hierarchy, spec tables, image-led carousel.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SpecTable from "../components/SpecTable.astro";
import AreaMap from "../components/AreaMap.astro";
import CardCarousel from "../components/CardCarousel.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { Image } from "astro:assets";
import { photos } from "../data/media";
import {
  dayTrips,
  selfGuided,
  transfers,
  privateTours,
  wellness,
  sanctuaryNotes,
  workshops,
} from "../data/experiences";

const anchors = [
  { id: "day-trips", label: "Day Trips & Tours" },
  { id: "wellness-area", label: "Wellness Area" },
  { id: "animal-sanctuary", label: "Animal Sanctuary" },
  { id: "workshops", label: "Private Workshops" },
];

// Chauffeured transfers → spec rows (route + price).
const transferRows = transfers.map((t) => ({
  title: t.route,
  specs: [{ label: "Price", value: t.price }],
}));

// Private luxury tours → spec rows (duration / price / inclusions).
const tourRows = privateTours.map((t) => ({
  title: t.title,
  specs: [
    { label: "Duration", value: t.duration },
    { label: "Price", value: t.price },
    { label: "Includes", value: t.items.join(" · ") },
  ],
}));
---

<BaseLayout
  title="Experiences"
  description="Vineyards you can walk to, horses that know the trails, a coastline to charter into, wellness on the hilltop, and a sanctuary of rescued animals — everything within reach of the villa."
>
  <PageHero
    eyebrow="Experiences"
    title="Everything Here Is Optional"
    subtitle="Everything below is optional. Nobody at Villa Dolce Vita is going to hand you an itinerary. But if you want more than a pool and a view, here's what's within reach: vineyards you can walk to, horses that know the trails better than any guide, a coastline you can charter a boat into, and a sanctuary full of animals who were not always this lucky."
    image={photos.butteriRider}
    imageAlt="A butteri rider through the olive groves of Maremma"
    meta={[
      { label: "Day Trips", value: String(dayTrips.length) },
      { label: "Wellness", value: `${wellness.length} Areas` },
      { label: "Workshops", value: `${workshops.length} Groups` },
    ]}
  />

  <!-- ANCHOR NAV -->
  <section class="bg-ivory exp-index">
    <nav class="anchor-nav wrap" aria-label="Jump to section">
      {
        anchors.map((a, i) => (
          <a href={`#${a.id}`}>
            <span class="anchor-nav__num">{String(i + 1).padStart(2, "0")}</span>
            {a.label}
          </a>
        ))
      }
    </nav>
  </section>

  <!-- DAY TRIPS -->
  <section id="day-trips" class="section bg-ivory">
    <div class="wrap">
      <SectionHeader
        eyebrow="Day Trips & Tours"
        title="Reachable, Most of It, in Under an Hour"
        align="left"
      >
        <p>
          Whether you prefer structured excursions or the freedom to explore at your own pace,
          everything here is reachable from the villa.
        </p>
      </SectionHeader>

      <CardCarousel label="Day trips and tours">
        {
          dayTrips.map((d) => (
            <article class="daytrip carousel__slide" data-reveal>
              {d.image && (
                <div class="daytrip__media hoist">
                  <Image
                    src={d.image}
                    alt={d.title}
                    widths={[400, 640, 900]}
                    sizes="(max-width: 900px) 80vw, 30vw"
                    loading="lazy"
                  />
                </div>
              )}
              <h3 class="daytrip__title">{d.title}</h3>
              <p class="daytrip__copy">{d.copy}</p>
            </article>
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <!-- SELF-GUIDED CITY GUIDES -->
  <section class="section bg-sunk">
    <div class="wrap">
      <SectionHeader eyebrow="Self-Guided Adventures" title="If You Have a Car, Point It Here" align="left" />
      <div class="cities">
        {
          selfGuided.map((c) => (
            <article class="city" data-reveal>
              <h3 class="city__name">{c.city}</h3>
              <div class="city__cols">
                <div class="city__col">
                  <p class="city__label">What to visit</p>
                  <ul>{c.visit.map((v) => <li>{v}</li>)}</ul>
                </div>
                <div class="city__col">
                  <p class="city__label">Architecture</p>
                  <ul>{c.architecture.map((v) => <li>{v}</li>)}</ul>
                </div>
                <div class="city__col">
                  <p class="city__label">Eat & drink</p>
                  <ul>{c.eat.map((v) => <li>{v}</li>)}</ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TRANSFERS -->
  <section class="section bg-ivory">
    <div class="wrap">
      <SectionHeader eyebrow="Chauffeured Transfers" title="Move Easily, with Comfort" align="left" />
      <div class="transfers-map">
        <AreaMap />
      </div>
      <SpecTable rows={transferRows} />
      <p class="fineprint">
        A Maserati upgrade is available on the same routes (2 passengers plus driver).
      </p>

      <div class="divider" role="presentation"></div>

      <!-- PRIVATE LUXURY TOURS -->
      <SectionHeader eyebrow="Private Luxury Tours" title="Curated, Chauffeured, for Two" align="left" />
      <SpecTable rows={tourRows} />
    </div>
  </section>

  <!-- WELLNESS -->
  <section id="wellness-area" class="section bg-ivory">
    <div class="wrap">
      <SectionHeader eyebrow="Wellness Area" title="Relax. Recharge. Rejuvenate." align="left">
        <p>
          Perched on a mountainside overlooking the valley and the sea, looking out toward Elba,
          Montecristo, and, on the clearest days, Corsica.
        </p>
      </SectionHeader>
      <div class="wellness-grid">
        {
          wellness.map((w, i) => (
            <article class="wellness" data-reveal>
              <p class="wellness__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="wellness__title">
                {w.title}
                {w.soon && <span class="wellness__soon">Coming 2026</span>}
              </h3>
              <p class="wellness__copy">{w.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ANIMAL SANCTUARY -->
  <section id="animal-sanctuary" class="section sanctuary">
    <div class="sanctuary__media">
      <Image
        src={photos.butteriFoal}
        alt="A rescued foal in the estate pasture"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="lazy"
      />
      <div class="sanctuary__scrim" aria-hidden="true"></div>
    </div>
    <div class="sanctuary__content wrap">
      <Reveal as="p" class="eyebrow eyebrow--gold">Animal Sanctuary</Reveal>
      <Reveal as="h2" delay={0.05}>The True Dolce Vita Awaits</Reveal>
      <Reveal delay={0.12}>
        <p class="sanctuary__body">
          Part of the estate is dedicated to a small animal sanctuary, where we care for rescued
          animals who now enjoy the peace and freedom of the Tuscan countryside. They are gentle,
          friendly, and very much part of the soul of the villa. Many have come from difficult
          pasts, and Villa Dolce Vita has become their forever home.
        </p>
      </Reveal>
      <Reveal delay={0.15}>
        <ul class="sanctuary__notes">
          {sanctuaryNotes.map((n) => <li>{n}</li>)}
        </ul>
      </Reveal>
      <Reveal delay={0.18}>
        <p class="sanctuary__body">
          By staying at Villa Dolce Vita, you help support their care and give them the peaceful
          life they deserve.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- PRIVATE WORKSHOPS -->
  <section id="workshops" class="section bg-sunk">
    <div class="wrap">
      <SectionHeader
        eyebrow="Private Workshops"
        title="Leave with a New Skill, Not Just a Suntan"
        align="left"
      >
        <p>
          A number of guests use the villa as a private base for hands-on experiences. If you're
          planning a small-group retreat or a milestone celebration, here's what we can build
          around your stay.
        </p>
      </SectionHeader>
      <div class="workshops-grid">
        {
          workshops.map((g) => (
            <article class="workshop" data-reveal>
              <h3 class="workshop__title">{g.title}</h3>
              <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
            </article>
          ))
        }
      </div>
      <div class="workshops-cta">
        <Button href="/contact" variant="ghost">Plan your experience</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Anchor index — hairline strip under the hero ─────────────────────── */
  .exp-index {
    padding-block: 0 clamp(1.5rem, 3vw, 2.5rem);
  }
  .anchor-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(1.5rem, 3vw, 3rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 1.1rem;
  }
  .anchor-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .anchor-nav a:hover {
    color: var(--accent);
  }
  .anchor-nav__num {
    font-size: 0.62rem;
    color: var(--accent);
    letter-spacing: 0;
  }

  /* ── Day trips — image-led carousel slides ────────────────────────────── */
  .daytrip {
    display: flex;
    flex-direction: column;
  }
  .daytrip__media {
    aspect-ratio: 4 / 5;
    background: var(--surface-sunk);
    margin-bottom: 1.2rem;
  }
  .daytrip__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .daytrip__title {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    margin-bottom: 0.6rem;
  }
  .daytrip__copy {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  /* ── Cities — hairline editorial columns ──────────────────────────────── */
  .cities {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .city {
    border-top: 1px solid var(--line);
    padding-top: clamp(1.4rem, 2.5vw, 2rem);
  }
  .city__name {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
  }
  .city__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .city__col {
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }
  .city__label {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.7rem;
  }
  .city__cols ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  .city__cols li {
    color: var(--text);
    font-size: 0.92rem;
  }

  /* ── Transfers + tours fineprint ──────────────────────────────────────── */
  .transfers-map {
    max-width: 56rem;
    margin-bottom: var(--space-group);
  }
  .fineprint {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 1.25rem;
  }

  /* ── Wellness — hairline grid ─────────────────────────────────────────── */
  .wellness-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .wellness {
    background: var(--bg);
    padding: clamp(1.8rem, 3vw, 2.6rem);
  }
  .wellness__num {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    color: var(--text-muted);
    margin-bottom: 1.1rem;
  }
  .wellness__title {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    margin-bottom: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .wellness__soon {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .wellness__copy {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* ── Sanctuary — full-bleed ink ───────────────────────────────────────── */
  .sanctuary {
    position: relative;
    color: var(--text-on-dark);
    display: flex;
    align-items: center;
    min-height: 80svh;
    overflow: hidden;
  }
  .sanctuary__media {
    position: absolute;
    inset: 0;
  }
  .sanctuary__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sanctuary__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(22, 20, 18, 0.85) 0%,
      rgba(22, 20, 18, 0.55) 60%,
      rgba(22, 20, 18, 0.25) 100%
    );
  }
  .sanctuary__content {
    position: relative;
    z-index: 2;
    max-width: 46rem;
  }
  .sanctuary__content :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .sanctuary__content :global(h2) {
    max-width: 18ch;
    margin-bottom: clamp(1.2rem, 2.5vw, 1.8rem);
  }
  .sanctuary__body {
    color: var(--text-on-dark-muted);
    line-height: 1.75;
  }
  .sanctuary__notes {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0;
    display: grid;
  }
  .sanctuary__notes li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--line-on-dark);
    color: var(--text-on-dark);
    font-size: 0.95rem;
  }
  .sanctuary__notes li:last-child {
    border-bottom: 1px solid var(--line-on-dark);
  }

  /* ── Workshops — hairline-topped columns ──────────────────────────────── */
  .workshops-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .workshop {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
  }
  .workshop__title {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    margin-bottom: 1rem;
  }
  .workshop ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .workshop li {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .workshops-cta {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 1080px) {
    .wellness-grid,
    .workshops-grid,
    .city__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .wellness-grid,
    .workshops-grid,
    .city__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
