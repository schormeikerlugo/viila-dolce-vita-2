---
/**
 * Contact — direct contact channels, the alcohol disclaimer, the note about
 * the sanctuary animals, and the full FAQ. All copy from content.md / site.ts.
 * Tuscan Editorial: Tonelli split — channel meta rows with hairlines on the
 * left, the image + booking CTA on the right, FAQ on ink to close.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import RealMap from "../components/RealMap.astro";
import { Image } from "astro:assets";
import { photos } from "../data/media";
import { contact, notices, bookingHref } from "../data/site";
import { faqs } from "../data/faq";
import { faqSchema } from "../lib/schema";

const channels = [
  {
    label: "WhatsApp",
    value: contact.whatsapp,
    href: contact.whatsappHref,
    note: "Fastest reply — our concierge is on hand throughout the day.",
  },
  {
    label: "Email",
    value: contact.email,
    href: `mailto:${contact.email}`,
    note: "For enquiries, quotes, and anything that needs detail.",
  },
  {
    label: "Address",
    value: contact.address,
    href: "https://maps.google.com/?q=SP441+56+58024+Massa+Marittima+GR+Italy",
    note: "Fifteen minutes from Massa Marittima, Tuscany.",
  },
  {
    label: "Instagram",
    value: contact.instagramHandle,
    href: contact.instagram,
    note: "Daily life at the estate — animals included.",
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Get in touch by WhatsApp, email or Instagram. Villa Dolce Vita, SP441, Massa Marittima, Tuscany."
  schemas={[faqSchema(faqs)]}
>
  <!-- SPLIT — channels left, image + CTA right -->
  <section class="chero" aria-label="Contact channels">
    <div class="wrap chero__grid">
      <div class="chero__content">
        <p class="slash-label chero__label">Contact Us</p>
        <h1 class="chero__title">Don't Hesitate to Get in Touch</h1>
        <p class="chero__intro">
          Two people actually live here — you'll be talking to us, not a call
          centre.
        </p>

        <ul class="channels">
          {
            channels.map((c, i) => (
              <li data-reveal data-reveal-delay={Math.min(i * 0.05, 0.2)}>
                <a class="channel" href={c.href} target="_blank" rel="noopener">
                  <span class="channel__label">{c.label}</span>
                  <span class="channel__main">
                    <span class="channel__value">{c.value}</span>
                    <span class="channel__note">{c.note}</span>
                  </span>
                  <span class="channel__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="chero__side">
        <div class="chero__media hoist" data-reveal>
          <Image
            src={photos.contactValleyDusk}
            alt="Dusk settling over the estate valley"
            widths={[640, 960, 1280, 1920]}
            sizes="(max-width: 900px) 100vw, 42vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <Reveal class="chero__cta" delay={0.1}>
          <Button href={bookingHref} variant="primary">Check Availability</Button>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ENQUIRY FORM — composes a WhatsApp / email message client-side -->
  <section id="enquiry" class="section bg-ivory enquiry" aria-labelledby="enquiry-title">
    <div class="wrap enquiry__grid">
      <div class="enquiry__head">
        <Reveal as="p" class="eyebrow">Send an Enquiry</Reveal>
        <h2 id="enquiry-title" data-split>Tell Us About<br />Your Stay</h2>
        <Reveal as="p" class="enquiry__note" delay={0.08}>
          Fill in the details and send it our way — we reply personally, by
          WhatsApp or email, usually within the hour.
        </Reveal>
      </div>

      <form class="eform" id="enquiry-form" novalidate data-reveal data-reveal-delay={0.1}>
        <div class="eform__row">
          <div class="eform__field">
            <label for="ef-name">Name *</label>
            <input type="text" id="ef-name" name="name" required autocomplete="name" />
            <p class="eform__error" data-error-for="ef-name">Please tell us your name.</p>
          </div>
          <div class="eform__field">
            <label for="ef-email">Email *</label>
            <input type="email" id="ef-email" name="email" required autocomplete="email" />
            <p class="eform__error" data-error-for="ef-email">Please enter a valid email address.</p>
          </div>
        </div>

        <div class="eform__row eform__row--three">
          <div class="eform__field">
            <label for="ef-arrive">Arrival</label>
            <input type="date" id="ef-arrive" name="arrive" />
          </div>
          <div class="eform__field">
            <label for="ef-depart">Departure</label>
            <input type="date" id="ef-depart" name="depart" />
          </div>
          <div class="eform__field">
            <label for="ef-guests">Guests</label>
            <select id="ef-guests" name="guests">
              {Array.from({ length: 15 }, (_, i) => i + 1).map((n) => (
                <option value={n} selected={n === 2}>{n}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="eform__field">
          <label for="ef-message">Message *</label>
          <textarea
            id="ef-message"
            name="message"
            rows="5"
            required
            placeholder="Tell us about your trip — occasion, party, questions…"></textarea>
          <p class="eform__error" data-error-for="ef-message">Please write a short message.</p>
        </div>

        <div class="eform__actions">
          <Button type="submit" variant="primary" data-send="whatsapp">
            Send via WhatsApp
          </Button>
          <Button type="submit" variant="secondary" data-send="email">
            Send via Email
          </Button>
        </div>
        <p class="eform__success" data-success hidden aria-live="polite">
          Your message is ready in the app that just opened — press send there
          and we'll take it from here. Grazie!
        </p>
      </form>
    </div>
  </section>

  <!-- NOTICES — hairline columns -->
  <section class="section bg-sunk" aria-label="Guest notices">
    <div class="wrap notices">
      <article class="notice" data-reveal>
        <p class="eyebrow">Alcohol Disclaimer</p>
        <p class="notice__body">{notices.alcohol}</p>
      </article>
      <article class="notice" data-reveal data-reveal-delay={0.08}>
        <p class="eyebrow">A Note for Our Guests</p>
        <p class="notice__body">{notices.animals}</p>
      </article>
    </div>
  </section>

  <!-- FINDING US — stylised area map -->
  <section class="section bg-dark findus" aria-labelledby="findus-title">
    <div class="wrap findus__grid">
      <div class="findus__head">
        <Reveal as="p" class="eyebrow">Finding Us</Reveal>
        <h2 id="findus-title" data-split>Our Corner of<br />the Maremma</h2>
        <Reveal as="p" class="findus__note" delay={0.08}>
          Fifteen minutes from Massa Marittima, forty from the coast, and far
          enough from everything else. Chauffeured transfers can be arranged
          from Rome, Florence and Pisa.
        </Reveal>
        <Reveal delay={0.12}>
          <Button
            href="https://maps.google.com/?q=SP441+56+58024+Massa+Marittima+GR+Italy"
            variant="ghost"
            target="_blank"
            rel="noopener"
          >
            Open in Google Maps
          </Button>
        </Reveal>
      </div>
      <RealMap />
    </div>
  </section>

  <!-- FAQ — ink accordion -->
  <section class="section bg-dark faq-section" aria-labelledby="faq-title">
    <div class="wrap faq-section__grid">
      <div class="faq-section__head">
        <Reveal as="p" class="eyebrow">FAQ</Reveal>
        <h2 id="faq-title" data-reveal data-reveal-delay={0.05}>
          Your Questions<br />Answered
        </h2>
        <p class="faq-section__note" data-reveal data-reveal-delay={0.1}>
          Have more unanswered questions? Feel free to send an enquiry to
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>
      <FaqAccordion items={faqs} />
    </div>
  </section>
</BaseLayout>

<script>
  import { contact } from "../data/site";

  // Enquiry form — validates, composes the message, and hands it to the
  // guest's own WhatsApp or email app. No backend, nothing stored.
  function initEnquiry() {
    const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const success = form.querySelector<HTMLElement>("[data-success]");
    const field = (id: string) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`#${id}`);

    const markValidity = (id: string, ok: boolean) => {
      field(id)?.closest(".eform__field")?.classList.toggle("is-invalid", !ok);
      return ok;
    };

    const fmt = (v: string) =>
      v
        ? new Date(`${v}T12:00:00`).toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        : "";

    const compose = () => {
      const name = field("ef-name")?.value.trim() ?? "";
      const email = field("ef-email")?.value.trim() ?? "";
      const arrive = fmt(field("ef-arrive")?.value ?? "");
      const depart = fmt(field("ef-depart")?.value ?? "");
      const guests = field("ef-guests")?.value ?? "";
      const message = field("ef-message")?.value.trim() ?? "";

      const lines = [
        `Hello Villa Dolce Vita! My name is ${name}.`,
        arrive && depart ? `Dates: ${arrive} — ${depart}, ${guests} guests.` : "",
        message,
        `You can also reach me at ${email}.`,
      ].filter(Boolean);
      return { name, email, message, text: lines.join("\n\n") };
    };

    const validate = () => {
      const name = (field("ef-name")?.value.trim().length ?? 0) > 0;
      const emailEl = field("ef-email") as HTMLInputElement | null;
      const email = !!emailEl && emailEl.validity.valid && emailEl.value.trim().length > 0;
      const message = (field("ef-message")?.value.trim().length ?? 0) > 0;
      markValidity("ef-name", name);
      markValidity("ef-email", email);
      markValidity("ef-message", message);
      return name && email && message;
    };

    let channel: "whatsapp" | "email" = "whatsapp";
    form.querySelectorAll<HTMLButtonElement>("[data-send]").forEach((btn) => {
      btn.addEventListener("click", () => {
        channel = (btn.dataset.send as typeof channel) ?? "whatsapp";
      });
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!validate()) {
        (form.querySelector(
          ".is-invalid input, .is-invalid textarea",
        ) as HTMLElement | null)?.focus();
        return;
      }
      const { text } = compose();
      const href =
        channel === "email"
          ? `mailto:${contact.email}?subject=${encodeURIComponent(
              "Enquiry — Villa Dolce Vita",
            )}&body=${encodeURIComponent(text)}`
          : `${contact.whatsappHref}?text=${encodeURIComponent(text)}`;
      window.open(href, "_blank", "noopener");
      if (success) success.hidden = false;
    });

    // Clear the error as soon as the guest fixes a field.
    ["ef-name", "ef-email", "ef-message"].forEach((id) => {
      field(id)?.addEventListener("input", () => markValidity(id, true));
    });
  }

  document.addEventListener("astro:page-load", initEnquiry);
  if (document.readyState !== "loading") initEnquiry();
  else document.addEventListener("DOMContentLoaded", initEnquiry);
</script>

<style>
  /* ── Split hero — Tonelli ─────────────────────────────────────────────── */
  .chero {
    padding-top: clamp(6rem, 10vw, 8.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--bg);
    color: var(--text);
  }
  .chero__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .chero__label {
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }
  .chero__title {
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.2rem);
    max-width: 14ch;
  }
  .chero__intro {
    margin-top: clamp(1.2rem, 2.5vw, 2rem);
    max-width: 46ch;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.08rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Channel rows — meta rows with 1px filetes */
  .channels {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .channels li {
    border-bottom: 1px solid var(--line);
  }
  .channel {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) 1fr auto;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding: clamp(1.3rem, 2.5vw, 1.9rem) 0.25rem;
    color: var(--text);
  }
  .channel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .channel__label {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .channel__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .channel__value {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.5rem);
    line-height: 1.25;
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
    overflow-wrap: anywhere;
  }
  .channel:hover .channel__value {
    color: var(--accent);
  }
  .channel__note {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .channel__arrow {
    font-size: 0.85rem;
    color: var(--text-muted);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .channel:hover .channel__arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  /* Right side — image + booking CTA */
  .chero__side {
    display: flex;
    flex-direction: column;
  }
  .chero__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--surface-sunk);
  }
  .chero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .chero__side :global(.chero__cta) {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* ── Enquiry form ─────────────────────────────────────────────────────── */
  .enquiry__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) 1.4fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  .enquiry__head {
    position: sticky;
    top: clamp(6rem, 12vh, 8rem);
  }
  .enquiry__head :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .enquiry :global(.enquiry__note) {
    margin-top: clamp(1.2rem, 2.5vw, 2rem);
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 38ch;
  }
  .eform {
    display: flex;
    flex-direction: column;
    gap: clamp(1.4rem, 2.5vw, 2rem);
  }
  .eform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.4rem, 2.5vw, 2rem);
  }
  .eform__row--three {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .eform__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .eform__field label {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .eform__field input,
  .eform__field select,
  .eform__field textarea {
    appearance: none;
    -webkit-appearance: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.85rem 1rem;
    width: 100%;
    transition: border-color var(--dur-fast) var(--ease-out);
    color-scheme: dark;
  }
  .eform__field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .eform__field input:focus,
  .eform__field select:focus,
  .eform__field textarea:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  .eform__field.is-invalid input,
  .eform__field.is-invalid textarea {
    border-color: var(--accent);
  }
  .eform__error {
    display: none;
    font-size: 0.78rem;
    color: var(--accent);
  }
  .eform__field.is-invalid .eform__error {
    display: block;
  }
  .eform__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .eform__success {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text);
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    max-width: 52ch;
  }

  /* ── Notices ──────────────────────────────────────────────────────────── */
  .notices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .notice {
    border-top: 1px solid var(--line);
    padding-top: clamp(1.2rem, 2.5vw, 1.8rem);
  }
  .notice__body {
    color: var(--text-muted);
    margin-top: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.75;
    max-width: 58ch;
  }

  /* ── Finding us — map split ───────────────────────────────────────────── */
  .findus__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) 1.4fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  .findus__head :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .findus :global(.findus__note) {
    margin-top: clamp(1.2rem, 2.5vw, 2rem);
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 38ch;
  }
  @media (max-width: 900px) {
    .findus__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ── FAQ on ink ───────────────────────────────────────────────────────── */
  .faq-section__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) 1.4fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  .faq-section__head {
    position: sticky;
    top: clamp(6rem, 12vh, 8rem);
  }
  .faq-section__head :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .faq-section__note {
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 34ch;
  }
  .faq-section__note a {
    color: var(--text-on-dark);
    border-bottom: 1px solid var(--line-on-dark);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .faq-section__note a:hover {
    border-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel__value,
    .channel__arrow,
    .faq-section__note a {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .chero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .chero__media {
      aspect-ratio: 16 / 10;
    }
    .faq-section__grid,
    .enquiry__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .faq-section__head,
    .enquiry__head {
      position: static;
    }
    .eform__row--three {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .eform__row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .channel {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1.25rem;
    }
    .channel__label {
      grid-column: 1 / -1;
    }
  }
</style>
