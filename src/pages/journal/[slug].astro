---
/**
 * Journal article — static route generated per slug from journal.ts.
 * Tuscan Editorial: a full-bleed cover hero, a sticky "On this page" rail,
 * a centered ~72ch body split into anchored sections (each with an optional
 * inset image), a closing FAQ, a tag list, and hairline "Keep Reading" rows.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import Button from "../../components/Button.astro";
import Reveal from "../../components/Reveal.astro";
import { Image } from "astro:assets";
import { journal } from "../../data/journal";
import { articleSchema, faqSchema } from "../../lib/schema";

export function getStaticPaths() {
  return journal.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Related: the other articles.
const related = journal.filter((a) => a.slug !== article.slug);

// Table-of-contents entries derived from the section headings.
const tocItems = article.sections.map((s) => ({ slug: s.slug, heading: s.heading }));

// Estimated reading time (200 wpm) from the whole body + FAQ.
const words = [
  article.excerpt,
  ...article.sections.flatMap((s) => s.body),
  ...article.faqs.flatMap((f) => [f.q, f.a]),
]
  .join(" ")
  .split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(words / 200));
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  ogImage={article.image}
  schemas={[articleSchema({ ...article, readMinutes }), faqSchema(article.faqs)]}
>
  <ArticleHero
    category={article.category}
    title={article.title}
    excerpt={article.excerpt}
    author={article.author}
    date={article.date}
    readMinutes={readMinutes}
    image={article.image}
    imageAlt={article.imageAlt}
    mediaTransitionName={`journal-${article.slug}`}
  />

  {/* Reading progress — a hairline of accent that fills as you read. */}
  <div class="readbar" id="read-progress" aria-hidden="true"></div>

  <article class="section bg-ivory art">
    <div class="wrap art__layout">
      <ArticleTOC items={tocItems} />

      <div class="prose">
        {
          article.sections.map((s, si) => (
            <section class="prose__section" aria-labelledby={s.slug}>
              <h2 id={s.slug} data-split>{s.heading}</h2>
              {s.image && (
                <Reveal as="figure" class="prose__figure">
                  <Image
                    src={s.image}
                    alt={s.imageAlt ?? ""}
                    widths={[560, 860, 1200]}
                    sizes="(max-width: 900px) 92vw, 72ch"
                    loading={si === 0 ? "eager" : "lazy"}
                  />
                </Reveal>
              )}
              {s.body.map((p, i) => (
                <Reveal as="p" delay={Math.min(i * 0.03, 0.15)}>{p}</Reveal>
              ))}
            </section>
          ))
        }

        {/* FAQ */}
        <section class="prose__faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading" data-split>Frequently Asked Questions</h2>
          <FaqAccordion items={article.faqs} onDark={false} />
        </section>

        {/* Tags */}
        <ul class="art__tags" data-reveal aria-label="Tags">
          {article.tags.map((t) => <li>#{t}</li>)}
        </ul>

        <footer class="prose__foot">
          <Button href="/journal" variant="ghost">Back to the Journal</Button>
        </footer>
      </div>
    </div>
  </article>

  <!-- RELATED — hairline index rows -->
  <section class="section bg-sunk" aria-label="Related journal articles">
    <div class="wrap">
      <p class="eyebrow related__eyebrow" data-reveal>Keep Reading</p>
      <div class="related">
        {
          related.map((a, i) => (
            <a
              class="rrow"
              href={`/journal/${a.slug}`}
              data-reveal
              data-reveal-delay={Math.min(i * 0.05, 0.2)}
            >
              <span class="rrow__cat">{a.category}</span>
              <h3 class="rrow__title">{a.title}</h3>
              <span class="rrow__more">
                Read <span class="rrow__arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Reading progress bar ─────────────────────────────────────────────── */
  .readbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: calc(var(--z-nav) + 1);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .readbar {
      display: none;
    }
  }

  /* ── Layout — sticky TOC rail + centered body ─────────────────────────── */
  .art__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
    max-width: 72ch;
    justify-self: center;
    width: 100%;
  }
  .art :global(.toc) {
    grid-column: 2;
    grid-row: 1;
  }

  @media (max-width: 900px) {
    .art__layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .prose,
    .art :global(.toc) {
      grid-column: 1;
    }
    .art :global(.toc) {
      grid-row: 1;
    }
    .prose {
      grid-row: 2;
      justify-self: stretch;
    }
  }

  /* ── Article body ─────────────────────────────────────────────────────── */
  .prose__section + .prose__section,
  .prose__faq {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .prose :global(h2) {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.12;
    padding-top: clamp(1.4rem, 2.5vw, 2rem);
    margin-bottom: clamp(1.1rem, 2vw, 1.6rem);
    border-top: 1px solid var(--line);
  }
  .prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1.4rem;
    max-width: none;
  }
  .prose :global(.prose__figure) {
    margin: 0 0 clamp(1.6rem, 3vw, 2.4rem);
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .prose :global(.prose__figure img) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(blockquote) {
    margin: clamp(1.8rem, 3.5vw, 2.8rem) 0;
    padding-left: 1.6rem;
    border-left: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.5;
    color: var(--text);
  }

  /* FAQ heading matches section rhythm; accordion styled by FaqAccordion. */
  .prose__faq :global(.faq) {
    margin-top: 0.5rem;
  }

  /* ── Tags ─────────────────────────────────────────────────────────────── */
  .art__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
  }
  .art__tags li {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--text-muted);
    border: 1px solid var(--line);
    padding: 0.4rem 0.8rem;
  }
  .prose__foot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  /* ── Related rows ─────────────────────────────────────────────────────── */
  .related__eyebrow {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .related {
    border-top: 1px solid var(--line);
  }
  .rrow {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) 1fr auto;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.4rem, 2.8vw, 2.2rem);
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }
  .rrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .rrow__cat {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rrow__title {
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    line-height: 1.15;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .rrow:hover .rrow__title {
    color: var(--accent);
  }
  .rrow__more {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .rrow__arrow {
    display: inline-block;
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .rrow:hover .rrow__arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .rrow__title,
    .rrow__arrow,
    .prose :global(a) {
      transition: none;
    }
  }

  @media (max-width: 700px) {
    .rrow {
      grid-template-columns: 1fr auto;
      gap: 0.6rem 1.5rem;
    }
    .rrow__cat {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Reading progress bar — fills with scroll depth through the article.
  function initReadProgress() {
    const bar = document.getElementById("read-progress");
    const body = document.querySelector<HTMLElement>("article.art");
    if (!bar || !body) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const read = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      bar.style.transform = `scaleX(${total > 0 ? read / total : 1})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
  }

  document.addEventListener("astro:page-load", initReadProgress);
  if (document.readyState !== "loading") initReadProgress();
  else document.addEventListener("DOMContentLoaded", initReadProgress);
</script>
