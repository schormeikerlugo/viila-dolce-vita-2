---
/**
 * Journal index — a running local guide.
 * Tuscan Editorial: "/ Journal" slash-label header, then large hairline rows
 * (image at ~40%, category, Bodoni title, excerpt, "Read the story ↗").
 * Content from journal.ts (content.md).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { journal, journalIntro } from "../../data/journal";
---

<BaseLayout
  title="Journal"
  description="A running local guide, not a press release: things to do nearby, restaurant spotlights, and life at the estate."
>
  <!-- HEADER — editorial masthead -->
  <header class="jhead">
    <div class="wrap">
      <p class="slash-label jhead__label">Journal</p>
      <h1 class="jhead__title">A Running Local Guide</h1>
      <p class="jhead__intro">{journalIntro}</p>
    </div>
  </header>

  <!-- ARTICLE LIST — hairline rows -->
  <section class="section bg-ivory jlist-section" aria-label="Journal articles">
    <div class="wrap">
      <div class="jlist">
        {
          journal.map((a, i) => (
            <a
              class="jrow"
              href={`/journal/${a.slug}`}
              data-reveal
              data-reveal-delay={Math.min(i * 0.05, 0.2)}
            >
              <span class="jrow__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div class="jrow__media hoist" transition:name={`journal-${a.slug}`}>
                <Image
                  src={a.image}
                  alt={a.imageAlt}
                  widths={[480, 768, 1100, 1600]}
                  sizes="(max-width: 760px) 92vw, 38vw"
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </div>
              <div class="jrow__body">
                <p class="jrow__cat">{a.category}</p>
                <h2 class="jrow__title">{a.title}</h2>
                <p class="jrow__excerpt">{a.excerpt}</p>
                <p class="jrow__more">
                  Read the story <span class="jrow__arrow" aria-hidden="true">↗</span>
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Masthead ─────────────────────────────────────────────────────────── */
  .jhead {
    padding-top: clamp(6rem, 10vw, 8.5rem);
    background: var(--bg);
    color: var(--text);
  }
  .jhead__label {
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }
  .jhead__title {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem);
    max-width: 18ch;
  }
  .jhead__intro {
    margin-top: clamp(1.2rem, 2.5vw, 2rem);
    max-width: 52ch;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.08rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* ── Rows ─────────────────────────────────────────────────────────────── */
  .jlist-section {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .jlist {
    border-top: 1px solid var(--line);
  }
  .jrow {
    display: grid;
    grid-template-columns: minmax(2.5rem, 4rem) minmax(0, 38%) 1fr;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    align-items: center;
    padding-block: clamp(1.8rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }
  .jrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .jrow__num {
    align-self: start;
    padding-top: 0.3rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    color: var(--text-muted);
  }
  .jrow__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .jrow__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jrow__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .jrow__cat {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }
  .jrow__title {
    margin-top: 0.8rem;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.8rem);
    line-height: 1.1;
    max-width: 20ch;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .jrow:hover .jrow__title {
    color: var(--accent);
  }
  .jrow__excerpt {
    margin-top: 0.9rem;
    max-width: 52ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .jrow__more {
    margin-top: clamp(1.1rem, 2vw, 1.6rem);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text);
  }
  .jrow__arrow {
    display: inline-block;
    color: var(--text-muted);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .jrow:hover .jrow__arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .jrow__title,
    .jrow__arrow {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .jrow {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: start;
    }
    .jrow__num {
      padding-top: 0;
    }
    .jrow__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
