---
/**
 * Suites — the five suites in detail.
 * "Tuscan Editorial" reskin: a split PageHero with a hairline meta-row, a
 * Tonelli-style SpecTable index deep-linking to each suite, then alternating
 * editorial suite sections (media gallery + copy on hairlines).
 * Content from suites.ts (lifted verbatim from content.md).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHero from "../components/SectionHero.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { Image } from "astro:assets";
import { suites, roomsIntro } from "../data/suites";
import { mockups } from "../data/media";
import { bookingHref, bookingMessageHref, contact } from "../data/site";
import { galleryItems } from "../data/gallery";

// One canonical order everywhere on the page: by editorial rank, flagship first.
// The top-ranked suite (Roma) becomes "Suite 01 — Signature Suite".
const orderedSuites = [...suites].sort((a, b) => a.rank - b.rank);
const premiumSlug = orderedSuites[0].slug;

// Official estate capacity (incl. premium sofa beds) — matches the site copy.
const totalSleeps = 24;

// Evocative full-bleed background for the mid-page CTA.
const ctaImage = galleryItems.find((i) => i.slug === "villa-aerial")!.image;

// Hero background: the arched loggia and terrace in golden evening light.
const heroImage = galleryItems.find((i) => i.slug === "villa-loggia-terrace")!.image;

// The first sentence of the intro becomes the hero's italic standfirst.
const [heroDek] = roomsIntro.split(/(?<=\.)\s+/);
---

<BaseLayout
  navTheme="dark"
  title="Suites"
  description="Five private suites — Napoli, Roma, Capri, Positano and Milano — curated for real rest, with king- and queen-size beds, heated floors and panoramic Tuscan views."
>
  <SectionHero
    eyebrow="The Suites"
    title="Five Suites, One Unforgettable View"
    dek={heroDek}
    image={heroImage}
    imageAlt="The villa's arched loggia and terrace in the golden evening light"
    meta={[
      { label: "Suites", value: "5" },
      { label: "Sleeps", value: `Up to ${totalSleeps} guests` },
      { label: "Rates", value: "On request" },
    ]}
  />

  <!-- SUITES -->
  {
    orderedSuites.map((suite, i) => (
      <>
      <section
        id={suite.slug}
        class:list={["section", "suite-detail", i % 2 === 0 ? "bg-ivory" : "bg-sunk"]}
      >
        <div class:list={["suite-detail__inner", "wrap", { "is-reverse": i % 2 === 1 }]}>
          <div class="suite-detail__media" data-parallax-scope>
            <div class="suite-gallery" data-suite-gallery>
              <div class="suite-detail__img hoist" transition:name={`suite-${suite.slug}`}>
                {suite.images.map((img, gi) => (
                  <Image
                    src={img}
                    alt={gi === 0 ? suite.imageAlt : `${suite.name} — view ${gi + 1}`}
                    widths={[560, 900, 1300, 1800]}
                    sizes="(max-width: 900px) 92vw, 56vw"
                    loading={gi === 0 ? "eager" : "lazy"}
                    class:list={["suite-gallery__slide", { "is-active": gi === 0 }]}
                    data-slide={gi}
                  />
                ))}
                {suite.images.length > 1 && (
                  <>
                    <button
                      type="button"
                      class="suite-gallery__nav suite-gallery__nav--prev"
                      data-prev
                      aria-label={`Previous photo of the ${suite.name}`}
                    >
                      ‹
                    </button>
                    <button
                      type="button"
                      class="suite-gallery__nav suite-gallery__nav--next"
                      data-next
                      aria-label={`Next photo of the ${suite.name}`}
                    >
                      ›
                    </button>
                    <span class="suite-gallery__count" data-count>
                      1 / {suite.images.length}
                    </span>
                  </>
                )}
              </div>

              {suite.images.length > 1 && (
                <div class="suite-gallery__thumbs" role="tablist" aria-label={`${suite.name} photos`}>
                  {suite.images.map((img, gi) => (
                    <button
                      type="button"
                      class:list={["suite-gallery__thumb", { "is-active": gi === 0 }]}
                      data-thumb={gi}
                      role="tab"
                      aria-selected={gi === 0 ? "true" : "false"}
                      aria-label={`Show photo ${gi + 1} of the ${suite.name}`}
                    >
                      <Image
                        src={img}
                        alt=""
                        widths={[120, 200]}
                        sizes="120px"
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="suite-detail__copy">
            <Reveal as="p" class="slash-label suite-detail__kicker">
              {`Suite ${String(i + 1).padStart(2, "0")}${suite.slug === premiumSlug ? " — Signature Suite" : ""}`}
            </Reveal>
            <Reveal as="div" class="suite-detail__titlerow" delay={0.05}>
              <h2>{suite.name}</h2>
              {suite.badge && <span class="suite-detail__badge">{suite.badge}</span>}
            </Reveal>
            <Reveal delay={0.08}>
              <p class="suite-detail__tagline">{suite.tagline}</p>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="suite-detail__intro">{suite.intro}</p>
            </Reveal>
            <Reveal delay={0.14}>
              <dl class="suite-detail__meta">
                <div class="suite-detail__metacell">
                  <dt>Sleeps</dt>
                  <dd>{suite.sleeps} guests</dd>
                </div>
                <div class="suite-detail__metacell">
                  <dt>Highlight</dt>
                  <dd>{suite.highlight}</dd>
                </div>
              </dl>
            </Reveal>
            <Reveal delay={0.16}>
              <ul class="suite-detail__features">
                {suite.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </Reveal>
            <Reveal delay={0.18}>
              <div class="suite-detail__foot">
                <Button
                  href={bookingMessageHref({ suite: suite.name })}
                  variant="primary"
                  target="_blank"
                  rel="noopener"
                >
                  Reserve This Suite
                </Button>
                <Button href="/gallery" variant="ghost">
                  View more photos
                </Button>
              </div>
            </Reveal>
          </div>
        </div>
      </section>

      {/* Dynamic CTA band, placed mid-list (after the 3rd suite) for rhythm. */}
      {i === 2 && (
        <section class="suites-cta" aria-labelledby="suites-cta-title" data-parallax-scope>
          <div class="suites-cta__media" data-parallax="0.12">
            <Image
              class="suites-cta__img"
              src={ctaImage}
              alt="Villa Dolce Vita lit warm at dusk, seen from above"
              widths={[768, 1280, 1920, 2560]}
              sizes="100vw"
              loading="lazy"
            />
          </div>
          <div class="suites-cta__scrim" aria-hidden="true" />
          <div class="wrap suites-cta__inner">
            <Reveal as="p" class="eyebrow eyebrow--gold">
              Ready When You Are
            </Reveal>
            <Reveal as="h2" id="suites-cta-title" delay={0.05}>
              Find the Suite That's Yours
            </Reveal>
            <Reveal delay={0.1}>
              <p class="suites-cta__lead">
                Five suites, one unforgettable view. Tell us your dates and
                we'll match you with the room that fits your stay, then handle
                every detail before you arrive.
              </p>
            </Reveal>
            <Reveal as="div" class="suites-cta__actions" delay={0.15}>
              <Button href={bookingHref} variant="primary" onDark>
                Check Availability
              </Button>
              <a class="suites-cta__wa" href={contact.whatsappHref}>
                Or message us on WhatsApp
                <span aria-hidden="true">↗</span>
              </a>
            </Reveal>
          </div>
        </section>
      )}
      </>
    ))
  }

  <!-- IN EVERY SUITE (branding detail) -->
  <section class="in-suite" data-parallax-scope>
    <div class="in-suite__media">
      <Image
        class="in-suite__img"
        src={mockups.welcomeLetter}
        alt="Villa Dolce Vita welcome letter and room key laid out in a suite"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="lazy"
        data-parallax="0.1"
      />
      <div class="in-suite__scrim" aria-hidden="true"></div>
    </div>
    <div class="wrap in-suite__inner">
      <Reveal as="p" class="eyebrow eyebrow--gold">In Every Suite</Reveal>
      <Reveal as="h2" delay={0.05}>The Little Things, Handled</Reveal>
      <Reveal delay={0.12}>
        <p class="in-suite__lead">
          A handwritten welcome note and your room key waiting on arrival.
          Honey, olives and citrus from the farm. New bedding and adjustable
          pillows. A WhatsApp concierge on hand throughout your stay — and an
          optional butler service for those who'd like to be looked after
          completely.
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Suite sections ──────────────────────────────────────────────────── */
  /* Media leads at ~58%, copy in a narrow column — matches SplitSection. */
  .suite-detail__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6.5rem);
    align-items: center;
  }
  .suite-detail__inner.is-reverse .suite-detail__media {
    order: 2;
  }
  .suite-detail__media {
    position: relative;
    min-width: 0;
  }
  .suite-detail__copy {
    position: relative;
    min-width: 0;
  }
  .suite-detail__copy :global(.suite-detail__kicker) {
    display: block;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .suite-detail__copy :global(h2) {
    max-width: 14ch;
  }
  /* Title + Signature/Honeymoon badge on one baseline row. */
  .suite-detail__copy :global(.suite-detail__titlerow) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .suite-detail__badge {
    flex: 0 0 auto;
    align-self: center;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .suite-detail__img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  /* ---- Gallery ---- */
  .suite-gallery__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur, 0.5s) var(--ease-out, ease);
    pointer-events: none;
  }
  .suite-gallery__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  /* First slide stays visible before hydration / with JS off. */
  .suite-detail__img :global(img.suite-gallery__slide:first-of-type) {
    opacity: 1;
  }

  /* Square hairline nav buttons — no circles, no shadows. */
  .suite-gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--c-ivory);
    color: var(--c-ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--dur-fast, 0.25s),
      background var(--dur-fast, 0.25s),
      color var(--dur-fast, 0.25s);
    z-index: 2;
  }
  .suite-gallery__nav--prev { left: 0; }
  .suite-gallery__nav--next { right: 0; }
  .suite-detail__img:hover .suite-gallery__nav,
  .suite-gallery__nav:focus-visible {
    opacity: 1;
  }
  .suite-gallery__nav:hover {
    background: var(--c-ink);
    color: var(--c-ivory);
  }

  .suite-gallery__count {
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 2;
    padding: 0.35rem 0.7rem;
    background: var(--c-ink);
    color: var(--c-ivory);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .suite-gallery__thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.6rem;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 0.2rem;
  }
  .suite-gallery__thumb {
    flex: 0 0 auto;
    width: 4.5rem;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.55;
    transition:
      opacity var(--dur-fast, 0.25s),
      border-color var(--dur-fast, 0.25s);
  }
  .suite-gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .suite-gallery__thumb:hover {
    opacity: 0.85;
  }
  .suite-gallery__thumb.is-active {
    opacity: 1;
    border-color: var(--c-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .suite-gallery__slide {
      transition: none;
    }
  }

  /* ---- Copy column ---- */
  .suite-detail__tagline {
    margin-top: clamp(0.8rem, 1.5vw, 1.2rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    color: var(--text);
  }
  .suite-detail__intro {
    margin-top: clamp(0.9rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.75;
  }

  /* Hairline meta-row (Tonelli "Sleeps / From / Note"). */
  .suite-detail__meta {
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(7.5rem, 100%), 1fr));
    gap: 1.25rem;
  }
  .suite-detail__metacell {
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .suite-detail__metacell dt {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }
  .suite-detail__metacell dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text);
  }

  /* Features — index rows on 1px hairlines. */
  .suite-detail__features {
    list-style: none;
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    padding: 0;
  }
  .suite-detail__features li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .suite-detail__features li:last-child {
    border-bottom: 1px solid var(--line);
  }

  /* Actions row — left-aligned on every suite (reverse rows too). */
  .suite-detail__foot {
    margin-top: clamp(1.8rem, 3.5vw, 2.6rem);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.2rem 2rem;
    flex-wrap: wrap;
  }

  /* ── Mid-page CTA (full-bleed, ink scrim, left-anchored) ─────────────── */
  .suites-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(26rem, 66svh, 40rem);
    display: flex;
    align-items: flex-end;
    color: var(--c-ivory);
  }
  .suites-cta__media {
    position: absolute;
    inset: -8% 0;
    height: 116%;
    z-index: -2;
  }
  .suites-cta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .suites-cta__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(22, 20, 18, 0.78) 0%,
      rgba(22, 20, 18, 0.35) 55%,
      rgba(22, 20, 18, 0.2) 100%
    );
  }
  .suites-cta__inner {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .suites-cta__inner :global(h2) {
    max-width: 16ch;
  }
  .suites-cta__lead {
    max-width: 46ch;
    color: var(--text-on-dark-muted);
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    line-height: 1.7;
  }
  .suites-cta__actions {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  .suites-cta__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-ivory);
    border-bottom: 1px solid var(--line-on-dark);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .suites-cta__wa span {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .suites-cta__wa:hover {
    border-color: currentColor;
  }
  .suites-cta__wa:hover span {
    transform: translate(2px, -2px);
  }

  /* ── In Every Suite (full-bleed background) ──────────────────────────── */
  .in-suite {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--c-ivory);
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }
  .in-suite__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .in-suite__img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  /* Darken from the left so the copy stays legible over the imagery. */
  .in-suite__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(22, 20, 18, 0.92) 0%,
      rgba(22, 20, 18, 0.82) 34%,
      rgba(22, 20, 18, 0.5) 62%,
      rgba(22, 20, 18, 0.32) 100%
    );
  }
  .in-suite__inner > :global(*) {
    max-width: 44rem;
  }
  .in-suite__inner :global(.eyebrow) {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .in-suite__lead {
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    color: var(--text-on-dark-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .suite-detail__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .suite-detail__inner.is-reverse .suite-detail__media {
      order: 0;
    }
    .suite-detail__foot {
      justify-content: flex-start;
    }
    /* Stronger, even scrim on narrow screens where copy sits over the art. */
    .in-suite__scrim {
      background: linear-gradient(
        to bottom,
        rgba(22, 20, 18, 0.72),
        rgba(22, 20, 18, 0.88)
      );
    }
  }
</style>

<script>
  // Per-suite photo gallery: thumbnails + prev/next arrows crossfade slides.
  // Runs on load and after Astro view transitions (astro:page-load).
  function initSuiteGalleries() {
    const galleries = document.querySelectorAll<HTMLElement>("[data-suite-gallery]");
    galleries.forEach((gallery) => {
      if (gallery.dataset.galleryReady === "1") return;
      gallery.dataset.galleryReady = "1";

      const slides = Array.from(
        gallery.querySelectorAll<HTMLImageElement>(".suite-gallery__slide"),
      );
      const thumbs = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>("[data-thumb]"),
      );
      const count = gallery.querySelector<HTMLElement>("[data-count]");
      const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]");
      const next = gallery.querySelector<HTMLButtonElement>("[data-next]");
      if (slides.length < 2) return;

      let current = 0;
      const show = (i: number) => {
        current = (i + slides.length) % slides.length;
        slides.forEach((s, si) => s.classList.toggle("is-active", si === current));
        thumbs.forEach((t, ti) => {
          const on = ti === current;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        if (count) count.textContent = `${current + 1} / ${slides.length}`;
      };

      thumbs.forEach((t, ti) => t.addEventListener("click", () => show(ti)));
      prev?.addEventListener("click", () => show(current - 1));
      next?.addEventListener("click", () => show(current + 1));
    });
  }

  document.addEventListener("astro:page-load", initSuiteGalleries);
  initSuiteGalleries();
</script>
