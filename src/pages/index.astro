---
/**
 * Home — Tuscan Editorial landing page.
 * Order: Hero → Overview (ink) → Features & Amenities → Suites → Gallery →
 * Massa Marittima band → History (ink) → Weddings → Reviews →
 * Journal → FAQ (ink) → Final CTA.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HomeGallery from "../components/HomeGallery.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import CardCarousel from "../components/CardCarousel.astro";
import DarkTimeline from "../components/DarkTimeline.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBanner from "../components/CtaBanner.astro";
import BookingBar from "../components/BookingBar.astro";
import BackgroundVideo from "../components/BackgroundVideo.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.tsx";
import { Image } from "astro:assets";
import { contact } from "../data/site";
import { testimonials } from "../data/testimonials";
import { photos, suitePhotos } from "../data/media";
import { galleryItems } from "../data/gallery";
import { journalTeasers } from "../data/journal";
import { homeFaqs } from "../data/faq";
import { faqSchema } from "../lib/schema";

// Home gallery teaser — a curated set mixing suites + /gallery surroundings.
const gal = (slug: string) => galleryItems.find((g) => g.slug === slug)!;
const homeGalleryItems = [
  { image: gal("villa-aerial-day").image, alt: "Villa Dolce Vita and its pool from above in the golden Tuscan light", caption: "The estate from above" },
  { image: suitePhotos.roma[0], alt: "Roma suite interior", caption: "Roma suite" },
  { image: gal("villa-pool-day").image, alt: "The yellow villa and its pool on a clear summer day", caption: "The pool" },
  { image: gal("marble-bathroom").image, alt: "A modern marble bathroom with a walk-in shower", caption: "Marble bathroom" },
  { image: gal("pool-guest-afternoon").image, alt: "A guest relaxes in the pool on a sunlit afternoon", caption: "The pool" },
  { image: gal("kitchen-dining-interior").image, alt: "The suite's kitchen and dining table set for a meal", caption: "Kitchen & dining" },
  { image: gal("hallway-glass-table").image, alt: "An interior hallway with a glass table and views beyond", caption: "The hallway" },
  { image: gal("barrel-sauna-trees").image, alt: "The barrel sauna set among the trees", caption: "The barrel sauna" },
  { image: gal("villa-lavender-path").image, alt: "The villa above a path lined with lavender", caption: "Lavender & villa" },
  { image: gal("pines-valley-deer").image, alt: "Stone pines over the valley, a deer grazing below", caption: "Pines & valley" },
  { image: gal("arch-aperitivo-couple").image, alt: "Aperitivo for two under the arch as the sun goes down", caption: "Aperitivo at sunset" },
  { image: suitePhotos.milano[0], alt: "Milano suite interior", caption: "Milano suite" },
  { image: gal("stone-pine-hills").image, alt: "A great stone pine over the rolling Tuscan hills", caption: "The Tuscan hills" },
  { image: suitePhotos.positano[2], alt: "Positano suite detail", caption: "Positano suite" },
  { image: gal("gym-deck-sails").image, alt: "The open-air training deck under its sail canopy", caption: "Training deck" },
  { image: suitePhotos.roma[4], alt: "Roma suite bathroom", caption: "Roma suite" },
  { image: gal("olive-harvest-basket").image, alt: "Hand-picking olives into a wicker basket in the grove", caption: "The olive harvest" },
  { image: gal("hoopoe-meadow").image, alt: "A hoopoe pauses in the meadow grass", caption: "A hoopoe in the meadow" },
  { image: gal("outdoor-dinner-tables").image, alt: "Tables set for an outdoor dinner under the canopy", caption: "Dinner outdoors" },
  { image: gal("pool-terrace-above").image, alt: "The pool and sun terrace seen from above", caption: "The pool terrace" },
];

// Features & amenities — Masseto-style headline stats.
const estateStats = [
  { value: "5", label: "Suites" },
  { value: "7", label: "Bedrooms" },
  { value: "50", label: "Acre Estate" },
  { value: "15", label: "Guests Max" },
];

// Reviews — headline stats shown above the guest review carousel.
const reviewStats = [
  { value: "2+", label: "Years on the Market" },
  { value: "90+", label: "Groups Hosted" },
  { value: "98%", label: "Satisfaction Rate" },
];

// Full feature list, grouped into accordion rows (Masseto amenities panel).
const featureGroups = [
  { title: "Bedrooms & Beds", items: ["7 Elegant Bedrooms", "5 King Size Beds", "2 Queen Size Beds", "5 Premium Sofa Beds"] },
  { title: "Bathrooms & Living", items: ["7 Marble Bathrooms with High-End Finishing", "5 Living Rooms & Fully Equipped Kitchens"] },
  { title: "Views & Pool", items: ["Sea, Island & Forest Views", "1 Outdoor Pool"] },
  { title: "Wellness", items: ["Fully Equipped Outdoor Gym & Shaded Yoga Platform", "4-Person Outdoor Barrel Sauna"] },
  { title: "Dining", items: ["Daily Breakfast Service", "3 Chef-Cooked Dinners Per Week", "Food & Grocery Delivery"] },
  { title: "Service", items: ["On-Site Concierge", "Animal Sanctuary — 3 Rescue Dogs & 7 Cats"] },
  { title: "Entertainment", items: ["5 Big Screen TVs with Netflix & Amazon Prime", "Foosball Table"] },
  { title: "Connectivity", items: ["Starlink Satellite Internet"] },
];

// History teaser — real copy condensed from /our-story.
const historyEntries = [
  {
    era: "3,000 Years Ago",
    text: "The Etruscans mined these metal-bearing hills three thousand years ago. The <strong>butteri</strong>, Tuscany's last working cowboys, still herd cattle on horseback across the plains below. Through all of it, the same view held.",
  },
  {
    era: "The Land",
    text: "The Maremma is the Tuscany that stayed itself — less discovered than Chianti, more untamed than the Val d'Orcia. The estate sits at the centre of it, high on the <strong>Colline Metallifere</strong>: olive groves, pine and forest, threaded with walking paths that all end at a view.",
  },
  {
    era: "The House",
    text: "The hill is three thousand years old; the house does not rest on that. Every suite has been renovated recently and completely — <strong>marble bathrooms</strong>, new beds dressed in fine linens, fully fitted kitchens, and fine art on the walls.",
  },
  {
    era: "Today",
    text: "The estate was never conceived as a resort. It is a <strong>home that opens its doors</strong> — its work is not to invent an experience of Tuscany but to keep a real one intact, and to hold the gate open.",
  },
];

// Weddings carousel slides.
const weddingSlides = [
  { image: photos.weddingCeremonyKiss, alt: "The couple share a kiss at the outdoor cocktail hour", caption: "The Ceremony" },
  { image: photos.weddingGoldenHour, alt: "Bride and groom with champagne on the terrace at sunset", caption: "Golden Hour" },
  { image: photos.weddingSparklerNight, alt: "The couple with a sparkler before the lit villa at night", caption: "Under the Sky" },
  { image: photos.weddingCellarToast, alt: "The couple toasting in the estate wine cellar", caption: "The Details" },
  { image: photos.weddingArrivalCar, alt: "Bride and groom beside a car before the villa", caption: "The Arrival" },
];
---

<BaseLayout navTheme="dark" schemas={[faqSchema(homeFaqs)]}>
  <!-- HERO -->
  <Hero eyebrow="Massa Marittima, Tuscany" video="laDolceVita" booking>
    <Fragment slot="title">Villa <em>Dolce Vita</em></Fragment>
    <Fragment slot="subtitle">Under the Tuscan Stars — A Private Hilltop Estate in the Maremma</Fragment>
    <BookingBar slot="bar" theme="dark" />
  </Hero>

  <!-- OVERVIEW — ink band with the large serif statement (Masseto). -->
  <section class="section bg-dark overview" aria-labelledby="overview-title">
    <div class="wrap overview__grid">
      <Reveal as="p" class="eyebrow">Overview</Reveal>
      <div class="overview__body">
        <p class="overview__statement" id="overview-title" data-split>
          A 50-acre hillside estate in Tuscany — two stone houses, five large
          suites and a private pool, looking out past olive groves and forest
          to the sea, <em>Elba and Corsica beyond</em>.
        </p>
        <Reveal as="p" class="overview__copy" delay={0.12}>
          Set high on the Maremma hills, Villa Dolce Vita hosts up to 15 guests
          with daily breakfast, chef-cooked dinners, an on-site concierge and a
          working animal sanctuary. Massa Marittima — cobbled streets, medieval
          charm and a thousand-year-old cathedral — is fifteen minutes from
          your terrace.
        </Reveal>
        <Reveal delay={0.18}>
          <dl class="overview__meta">
            <div><dt>Location</dt><dd>Massa Marittima, Tuscany</dd></div>
            <div><dt>Accommodation</dt><dd>5 Suites · 2 Stone Houses</dd></div>
            <div><dt>Capacity</dt><dd>Up to 15 Guests</dd></div>
            <div><dt>To Town</dt><dd>15 Minutes</dd></div>
          </dl>
        </Reveal>
        <Reveal delay={0.22} class="overview__actions">
          <Button href="/our-story" variant="ghost" onDark>Read our story</Button>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- INTERSTITIAL — full-bleed night aerial between Overview and Amenities. -->
  <section class="nightband" data-parallax-scope aria-hidden="true">
    <div class="nightband__media" data-parallax="0.12">
      <Image
        class="nightband__img"
        src={gal("villa-aerial-night").image}
        alt="The villa and its pool aglow from above after dark"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
  </section>

  <!-- FEATURES & AMENITIES — headline stats table + amenity rows. -->
  <section class="section bg-ivory amenities-section" aria-label="Features and amenities">
    <div class="wrap">
      <Reveal as="p" class="eyebrow">Features &amp; Amenities</Reveal>

      <ul class="statband__row statband__row--four" data-reveal data-reveal-delay={0.08}>
        {
          estateStats.map((s) => (
            <li class="statband__stat">
              <span class="statband__value" data-count={s.value}>{s.value}</span>
              <span class="statband__label">{s.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="amenities__groups" data-reveal data-reveal-delay={0.12}>
        {
          featureGroups.map((group) => (
            <div class="amenity">
              <div class="amenity__summary">
                <span class="amenity__icon" aria-hidden="true" />
                <span class="amenity__title">{group.title}</span>
                <span class="amenity__count">{group.items.length}</span>
              </div>
              <div class="amenity__panel">
                <ul class="amenity__list">
                  {group.items.map((item) => (
                    <li class="amenity__item">{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Count-up: animate each stat from 0 to its target the first time the band
    // scrolls into view. Respects prefers-reduced-motion (shows final value).
    (() => {
      const values = Array.from(
        document.querySelectorAll<HTMLElement>(".statband__value[data-count]"),
      );
      if (!values.length) return;

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const run = (el: HTMLElement) => {
        const raw = el.dataset.count || "0";
        const target = parseInt(raw, 10);
        const suffix = raw.replace(/^-?\d+/, "");
        if (reduce || !Number.isFinite(target)) {
          el.textContent = raw;
          return;
        }
        const duration = 1600;
        const start = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          el.textContent = String(Math.round(ease(p) * target)) + suffix;
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = raw;
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              run(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.6 },
      );
      values.forEach((el) => {
        if (!reduce) el.textContent = "0";
        io.observe(el);
      });
    })();
  </script>

  <!-- GALLERY -->
  <HomeGallery
    eyebrow="Gallery"
    title="The Property"
    items={homeGalleryItems}
    href="/gallery"
    cta="View full gallery"
    limit={20}
  />

  <!-- 15 MIN TO MASSA MARITTIMA — full-bleed image with overlaid text -->
  <section class="townband" data-reveal aria-labelledby="townband-title">
    <Image
      class="townband__bg"
      src={photos.massaMarittima}
      alt="Massa Marittima's medieval cathedral and piazza"
      widths={[768, 1100, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="townband__scrim" aria-hidden="true"></div>
    <div class="townband__inner wrap">
      <div class="townband__panel">
        <p class="eyebrow eyebrow--gold">15 Minutes To</p>
        <h2 class="townband__title" id="townband-title">Massa Marittima</h2>
        <p class="townband__body">
          Cobbled streets, medieval charm, and a thousand-year-old cathedral — a
          fifteen-minute drive from your terrace, with the sea on the horizon.
          The rare town you can visit on a whim, not a whole day out.
        </p>
        <Button href="/experiences#day-trips" variant="secondary" onDark class="townband__cta">
          Discover the Town
        </Button>
      </div>
    </div>
  </section>

  <!-- HISTORY — ink timeline (Masseto "Centuries of History"). -->
  <section class="section bg-dark history" aria-label="The story of the estate">
    <div class="wrap">
      <DarkTimeline
        eyebrow="History"
        title="The Maremma<br />Was Here First"
        entries={historyEntries}
      >
        <div slot="head" class="history__cta">
          <Button href="/our-story" variant="ghost" onDark>Read the full story</Button>
        </div>
      </DarkTimeline>
    </div>
  </section>

  <!-- WEDDINGS & EVENTS — full-width photo carousel (Masseto). -->
  <section class="section bg-ivory weddings" aria-labelledby="weddings-title">
    <div class="wrap">
      <div class="weddings__head">
        <SectionHeader
          eyebrow="Weddings &amp; Events"
          title="Weddings Under the Tuscan Sun"
          align="left"
          class="weddings__header"
        >
          <p>
            Ceremonies on the hilltop terrace, cocktail hour rolling straight
            into sunset, and a reception that spills from the marble into the
            vineyard rows — with the sea and the islands on the horizon.
          </p>
        </SectionHeader>
        <Button href="/weddings-events" variant="primary" class="weddings__cta">Explore Weddings</Button>
      </div>
      <CardCarousel label="Wedding moments">
        {
          weddingSlides.map((w) => (
            <figure class="wslide">
              <div class="wslide__media hoist">
                <Image
                  src={w.image}
                  alt={w.alt}
                  widths={[560, 900, 1300]}
                  sizes="(max-width: 860px) 88vw, 42vw"
                  loading="lazy"
                />
              </div>
              <figcaption class="wslide__cap">{w.caption}</figcaption>
            </figure>
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <!-- REVIEWS — stats + carousel. -->
  <section class="section bg-ivory reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <Reveal as="p" class="eyebrow">Reviews</Reveal>
      <h2 id="reviews-title" class="reviews__title" data-split>
        What Our Guests Say<br />About Their Stay
      </h2>

      <ul class="reviews__stats statband__row" data-reveal data-reveal-delay={0.1}>
        {
          reviewStats.map((s) => (
            <li class="statband__stat">
              <span class="statband__value" data-count={s.value}>{s.value}</span>
              <span class="statband__label">{s.label}</span>
            </li>
          ))
        }
      </ul>

      <TestimonialCarousel client:load items={testimonials} />
    </div>
  </section>

  <!-- JOURNAL — editorial card carousel. -->
  <section class="section bg-sunk journal">
    <div class="wrap">
      <div class="suites-head">
        <SectionHeader eyebrow="From the Journal" title="A Running Local Guide" align="left">
          <p>Things to do nearby, restaurant spotlights, and life at the estate.</p>
        </SectionHeader>
        <Button href="/journal" variant="ghost" class="suites-head__cta">Read the Journal</Button>
      </div>
      <CardCarousel label="Journal stories">
        {
          journalTeasers.map((a) => (
            <a class="jcard carousel__slide" href={`/journal/${a.slug}`}>
              <div class="jcard__media hoist" transition:name={`journal-${a.slug}`}>
                <Image
                  src={a.image}
                  alt={a.imageAlt}
                  widths={[420, 640, 900]}
                  sizes="(max-width: 860px) 80vw, 28vw"
                  loading="lazy"
                />
              </div>
              <p class="jcard__cat">{a.category}</p>
              <h3 class="jcard__title">{a.title}</h3>
              <p class="jcard__more">Read the story <span aria-hidden="true">↗</span></p>
            </a>
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <!-- FAQ — ink accordion (Masseto). -->
  <section class="section bg-dark faq-section" aria-labelledby="faq-title">
    <div class="wrap faq-section__grid">
      <div class="faq-section__head">
        <Reveal as="p" class="eyebrow">FAQ</Reveal>
        <h2 id="faq-title" data-split>Your Questions<br />Answered</h2>
        <Reveal as="p" class="faq-section__note" delay={0.1}>
          Have more unanswered questions? Feel free to send an enquiry to
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </Reveal>
      </div>
      <FaqAccordion items={homeFaqs} />
    </div>
  </section>

  <!-- FINAL CTA — enquiry composer over the night sky. -->
  <CtaBanner
    eyebrow="Plan Your Stay"
    title="Choose Your Dates"
    sub="Send us your dates and party size — the concierge replies personally on WhatsApp, usually within the hour."
  >
    <BackgroundVideo slot="media" video="hilltownDusk" />
    <BookingBar slot="bar" theme="dark" />
  </CtaBanner>
</BaseLayout>

<style>
  /* ── OVERVIEW ─────────────────────────────────────────────────────────── */
  /* Extra breathing room (+15%) before the full-bleed night band below. */
  .overview {
    padding-bottom: calc(var(--section-y) * 1.15);
  }
  /* Home gallery: +15% extra space before the Massa Marittima band below.
     (Scoped to the home page's gallery section only.) */
  :global(.hgal) {
    padding-bottom: calc(var(--section-y) * 1.15);
  }
  .overview__grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.55fr) 1.45fr;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }
  .overview :global(.overview__statement) {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 3.1rem);
    line-height: 1.28;
    letter-spacing: 0.01em;
    color: var(--text-on-dark);
    max-width: 26ch;
  }
  .overview :global(.overview__statement em) {
    font-style: italic;
  }
  .overview :global(.overview__copy) {
    margin-top: clamp(1.5rem, 3vw, 2.4rem);
    max-width: 58ch;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-on-dark-muted);
  }
  .overview__meta {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 1.25rem;
    max-width: 46rem;
  }
  .overview__meta > div {
    border-top: 1px solid var(--line-on-dark);
    padding-top: 0.8rem;
  }
  .overview__meta dt {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-bottom: 0.35rem;
  }
  .overview__meta dd {
    font-size: 0.92rem;
    color: var(--text-on-dark);
  }
  .overview :global(.overview__actions) {
    margin-top: clamp(1.8rem, 3vw, 2.5rem);
  }
  @media (max-width: 860px) {
    .overview__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* ── STAT ROW (shared by Features + Reviews) ─────────────────────────── */
  .statband__row {
    list-style: none;
    margin: clamp(1.6rem, 3vw, 2.4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--line);
  }
  .statband__row--four {
    grid-template-columns: repeat(4, 1fr);
  }
  .statband__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: clamp(1.5rem, 2.8vw, 2.3rem) clamp(0.75rem, 1.5vw, 1.5rem);
    position: relative;
  }
  .statband__stat:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .statband__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem);
    line-height: 1;
    color: var(--text);
  }
  .statband__label {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    max-width: 14ch;
    line-height: 1.35;
  }
  @media (max-width: 760px) {
    .statband__row--four {
      grid-template-columns: repeat(2, 1fr);
    }
    .statband__row--four .statband__stat:nth-child(2n + 1)::before {
      display: none;
    }
    .statband__row--four .statband__stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 440px) {
    .reviews__stats.statband__row {
      grid-template-columns: 1fr;
    }
    .reviews__stats .statband__stat:not(:first-child)::before {
      display: none;
    }
    .reviews__stats .statband__stat:not(:first-child) {
      border-top: 1px solid var(--line);
    }
  }

  /* ── FEATURES & AMENITIES — hairline grid of "+" rows ────────────────── */
  /* Match the home gallery's centred max-width so the table isn't flush to
     the screen edges on wide viewports. */
  .amenities-section .wrap {
    width: min(100% - 2 * var(--gutter), 1500px);
    margin-inline: auto;
    padding-inline: 0;
  }
  .amenities__groups {
    margin-top: 1px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
    border: 1px solid var(--line);
    border-top: 0;
  }
  .amenity {
    position: relative;
    outline: none;
  }
  .amenity:not(:nth-child(4n + 1))::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .amenity:nth-child(n + 5) {
    border-top: 1px solid var(--line);
  }
  .amenity__summary {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.1rem, 2.2vw, 1.6rem);
  }
  .amenity__title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text);
    flex: 1;
