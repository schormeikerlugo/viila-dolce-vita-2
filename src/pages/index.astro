---
/**
 * Home — the cinematic, scroll-driven landing page.
 * Sections follow content.md's Home order:
 * Hero → Welcome → 15 min to Massa Marittima → The Experience (pinned) →
 * Suites → Beyond the Villa → Weddings → Testimonials → Journal → Final CTA.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SplitSection from "../components/SplitSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SuiteCard from "../components/SuiteCard.astro";
import HomeGallery from "../components/HomeGallery.astro";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import BackgroundVideo from "../components/BackgroundVideo.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.tsx";
import { Image } from "astro:assets";
import { bookingHref } from "../data/site";
import { suites } from "../data/suites";
import { testimonials } from "../data/testimonials";
import { photos, suitePhotos } from "../data/media";
import { galleryItems } from "../data/gallery";
import { experienceLinks } from "../data/experiences";
import { journalTeasers } from "../data/journal";

// Metro mosaic order: signature (highest rate) suite first so it takes the
// hero tile, then the rest by descending rate for a balanced layout.
const orderedSuites = [...suites].sort((a, b) => b.fromNight - a.fromNight);

// Home gallery teaser — a curated ~25-tile masonry (a 5×5 block on desktop)
// mixing suites + /gallery surroundings, linking out to the full archive.
const gal = (slug: string) => galleryItems.find((g) => g.slug === slug)!;
const homeGalleryItems = [
  {
    image: gal("villa-aerial-golden").image,
    alt: "Villa Dolce Vita from above in the golden Tuscan light",
    caption: "The estate at golden hour",
  },
  {
    image: suitePhotos.roma[0],
    alt: "Roma suite interior",
    caption: "Roma suite",
  },
  {
    image: gal("pool-afternoon").image,
    alt: "The villa with its pool and lawn on a bright afternoon",
    caption: "The pool",
  },
  {
    image: suitePhotos.napoli[0],
    alt: "Napoli suite interior",
    caption: "Napoli suite",
  },
  {
    image: gal("terrace-table-view").image,
    alt: "The loggia terrace with the hills opening out beyond",
    caption: "Terrace view",
  },
  {
    image: suitePhotos.positano[0],
    alt: "Positano suite interior",
    caption: "Positano suite",
  },
  {
    image: gal("cypress-road-hills").image,
    alt: "A white road winding between cypresses and green hills",
    caption: "Cypress road",
  },
  {
    image: suitePhotos.roma[2],
    alt: "Roma suite detail",
    caption: "Roma suite",
  },
  {
    image: gal("hills-pink-dawn").image,
    alt: "Pink dawn light over the Tuscan hills",
    caption: "Hills at dawn",
  },
  {
    image: suitePhotos.napoli[2],
    alt: "Napoli suite detail",
    caption: "Napoli suite",
  },
  {
    image: gal("vineyard-wine-sunset").image,
    alt: "Wine and grapes on an old barrel at sunset",
    caption: "Wine at sunset",
  },
  {
    image: suitePhotos.milano[0],
    alt: "Milano suite interior",
    caption: "Milano suite",
  },
  {
    image: gal("massa-marittima-piazza").image,
    alt: "The cathedral square of Massa Marittima under a summer sky",
    caption: "Massa Marittima",
  },
  {
    image: suitePhotos.positano[2],
    alt: "Positano suite detail",
    caption: "Positano suite",
  },
  {
    image: gal("valdorcia-mist").image,
    alt: "Morning mist settling into the folds of the Val d'Orcia",
    caption: "Val d'Orcia",
  },
  {
    image: suitePhotos.roma[4],
    alt: "Roma suite bathroom",
    caption: "Roma suite",
  },
  {
    image: gal("horseman").image,
    alt: "A buttero and his horse in the morning field",
    caption: "Morning ride",
  },
  {
    image: suitePhotos.napoli[4],
    alt: "Napoli suite bedroom",
    caption: "Napoli suite",
  },
  {
    image: gal("piazza-dinner").image,
    alt: "Dinner tables filling the piazza at dusk",
    caption: "Dinner in the piazza",
  },
  {
    image: suitePhotos.positano[3],
    alt: "Positano suite view",
    caption: "Positano suite",
  },
  {
    image: gal("estate-vineyards-aerial").image,
    alt: "The estate and its vineyards seen from above",
    caption: "Estate & vineyards",
  },
  {
    image: suitePhotos.roma[3],
    alt: "Roma suite living area",
    caption: "Roma suite",
  },
  {
    image: gal("olive-grove-walk").image,
    alt: "A slow walk through the olive grove",
    caption: "Olive grove",
  },
  {
    image: suitePhotos.napoli[5],
    alt: "Napoli suite detail",
    caption: "Napoli suite",
  },
  {
    image: gal("stringlight-toast").image,
    alt: "Glasses raised under the string lights",
    caption: "Under the lights",
  },
];

// Estate at a glance — four headline stats shown beneath the welcome.
const estateStats = [
  { value: "50", label: "Acre Hillside Estate" },
  { value: "2", label: "Stone Structures" },
  { value: "5", label: "Premium Suites" },
  { value: "24", label: "Guests Max" },
];

// Full feature list, grouped into accordion sections for a tidy, scannable UX.
// Everything beyond the four headline stats lives here.
const featureGroups = [
  {
    title: "Bedrooms & Beds",
    items: [
      "7 Elegant Bedrooms",
      "5 King Size Beds",
      "2 Queen Size Beds",
      "5 Premium Sofa Beds",
    ],
  },
  {
    title: "Bathrooms & Living",
    items: [
      "7 Marble Bathrooms with High-End Finishing",
      "5 Living Rooms & Fully Equipped Kitchens",
    ],
  },
  {
    title: "Views & Pool",
    items: ["Sea, Island & Forest Views", "1 Outdoor Pool"],
  },
  {
    title: "Wellness",
    items: [
      "Fully Equipped Outdoor Gym & Shaded Yoga Platform",
      "4-Person Outdoor Barrel Sauna",
    ],
  },
  {
    title: "Dining",
    items: [
      "Daily Breakfast Service",
      "3 Chef-Cooked Dinners Per Week",
      "Food & Grocery Delivery",
    ],
  },
  {
    title: "Service",
    items: ["On-Site Concierge", "Animal Sanctuary — 3 Rescue Dogs & 7 Cats"],
  },
  {
    title: "Entertainment",
    items: ["5 Big Screen TVs with Netflix & Amazon Prime", "Foosball Table"],
  },
  {
    title: "Connectivity",
    items: ["Starlink Satellite Internet"],
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <Hero eyebrow="Massa Marittima, Tuscany" video="laDolceVita" booking>
    <Fragment slot="title">Under The <em>Tuscan Sun</em></Fragment>
  </Hero>

  <!-- WELCOME -->
  <SplitSection
    eyebrow="Welcome to Villa Dolce Vita"
    title="50 Acre Hillside Estate in Tuscany"
    reverse
  >
    <Image
      slot="media"
      class="welcome-cutout"
      src={photos.welcomeVilla}
      alt="Villa Dolce Vita perched on the Tuscan hillside"
      widths={[560, 900, 1300, 1800]}
      sizes="(max-width: 900px) 92vw, 52vw"
      loading="lazy"
      data-mouse-parallax="14"
    />
    <p>
      Set high on the Maremma hills, Villa Dolce Vita looks out past olive
      groves and forest to the sea, Elba and Corsica beyond. Two stone houses,
      five large suites, up to 24 guests.
    </p>
    <div class="actions">
      <Button href="/our-story" variant="ghost">Read our story</Button>
    </div>
  </SplitSection>

  <!-- ESTATE AT A GLANCE — four headline stats as a full-width table row
       beneath the welcome, with framing rules on all sides. -->
  <section class="statband bg-ivory" aria-label="The estate at a glance">
    <div class="wrap">
      <ul class="statband__row statband__row--four statband__row--table" data-reveal data-reveal-delay={0.1}>
        {
          estateStats.map((s) => (
            <li class="statband__stat">
              <span class="statband__value" data-count={s.value}>
                {s.value}
              </span>
              <span class="statband__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FEATURES & AMENITIES — full-width hover-reveal columns, pulled up close
       under the welcome to avoid excess height. -->
  <section class="amenities-section bg-ivory" aria-label="Features and amenities">
    <div class="amenities wrap" data-reveal data-reveal-delay={0.1}>
      <p class="amenities__eyebrow">Features &amp; Amenities</p>
      <div class="amenities__groups">
        {
          featureGroups.map((group) => (
            <div class="amenity" tabindex="0">
              <div class="amenity__summary">
                <span class="amenity__title">{group.title}</span>
                <span class="amenity__count">{group.items.length}</span>
                <span class="amenity__icon" aria-hidden="true" />
              </div>
              <div class="amenity__panel">
                <ul class="amenity__list">
                  {group.items.map((item) => (
                    <li class="amenity__item">{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Count-up: animate each stat from 0 to its target the first time the band
    // scrolls into view. Respects prefers-reduced-motion (shows final value).
    (() => {
      const values = Array.from(
        document.querySelectorAll<HTMLElement>(".statband__value[data-count]"),
      );
      if (!values.length) return;

      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const run = (el: HTMLElement) => {
        const target = parseInt(el.dataset.count || "0", 10);
        if (reduce || !Number.isFinite(target)) {
          el.textContent = String(target);
          return;
        }
        const duration = 1600;
        const start = performance.now();
        // easeOutCubic for a natural deceleration.
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          el.textContent = String(Math.round(ease(p) * target));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              run(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.6 },
      );
      values.forEach((el) => {
        el.textContent = "0";
        io.observe(el);
      });
    })();
  </script>

  <!-- 15 MIN TO MASSA MARITTIMA — full-bleed image with an overlaid text panel -->
  <section class="townband" data-reveal aria-labelledby="townband-title">
    <Image
      class="townband__bg"
      src={photos.massaMarittima}
      alt="Massa Marittima's medieval cathedral and piazza"
      widths={[768, 1100, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="townband__scrim" aria-hidden="true"></div>
    <div class="townband__inner wrap">
      <div class="townband__panel">
        <p class="eyebrow eyebrow--gold">15 Minutes To</p>
        <h2 class="townband__title" id="townband-title">Massa Marittima</h2>
        <hr class="rule" />
        <p class="townband__body">
          Cobbled streets, medieval charm, and a thousand-year-old cathedral — a
          fifteen-minute drive from your terrace, with the sea on the horizon.
          The rare town you can visit on a whim, not a whole day out.
        </p>
        <Button
          href="/experiences#day-trips"
          variant="secondary"
          onDark
          class="townband__cta"
        >
          Discover the Town
        </Button>
      </div>
    </div>
  </section>

  <!-- THE SUITES — metro mosaic: a signature hero tile + a 2×2 grid. -->
  <section class="section bg-ivory">
    <div class="wrap">
      <div class="suites-head">
        <SectionHeader
          eyebrow="The Suites"
          title="Five Suites, One View"
          align="center"
        >
          <p>Sophisticated comfort and genuine charm, curated for real rest.</p>
        </SectionHeader>
        <Button href="/suites" variant="ghost" class="suites-head__cta"
          >Explore all suites</Button
        >
      </div>
      <div class="suites-metro">
        {
          orderedSuites.map((s, i) => (
            <div
              class:list={["suites-metro__cell", `suites-metro__cell--${i}`]}
            >
              <SuiteCard suite={s} featured={i === 0} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALLERY — 60/40 teaser: the villa and its surroundings, curated from the
       suites + the /gallery archive, linking out to the full gallery. -->
  <HomeGallery
    eyebrow="Gallery"
    title="The Property"
    items={homeGalleryItems}
    href="/gallery"
    cta="View full gallery"
  />

  <!-- BEYOND THE VILLA -->
  <section class="section bg-dark beyond">
    <div class="wrap">
      <SectionHeader
        eyebrow="Beyond the Villa"
        title="This Is What There Is to Do Here, Beyond Nothing at All"
        align="center"
        onDark
        class="beyond-head"
      >
        <p style="color:var(--text-on-dark-muted)">
          Wine tastings ten minutes away. Horses through the olive groves. A
          cooking class that ends with a flaming wheel of parmigiano.
        </p>
      </SectionHeader>
      <ul class="beyond__grid">
        {
          experienceLinks.map((e) => (
            <li class="beyond__item" data-reveal>
              <a href={e.href}>
                <span class="beyond__name">{e.label}</span>
                <span class="beyond__arrow">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- JOURNAL -->
  <section class="section bg-ivory">
    <div class="wrap">
      <div class="journal-head">
        <SectionHeader
          eyebrow="From the Journal"
          title="A Running Local Guide"
          align="center"
        >
          <p>
            Things to do nearby, restaurant spotlights, and life at the estate.
          </p>
        </SectionHeader>
        <Button href="/journal" variant="ghost" class="journal-head__cta"
          >Read the Journal</Button
        >
      </div>
      {
        /* Journal posts as an alternating editorial zigzag: text one side,
          image the other, flipping on every row. */
      }
      <div class="jzig">
        {
          journalTeasers.map((a, i) => (
            <a
              class:list={["jrow", { "jrow--reverse": i % 2 === 0 }]}
              href={`/journal/${a.slug}`}
              data-reveal
              data-reveal-delay={i * 0.05}
            >
              <div class="jrow__media">
                <Image
                  src={a.image}
                  alt={a.imageAlt}
                  widths={[600, 900, 1300]}
                  sizes="(max-width: 860px) 92vw, 48vw"
                  loading="lazy"
                />
              </div>
              <div class="jrow__body">
                <span class="eyebrow eyebrow--gold">{a.category}</span>
                <h2 class="jrow__title">{a.title}</h2>
                <p class="jrow__excerpt">{a.excerpt}</p>
                <span class="jrow__more">Read the story →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section bg-charcoal testimonials">
    <div class="wrap">
      <SectionHeader
        eyebrow="What Guests Say"
        title="Kind Words"
        align="center"
        onDark
      />
      <TestimonialCarousel client:load items={testimonials} />
    </div>
  </section>

  <!-- WEDDINGS & EVENTS — editorial teaser: oversized headline, meta + copy +
       actions, and a staggered three-photo strip linking to /weddings-events. -->
  <section class="section bg-ivory weddings" aria-labelledby="weddings-title">
    <div class="wrap weddings__split">
      <div class="weddings__intro">
        <Reveal as="p" class="eyebrow eyebrow--diamond weddings__eyebrow"
          >Weddings &amp; Events</Reveal
        >
        <Reveal
          as="h2"
          delay={0.05}
          class="weddings__title"
          id="weddings-title"
        >
          Weddings Under<br /><em>the Tuscan Sun</em>
        </Reveal>

        <div class="weddings__lead">
          <Reveal as="p" class="weddings__copy" delay={0.1}>
            Ceremonies on the hilltop terrace, cocktail hour rolling straight
            into sunset, and a reception that spills from the marble into the
            vineyard rows — with the sea and the islands on the horizon.
          </Reveal>
          <Reveal class="weddings__actions" delay={0.14}>
            <Button href="/weddings-events" variant="primary"
              >Explore Weddings</Button
            >
          </Reveal>
        </div>
      </div>

      <div class="weddings__gallery">
        <figure class="wtile wtile--1" data-reveal data-reveal-delay={0.05}>
          <Image
            src={photos.weddingVeil}
            alt="Bride and groom beneath a veil in the golden Tuscan light"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 92vw, 30vw"
            loading="lazy"
          />
        </figure>
        <figure class="wtile wtile--2" data-reveal data-reveal-delay={0.12}>
          <Image
            src={photos.weddingDance}
            alt="A couple's first dance, gown lit against the dark"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 92vw, 30vw"
            loading="lazy"
          />
        </figure>
        <figure class="wtile wtile--3" data-reveal data-reveal-delay={0.19}>
          <Image
            src={photos.weddingBouquet}
            alt="Bride holding an illuminated bouquet beside the groom"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 92vw, 30vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="finalcta">
    <BackgroundVideo video="aerialTownGolden" />
    <div class="finalcta__content wrap">
      <Reveal as="p" class="eyebrow eyebrow--gold"
        >Book direct for the best rate</Reveal
      >
      <Reveal as="h2" delay={0.05}>Come Sit on the Hill for a While</Reveal>
      <Reveal delay={0.1}
        ><p class="finalcta__sub">Five suites. One view.</p></Reveal
      >
      <Reveal delay={0.15}>
        <Button href={bookingHref} variant="primary">Check Availability</Button>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* Section header with a link that sits on the title's baseline, then the grid. */
  .suites-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: var(--space-group);
  }
  .suites-head :global(.sechead) {
    /* header owns the bottom margin now */
    margin-bottom: 0;
  }
  .suites-head__cta {
    flex: 0 0 auto;
    white-space: nowrap;
  }
  /* ---- Suites: metro mosaic ----
     4 equal columns, 2 equal rows. The signature suite (cell 0) claims a 2×2
     hero tile on the left; the four supporting suites fill a clean 2×2 grid
     on the right — no gaps.

       [ 0 0 1 2 ]
       [ 0 0 3 4 ]                                                        */
  .suites-metro {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, minmax(8.8rem, 1fr));
    gap: clamp(1rem, 1.8vw, 1.6rem);
  }
  .suites-metro__cell {
    display: flex;
    min-width: 0;
  }
  .suites-metro__cell > :global(.suite) {
    width: 100%;
  }
  /* Signature suite: big hero tile spanning the left half. */
  .suites-metro__cell--0 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }
  .suites-metro__cell--1 {
    grid-column: 3;
    grid-row: 1;
  }
  .suites-metro__cell--2 {
    grid-column: 4;
    grid-row: 1;
  }
  .suites-metro__cell--3 {
    grid-column: 3;
    grid-row: 2;
  }
  .suites-metro__cell--4 {
    grid-column: 4;
    grid-row: 2;
  }

  /* Every card fills its tile; images grow to consume the tile height. */
  .suites-metro__cell :global(.suite__media) {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Tablet: 2 columns; hero spans the full width on top, then a 2×2 grid. */
  @media (max-width: 1000px) {
    .suites-metro {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
      grid-auto-rows: 1fr;
    }
    .suites-metro__cell--0 {
      grid-column: 1 / 3;
      grid-row: auto;
    }
    .suites-metro__cell--1,
    .suites-metro__cell--2,
    .suites-metro__cell--3,
    .suites-metro__cell--4 {
      grid-column: auto;
      grid-row: auto;
    }
    .suites-metro__cell :global(.suite__media) {
      aspect-ratio: 4 / 5;
      flex: 0 0 auto;
    }
    .suites-metro__cell--0 :global(.suite__media) {
      aspect-ratio: 16 / 10;
    }
  }
  /* Phone: single column stack. */
  @media (max-width: 560px) {
    .suites-metro {
      grid-template-columns: 1fr;
    }
    .suites-metro__cell--0 {
      grid-column: 1;
    }
    .suites-metro__cell :global(.suite__media),
    .suites-metro__cell--0 :global(.suite__media) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 900px) {
    .suites-head__cta {
      margin-bottom: 1.5rem;
    }
  }

  /* Tighten the first two sections under the hero.
     NOTE: .features is rendered by the FeatureBar component, so it doesn't
     carry this page's scope hash — the whole selector must be :global(). */
  :global(.features + .section) {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  /* "Beyond the Villa" heading: dial back to a real h2 size (site-wide h2s
     were bumped up to h1 scale). This one title only. */
  :global(.beyond-head h2) {
    font-size: var(--fs-h2);
  }
  /* Welcome split leads straight into the Massa Marittima band — no bottom gap. */
  :global(.features + .section.split) {
    padding-bottom: 0;
  }

  /* "15 minutes to" banner: full-bleed image (native 1280×520 ≈ 32/13)
     with a forest scrim on the left and the text panel overlaid. */
  .townband {
    position: relative;
    width: 100%;
    aspect-ratio: 1280 / 520;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* Sits flush against the Welcome split above and the Experience below. */
    margin-block: 0;
  }
  .townband__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Dark gradient anchored left so the text stays legible over the sky. */
  .townband__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      ellipse 60% 75% at 50% 50%,
      rgba(47, 63, 53, 0.62) 0%,
      rgba(47, 63, 53, 0.42) 45%,
      rgba(47, 63, 53, 0.12) 75%,
      rgba(47, 63, 53, 0) 100%
    );
  }
  .townband__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .townband__panel {
    color: var(--c-ivory);
    max-width: 52ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .townband__title {
