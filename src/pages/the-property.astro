---
/**
 * Our Story — the estate's story, land, house, philosophy and mission.
 * Copy adapted from Docs/our-story-estate-voice.md (Maremma estate voice).
 * Reskinned to the "Tuscan Editorial" language: rectangles, 1px hairlines,
 * ivory/ink grounds, a single terracotta accent.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SplitSection from "../components/SplitSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBand from "../components/StatBand.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import Reveal from "../components/Reveal.astro";
import { bookingHref } from "../data/site";
import { photos } from "../data/media";
import { galleryItems } from "../data/gallery";

// Page hero: the villa above a path lined with lavender.
const heroImage = galleryItems.find((i) => i.slug === "villa-lavender-path")!.image;
// The Invitation banner: the barrel sauna set among the trees.
const invitationImage = galleryItems.find((i) => i.slug === "barrel-sauna-trees")!.image;
// The Land: stone pines over the valley, a deer grazing below.
const landImage = galleryItems.find((i) => i.slug === "pines-valley-deer")!.image;
// The House: a suite's elegant living room, warm Tuscan interior.
const houseImage = galleryItems.find((i) => i.slug === "living-room-suite")!.image;
// Our Philosophy: lavender on the terrace rail, the valley and a lone pine beyond.
const philosophyImage = galleryItems.find((i) => i.slug === "lavender-rail-valley")!.image;

// A framed 5-picture teaser — opens the same lightbox as the home gallery.
const propertyGallerySlugs = [
  "living-room-lavender",
  "stone-pine-sunset",
  "dining-dusk-table",
  "roe-deer-lavender",
  "gym-weights-deck",
];
const propertyGallery = propertyGallerySlugs.map((slug) => {
  const item = galleryItems.find((i) => i.slug === slug)!;
  return { image: item.image, alt: item.alt };
});

const estateStats = [
  { value: "3,000", label: "Years of view" },
  { value: "50", label: "Acres of estate" },
  { value: "5", label: "Private suites" },
  { value: "1", label: "View of the sea" },
];

const values = [
  {
    title: "Rootedness",
    body: "Of this place, from this place, for this place.",
  },
  {
    title: "Continuity",
    body: "Traditions kept in use, not kept in glass.",
  },
  {
    title: "Hospitality",
    body: "In the old Tuscan sense. A guest at the table is family at the table.",
  },
  {
    title: "Stillness",
    body: "Guarded on this hill as carefully as any monument.",
  },
  {
    title: "Wonder",
    body: "The daily kind. A sunset behind Corsica never becomes routine.",
  },
];
---

<BaseLayout
  title="Our Story"
  description="Villa Dolce Vita sits high on the Colline Metallifere in the Maremma — three thousand years of view, fifty acres of olive groves and forest, five suites, and a single purpose: a front-row seat to the real Tuscany."
>
  <PageHero
    eyebrow="Our Story"
    title="The Maremma Was Here First"
    image={heroImage}
    imageAlt="The villa in the distance above a path lined with lavender"
    meta={[
      { label: "Location", value: "Colline Metallifere, Maremma" },
      { label: "Estate", value: "50 Acres" },
      { label: "Suites", value: "5" },
      { label: "View", value: "Sea, Elba & Corsica" },
    ]}
  >
    <p>
      This is old country. The Etruscans mined these metal-bearing hills three
      thousand years ago. The butteri, Tuscany's last working cowboys, still
      herd cattle on horseback across the plains below. Through all of it, the
      same view held.
    </p>
  </PageHero>

  <!-- THE LAND -->
  <SplitSection
    eyebrow="The Land"
    title="Where Tuscany Keeps Its Wildness"
    image={landImage}
    imageAlt="Stone pines over the valley, a deer grazing below"
    reverse
  >
    <p>
      The Maremma is the Tuscany that stayed itself — less discovered than
      Chianti, more untamed than the Val d'Orcia. Turquoise lakes rest in the
      old mining ground. Trails run through chestnut woods. The coast, forty
      minutes away, empties out by evening.
    </p>
    <p>
      The estate sits at the centre of it, high on the Colline Metallifere.
      Fifty acres of olive groves, pine and forest, threaded with walking paths
      that all end the same way — at a view. The sea lies in one direction, the
      hills in every other, and nothing stands between you and either.
    </p>
  </SplitSection>

  <!-- THE HOUSE -->
  <SplitSection
    eyebrow="The House"
    title="An Ancient Hill, Newly Kept"
    image={houseImage}
    imageAlt="A suite's elegant living room with a chandelier, framed art and a warm Tuscan glow"
    theme="stone"
  >
    <p>
      The hill is three thousand years old. The house does not rest on that.
      Every suite has been renovated recently and completely, to one standard
      held throughout: marble bathrooms, new beds dressed in fine linens, fully
      fitted kitchens, and fine art on the walls — chosen the way everything
      here is chosen, deliberately and to last.
    </p>
    <p>
      The pairing is a rare one. A landscape that has never changed, and rooms
      that have never been newer.
    </p>
    <div class="actions">
      <Button href="/suites" variant="ghost">See the suites</Button>
    </div>
  </SplitSection>

  <!-- BY THE NUMBERS -->
  <StatBand
    eyebrow="The Estate in Numbers"
    title="Three Thousand Years, Fifty Acres"
    stats={estateStats}
    theme="dark"
  />

  <!-- THE HILLTOP -->
  <SplitSection
    eyebrow="The Hilltop"
    title="Rest, at Altitude"
    image={photos.hilltopRest}
    imageAlt="Rest at altitude — the estate's hilltop gardens and view"
    reverse
  >
    <p>
      The wellness of this place begins with the setting and is finished with
      care. A pool rests in the quiet of the hilltop gardens. A handcrafted
      barrel sauna faces the olive groves — heat and silence and landscape
      working together. An outdoor gym waits under the open sky, for those who
      prefer their stillness earned.
    </p>
    <p>
      The terraces do what terraces here have always done. They hold the view:
      the valley, the sea, the islands, and each evening a sunset that sinks
      behind Corsica and hands the sky to the stars. There is no light up here
      to argue with them. The Tuscan night arrives whole.
    </p>
  </SplitSection>

  <!-- FRAMED GALLERY TEASER — click a frame to open the lightbox -->
  <section class="section bg-dark propgal" aria-label="A glimpse of the estate">
    <div class="propgal__inner">
      <ul class="propgal__grid">
        {
          propertyGallery.map((item, i) => (
            <li
              class="propgal__tile"
              data-reveal
              data-reveal-delay={0.05 + i * 0.06}
              data-cap={item.alt}
            >
              <button
                type="button"
                class="propgal__link"
                aria-label={`View ${item.alt}`}
                aria-haspopup="dialog"
                data-lb-open
                data-cursor="view"
              >
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[320, 480, 640, 900]}
                  sizes="(max-width: 760px) 45vw, 18vw"
                  loading="lazy"
                />
              </button>
            </li>
          ))
        }
      </ul>
      <div class="propgal__foot" data-reveal data-reveal-delay={0.1}>
        <Button href="/gallery" variant="ghost" onDark>View full gallery</Button>
      </div>
    </div>

    {/* ─── Lightbox modal (same behaviour as the home gallery) ─── */}
    <div
      class="propgal-lb"
      id="property-gallery-lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Photograph viewer"
      hidden
    >
      <div class="propgal-lb__backdrop" data-lb-close></div>

      <button type="button" class="propgal-lb__btn propgal-lb__close" data-lb-close aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <button type="button" class="propgal-lb__btn propgal-lb__nav propgal-lb__prev" data-lb-prev aria-label="Previous photograph">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <figure class="propgal-lb__figure">
        <img class="propgal-lb__img" src="" alt="" />
        <figcaption class="propgal-lb__bar">
          <span class="propgal-lb__title" data-lb-title></span>
          <span class="propgal-lb__count" data-lb-count aria-live="polite"></span>
        </figcaption>
      </figure>

      <button type="button" class="propgal-lb__btn propgal-lb__nav propgal-lb__next" data-lb-next aria-label="Next photograph">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </section>

  <!-- OUR PHILOSOPHY -->
  <SplitSection
    eyebrow="Our Philosophy"
    title="Continuity Over Novelty"
    image={philosophyImage}
    imageAlt="Lavender on the terrace rail, the valley and a lone pine beyond"
  >
    <p>
      Nothing here chases a trend. The paths follow the contours they always
      have. Dinner runs long because dinner here has always run long. The view
      is the entertainment, as it has been for three thousand years.
    </p>
    <p>
      The estate was never conceived as a resort. It is a home that opens its
      doors — more personal than a hotel, more considered than a villa for rent,
      and truer than either. Its work is not to invent an experience of Tuscany
      but to keep a real one intact, and to hold the gate open.
    </p>
  </SplitSection>

  <!-- MISSION & VALUES — editorial index list on ivory (Tonelli) -->
  <section class="section bg-ivory creed-section">
    <div class="wrap">
      <SectionHeader
        eyebrow="Our Mission"
        title="To Keep This Corner of the Maremma as It Is"
        align="left"
      >
        <p>
          Its land, its light, its pace, and its evenings under the Tuscan
          stars — and to share it with guests who came for the real thing.
        </p>
      </SectionHeader>

      <ol class="values">
        {
          values.map((v, i) => (
            <Reveal as="li" class="values__item" delay={i * 0.06}>
              <span class="values__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="values__title">{v.title}</h3>
              <p class="values__body">{v.body}</p>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- INVITATION -->
  <CtaBanner
    eyebrow="The Invitation"
    title="Escape to Tuscany for a While"
    sub="The Etruscans chose these hills. So did the butteri. The door is open."
    ctaLabel="Check Availability"
    ctaHref={bookingHref}
    image={invitationImage}
    imageAlt="The barrel sauna set among the trees"
  />
</BaseLayout>

<style>
  /* The mission title runs long — let it breathe wider than the 24ch default. */
  .creed-section :global(.sechead h2) {
    max-width: 28ch;
  }

  /* ── FRAMED GALLERY TEASER — five portrait "pictures" + CTA ───────────── */
  .propgal {
    /* Generous breathing room above/below the framed row. */
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .propgal__inner {
    /* Comfortable side padding so the frames never touch the screen edge. */
    width: min(100% - 2 * var(--gutter), 1500px);
    margin-inline: auto;
    padding-inline: clamp(0.5rem, 2vw, 2rem);
  }
  .propgal__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.6rem, 1.4vw, 1.4rem);
  }
  .propgal__tile {
    margin: 0;
  }
  .propgal__link {
    display: block;
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    aspect-ratio: 3 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-sunk);
    cursor: zoom-in;
  }
  .propgal__link :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .propgal__link:hover :global(img),
  .propgal__link:focus-visible :global(img) {
    transform: scale(1.05);
  }
  .propgal__foot {
    margin-top: clamp(1.8rem, 3.5vw, 3rem);
    text-align: center;
  }
  @media (max-width: 760px) {
    .propgal__grid {
      /* Reflow to a tidy 2-up (last tile centred) on small screens. */
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .propgal__link :global(img) {
      transition: none;
    }
    .propgal__link:hover :global(img) {
      transform: none;
    }
  }

  /* ─── Lightbox modal (mirrors the home gallery) ─── */
  .propgal-lb {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .propgal-lb[hidden] {
    display: none;
  }
  .propgal-lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(24, 26, 22, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: propgal-lb-fade var(--dur-fast) var(--ease-out) both;
  }
  .propgal-lb__figure {
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: 100%;
    max-height: 100%;
    animation: propgal-lb-pop var(--dur-fast) var(--ease-out) both;
  }
  .propgal-lb__img {
    display: block;
    max-width: min(90vw, 1400px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
    background: var(--surface);
  }
  .propgal-lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(90vw, 1400px);
    max-width: 100%;
    flex-wrap: wrap;
  }
  .propgal-lb__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--c-ivory);
    min-width: 0;
  }
  .propgal-lb__count {
    font-size: 0.72rem;
    color: rgba(243, 238, 230, 0.7);
    letter-spacing: 0.08em;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .propgal-lb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 238, 230, 0.2);
    background: rgba(38, 36, 31, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--c-ivory);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .propgal-lb__btn:hover {
    background: rgba(201, 151, 77, 0.5);
    border-color: var(--accent);
  }
  .propgal-lb__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .propgal-lb__close {
    position: absolute;
    z-index: 2;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .propgal-lb__nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
  }
  .propgal-lb__nav:hover {
    transform: translateY(-50%) scale(1.06);
  }
  .propgal-lb__prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .propgal-lb__next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
  @keyframes propgal-lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes propgal-lb-pop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  :global(body.propgal-lb-open) {
    overflow: hidden;
  }
  @media (max-width: 760px) {
    .propgal-lb__img {
      max-height: 70vh;
    }
    .propgal-lb__nav {
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .propgal-lb__backdrop,
    .propgal-lb__figure {
      animation: none;
    }
    .propgal-lb__nav:hover {
      transform: translateY(-50%);
    }
  }

  /* Values — index list drawn with 1px hairlines: number / title / body. */
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  /* NOTE: .values__item is rendered by <Reveal as="li">, so it does NOT carry
     this page's scope hash — target it (and its children) with :global(). */
  .values :global(.values__item) {
    display: grid;
    grid-template-columns: minmax(3rem, 0.2fr) minmax(11rem, 0.8fr) 1.6fr;
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: baseline;
    padding-block: clamp(1.4rem, 2.8vw, 2.2rem);
    border-bottom: 1px solid var(--line);
  }
  .values :global(.values__num) {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
  }
  .values :global(.values__title) {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.8rem);
    line-height: 1.15;
    color: var(--text);
  }
  .values :global(.values__body) {
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.95rem;
    max-width: 52ch;
  }

  @media (max-width: 720px) {
    .values :global(.values__item) {
      grid-template-columns: minmax(2.5rem, auto) 1fr;
      row-gap: 0.4rem;
    }
    .values :global(.values__body) {
      grid-column: 2;
    }
  }
</style>

<script>
  function initPropertyGallery() {
    const section = document.querySelector<HTMLElement>(".propgal");
    if (!section || section.dataset.propgalReady === "1") return;
    section.dataset.propgalReady = "1";

    const tiles = Array.from(
      section.querySelectorAll<HTMLElement>(".propgal__tile"),
    );
    const lb = document.getElementById("property-gallery-lightbox");
    if (!lb || tiles.length === 0) return;

    // Portal the modal to <body> so no transformed / `will-change` ancestor
    // (e.g. reveal wrappers) traps its `position: fixed`.
    if (lb.parentElement !== document.body) document.body.appendChild(lb);

    const lbImg = lb.querySelector<HTMLImageElement>(".propgal-lb__img");
    const lbTitle = lb.querySelector<HTMLElement>("[data-lb-title]");
    const lbCount = lb.querySelector<HTMLElement>("[data-lb-count]");
    const closeEls = Array.from(
      lb.querySelectorAll<HTMLElement>("[data-lb-close]"),
    );
    const prevBtn = lb.querySelector<HTMLButtonElement>("[data-lb-prev]");
    const nextBtn = lb.querySelector<HTMLButtonElement>("[data-lb-next]");

    let idx = -1;
    let lastFocus: HTMLElement | null = null;

    /** Largest candidate from the tile's srcset (full-res image). */
    function largestSrc(img: HTMLImageElement): string {
      const candidates = (img.srcset || "")
        .split(",")
        .map((s) => s.trim().split(/\s+/))
        .filter((p) => p[0]);
      if (!candidates.length) return img.currentSrc || img.src;
      candidates.sort((a, b) => parseInt(b[1] || "0") - parseInt(a[1] || "0"));
      return candidates[0][0];
    }

    function render() {
      const el = tiles[idx];
      if (!el || !lbImg) return;
      const img = el.querySelector<HTMLImageElement>("img");
      const title = el.dataset.cap ?? img?.alt ?? "";
      lbImg.src = img ? largestSrc(img) : "";
      lbImg.alt = title;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCount) lbCount.textContent = `${idx + 1} / ${tiles.length}`;
    }

    function open(i: number) {
      idx = i;
      if (idx < 0) return;
      lastFocus = tiles[idx].querySelector<HTMLElement>("[data-lb-open]");
      render();
      lb!.hidden = false;
      document.body.classList.add("propgal-lb-open");
      (closeEls[0] as HTMLButtonElement | undefined)?.focus();
    }

    function close() {
      lb!.hidden = true;
      document.body.classList.remove("propgal-lb-open");
      if (lbImg) lbImg.src = "";
      lastFocus?.focus();
    }

    function step(delta: number) {
      idx = (idx + delta + tiles.length) % tiles.length;
      render();
    }

    tiles.forEach((el, i) => {
      el.querySelector<HTMLElement>("[data-lb-open]")?.addEventListener(
        "click",
        () => open(i),
      );
    });
    closeEls.forEach((c) => c.addEventListener("click", close));
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  }

  document.addEventListener("astro:page-load", initPropertyGallery);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPropertyGallery);
  } else {
    initPropertyGallery();
  }
</script>
