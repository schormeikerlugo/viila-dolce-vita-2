---
/**
 * BaseLayout — wraps every page.
 * - Loads global styles + fonts.
 * - Renders Nav + Footer.
 * - Boots the shared scroll experience (Lenis + GSAP) once per page.
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import StickyCta from "../components/StickyCta.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Analytics from "@vercel/analytics/astro";
import { site } from "../data/site";
import { ClientRouter, fade } from "astro:transitions";
import { getImage } from "astro:assets";
import { lodgingBusinessSchema } from "../lib/schema";
import { photos } from "../data/media";

// Preload the two variable font files (latin subsets) so the display type
// paints without a fallback flash. `?url` resolves to the same hashed asset
// the @fontsource CSS references.
import bodoniWoff2 from "@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url";
import bodoniItalicWoff2 from "@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-italic.woff2?url";
import archivoWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";

import type { ImageMetadata } from "astro";

interface Props {
  title?: string;
  description?: string;
  /** Dark nav (default) sits over hero media; light nav for inner pages w/o hero. */
  navTheme?: "dark" | "light";
  /** Social share image — defaults to the villa terrace + valley view. */
  ogImage?: ImageMetadata;
  /** Extra JSON-LD blocks (FAQPage, Article, …). */
  schemas?: object[];
  /** Keep the page out of search engines (unlinked/in-progress pages). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  navTheme = "light",
  ogImage = photos.houseTerraceView,
  schemas = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;

// 1200×630 social card, absolute URL (WhatsApp/IG previews need it).
const ogProcessed = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  format: "jpeg",
  quality: 80,
  fit: "cover",
});
const ogUrl = new URL(ogProcessed.src, Astro.site ?? site.url).href;

// Canonical URL for this page — strip query/hash, drop trailing slash.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, Astro.site ?? site.url).href;

// Structured data: the estate card everywhere + page-level extras.
const jsonLd = [lodgingBusinessSchema(), ...schemas];

// Google tags — GA4 + Google Ads. Only injected in production builds; both
// share a single gtag.js loader (Google: "don't add more than one tag").
const GA_ID = "G-5E5D8Y7PS5";
const ADS_ID = "AW-18378644975";
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    {/* Google tag (gtag.js) — GA4 + Google Ads, one loader, production only.
        Consent Mode v2 defaults to denied until the visitor chooses. */}
    {
      analyticsEnabled && (
        <>
          <script is:inline>
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              // Consent Mode v2 — granted by default so analytics + ads
              // measure from the first visit. A saved 'denied' choice from the
              // cookie banner opts the visitor back out.
              try {
                var vdvConsent = localStorage.getItem('vdv-consent');
              } catch (e) { var vdvConsent = null; }
              var denied = vdvConsent === 'denied';
              var state = denied ? 'denied' : 'granted';
              gtag('consent', 'default', {
                ad_storage: state,
                ad_user_data: state,
                ad_personalization: state,
                analytics_storage: state,
              });
              gtag('js', new Date());
            `}
          </script>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script is:inline define:vars={{ GA_ID, ADS_ID }}>
            {`
              gtag('config', GA_ID);
              gtag('config', ADS_ID);
            `}
          </script>
        </>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="KK2lJgdR2GNtHhWvLGFc_I4uG9F4jqpxG3il0tKffsg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Font preloads — kill the display-type flash on first paint. -->
    <link rel="preload" href={bodoniWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodoniItalicWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <!-- Structured data -->
    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {/* GA4 page_view on every View-Transition navigation (gtag doesn't
        re-run on soft nav). Production only. */}
    {
      analyticsEnabled && (
        <script is:inline define:vars={{ GA_ID }}>
          {`
            document.addEventListener("astro:page-load", () => {
              if (typeof window.gtag !== "function") return;
              window.gtag("event", "page_view", {
                page_title: document.title,
                page_location: window.location.href,
                page_path: window.location.pathname,
                send_to: GA_ID,
              });
            });
          `}
        </script>
      )
    }

    <!-- Smooth cross-page fade (no flash between nav sections). -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav theme={navTheme} transition:persist="site-nav" />
    <main id="main" transition:animate={fade({ duration: "0.3s" })}>
      <slot />
    </main>
    <Footer />

    {/* Ink curtain — sweeps over the page between navigations. Persisted so
        it can cover the swap itself; purely decorative. */}
    <div class="curtain" id="page-curtain" transition:persist="page-curtain" aria-hidden="true">
      <span class="curtain__mark">Villa <em>Dolce Vita</em></span>
    </div>

    <Cursor />
    <StickyCta />
    {analyticsEnabled && <CookieConsent />}

    {/* Vercel Web Analytics — cookieless, production only. */}
    {analyticsEnabled && <Analytics />}

    {/* Tell the persistent nav what theme each page needs. */}
    <meta name="nav-theme" content={navTheme} data-nav-theme />


    <script>
      import { initScroll } from "../lib/scroll";
      // Own the scroll position across navigations (Lenis is reset in initScroll).
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      // Run on first load AND after every View Transition navigation.
      document.addEventListener("astro:page-load", () => initScroll());
      // Start each new page at the top (Lenis shouldn't inherit scroll).
      document.addEventListener("astro:after-swap", () => window.scrollTo(0, 0));

      // ── Ink curtain page transition ─────────────────────────────────────
      // Covers on navigation intent, retracts once the new page has loaded.
      const curtain = () => document.getElementById("page-curtain");
      const reduce = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      document.addEventListener("astro:before-preparation", () => {
        const el = curtain();
        if (!el || reduce()) return;
        el.classList.remove("is-leaving");
        el.classList.add("is-covering");
      });
      document.addEventListener("astro:page-load", () => {
        const el = curtain();
        if (!el) return;
        if (!el.classList.contains("is-covering")) return;
        // Let the cover settle one frame, then sweep it away upward.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            el.classList.add("is-leaving");
            el.classList.remove("is-covering");
            window.setTimeout(() => el.classList.remove("is-leaving"), 700);
          }),
        );
      });
    </script>
  </body>
</html>
